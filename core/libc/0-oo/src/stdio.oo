; ==========================================================
; FILE* __file_new(void);
; ==========================================================
; Allocates a new file and a buffer for it.
; ==========================================================

=__file_new

    ; call malloc(4096)
    76 80 01 0C     ; shl r0 1 12       ; 4096
    7C 8A <malloc   ; ims ra <malloc
    7C 8A >malloc   ; ims ra >malloc
    71 8C 8C 04     ; sub rsp rsp 4     ; push return address
    70 8B 8F 08     ; add rb rip 8
    79 8B 00 8C     ; stw rb 0 rsp
    70 8F 8E 8A     ; add rip rpp ra    ; jump
    70 8C 8C 04     ; add rsp rsp 4     ; pop return address

    ; preserve the buffer
    71 8C 8C 04     ; sub rsp rsp 4     ; push r0
    79 80 00 8C     ; stw r0 0 rsp      ; ...

    ; call malloc(20)
    70 80 00 14     ; add r0 0 20
    7C 8A <malloc   ; ims ra <malloc
    7C 8A >malloc   ; ims ra >malloc
    71 8C 8C 04     ; sub rsp rsp 4     ; push return address
    70 8B 8F 08     ; add rb rip 8
    79 8B 00 8C     ; stw rb 0 rsp
    70 8F 8E 8A     ; add rip rpp ra    ; jump
    70 8C 8C 04     ; add rsp rsp 4     ; pop return address

    ; assign the buffer
    78 81 00 8C     ; ldw r1 0 rsp     ; pop r1
    70 8C 8C 04     ; add rsp rsp 4    ; ^^^
    79 81 80 08     ; stw r1 r0 8      ; file->buffer = buffer
    79 81 80 0C     ; stw r1 r0 12     ; file->start = buffer
    79 81 80 10     ; stw r1 r0 16     ; file->end = buffer

    ; done
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



; ==========================================================
; void __file_delete(FILE* file);
; ==========================================================
; Frees a file and its buffer.
;
; To match the behaviour of __file_new(), this does not close the i/o handle.
; ==========================================================

=__file_delete

    ; push the file
    71 8C 8C 04     ; sub rsp rsp 4     ; push r0
    79 80 00 8C     ; stw r0 0 rsp      ; ...

    ; call free(file->buffer)
    78 80 80 08     ; ldw r0 r0 8
    7C 8A <free     ; ims ra <free
    7C 8A >free     ; ims ra >free
    71 8C 8C 04     ; sub rsp rsp 4     ; push return address
    70 8B 8F 08     ; add rb rip 8
    79 8B 00 8C     ; stw rb 0 rsp
    70 8F 8E 8A     ; add rip rpp ra    ; jump
    70 8C 8C 04     ; add rsp rsp 4     ; pop return address

    ; pop the file
    78 80 00 8C     ; ldw r0 0 rsp     ; pop r0
    70 8C 8C 04     ; add rsp rsp 4    ; ^^^

    ; call free(file)
    7C 8A <free     ; ims ra <free
    7C 8A >free     ; ims ra >free
    71 8C 8C 04     ; sub rsp rsp 4     ; push return address
    70 8B 8F 08     ; add rb rip 8
    79 8B 00 8C     ; stw rb 0 rsp
    70 8F 8E 8A     ; add rip rpp ra    ; jump
    70 8C 8C 04     ; add rsp rsp 4     ; pop return address

    ; done
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



; ==========================================================
; FILE* fopen(const char* filename, const char* mode);
; ==========================================================
; Opens the file with the given name in the given mode.
;
; The mode must be "r" or "w". No other modes are supported.
;
; vars:
; - filename: r0, rfp-4
; - mode: r1, rfp-8
; - handle: r2, rfp-12
; - FILE*: rfp-16
; ==========================================================

=fopen
    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; make space for locals, save args
    71 8C 8C 10     ; sub rsp rsp 16
    79 80 8D FC     ; stw r0 rfp -4
    79 81 8D F8     ; stw r1 rfp -8

;    ; if the filename doesn't start with '/', it's a relative path.
;    7A 8A 00 80                ; ldb ra 00 r0
;    71 8A 8A 5C                ; sub ra ra "/"
;    7E 8A &__fopen_filename_ok   ; jz ra &__fopen_filename_ok
;
;    ; the VM doesn't support relative paths so we need to prepend the working
;    ; directory. first we preserve our mode
;    71 8C 8C 04              ; sub rsp rsp 4          ; push r1 (preserve mode)
;    79 81 00 8C              ; stw r1 0 rsp           ; ...
;
;    ; call __prepend_wd
;    7C 8A <__prepend_wd      ; ims ra <__prepend_wd
;    7C 8A >__prepend_wd      ; ims ra >__prepend_wd
;    71 8C 8C 04              ; sub rsp rsp 4          ; push return address
;    70 8B 8F 08              ; add rb rip 8
;    79 8B 00 8C              ; stw rb 0 rsp
;    70 8F 8E 8A              ; add rip rpp ra         ; jump
;    70 8C 8C 04              ; add rsp rsp 4          ; pop return address
;
;    ; restore mode
;    78 81 00 8C     ; ldw r1 0 rsp     ; pop r1
;    70 8C 8C 04     ; add rsp rsp 4    ; ...

:__fopen_filename_ok

    ; check the mode to decide whether to open writeable
    7A 8A 00 81            ; ldb ra 0 r1
    71 8B 8A 72            ; sub rb ra "r"
    7E 8B &__fopen_read    ; jz rb &__fopen_read
    71 8B 8A 77            ; sub rb ra "w"
    7E 8B &__fopen_write   ; jz rb &__fopen_write
    7E 00 &__fopen_invalid_mode   ; jz rb &__fopen_invalid_mode

:__fopen_read

    ; open for reading
    70 81 00 00               ; add r1 0 0
    7E 00 &__fopen_done_mode  ; jz 0 &__fopen_done_mode

:__fopen_write

    ; open for writing
    70 81 00 01          ; add r1 0 1

    ; make sure we don't already have an output file
    7C 8A <__output_file      ; ims ra <__output_file
    7C 8A >__output_file      ; ims ra >__output_file
    78 82 8E 8A               ; ldw r2 rpp ra
    7E 82 &__fopen_done_mode  ; jz r2 &__fopen_done_mode
    7E 00 &__fopen_too_many   ; jz 0 &__fopen_too_many

:__fopen_done_mode

    ; TODO should require "rb" or "wb" instead, check that the next characters
    ; are 'b' and '\0'. In particular, ld/1 and ld/2 both open their output in
    ; "w" mode which is incorrect. They should work when compiled natively on
    ; non-POSIX platforms without mangling line endings.

    ; save the mode
    79 81 8D F8     ; stw r1 rfp -8

    ; get syscall fopen into r7
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 03 03   ; shl ra 3 3        ; ra = offset of fopen syscall (3<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fopen syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 8A &__fopen_syscall_ok     ; jz ra &__fopen_syscall_ok
    7E 00 &__fopen_syscall_failed ; jz ra &__fopen_syscall_failed
:__fopen_syscall_ok

    ; success! store the file handle
    79 80 8D F4     ; stw r0 rfp -12

    ; call __file_new
    7C 8A <__file_new  ; ims ra <__file_new
    7C 8A >__file_new  ; ims ra >__file_new
    71 8C 8C 04        ; sub rsp rsp 4     ; push return address
    70 8B 8F 08        ; add rb rip 8
    79 8B 00 8C        ; stw rb 0 rsp
    70 8F 8E 8A        ; add rip rpp ra    ; jump
    70 8C 8C 04        ; add rsp rsp 4     ; pop return address

    ; setup the file
    78 82 8D F4     ; ldw r2 rfp -12
    79 82 80 00     ; stw r2 r0 0      ; file->handle = handle
    78 81 8D F8     ; ldw r1 rfp -8
    79 81 80 04     ; stw r1 r0 4      ; file->mode = mode
    79 80 8D F0     ; stw r0 rfp -16   ; file

    ; check if mode is write
    7E 81 &__fopen_skip_truncate   ; jz r1 &__fopen_skip_truncate

    ; mode is write. we need to truncate.

    ; store the file as our output file
    7C 8A <__output_file      ; ims ra <__output_file
    7C 8A >__output_file      ; ims ra >__output_file
    79 80 8E 8A               ; stw r0 rpp ra

    ; get syscall ftrunc into r7
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 09 03   ; shl ra 9 3        ; ra = offset of ftrunc syscall (9<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of ftrunc syscall

    ; check if the syscall is supported
    ; TODO need some kind of fallback if not supported; see hex/0-onramp for
    ; the same problem
    78 8A 87 00                   ; ldw ra r7 0
    7E 8A &__fopen_skip_truncate  ; jz ra &__fopen_skip_truncate

    ; prepare args for ftrunc syscall
    78 80 8D F4   ; ldw r0 rfp -12   ; handle
    70 81 00 00   ; add r1 0 0       ; 0 (size low)
    70 82 00 00   ; add r2 0 0       ; 0 (size high)

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; TODO check for errors (making sure not to break streams)
:__fopen_skip_truncate

    ; return the FILE*
    78 80 8D F0     ; ldw r0 rfp -16
    7E 00 &__fopen_syscall_return   ; jz 0 &__fopen_syscall_return

:__fopen_syscall_failed
    ; failure. return NULL
    ;TODO set errno
    70 80 00 00     ; add r0 0 0    ; zero r0

:__fopen_syscall_return

    ; return
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp
    70 8C 8C 04     ; add rsp rsp 4     ; ...
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

:__fopen_invalid_mode
    7C 80 <__files_error_invalid_fopen_mode   ; ims r0 <__files_error_invalid_fopen_mode
    7C 80 >__files_error_invalid_fopen_mode   ; ims r0 >__files_error_invalid_fopen_mode
    70 80 8E 80        ; add r0 rpp r0
    7C 8A <__fatal     ; ims ra <__fatal
    7C 8A >__fatal     ; ims ra >__fatal
    70 8F 8E 8A        ; add rip rpp ra

:__fopen_too_many
    ; only one file can be opened for writing.
    7C 80 <__files_error_one_output_file   ; ims r0 <__files_error_one_output_file
    7C 80 >__files_error_one_output_file   ; ims r0 >__files_error_one_output_file
    70 80 8E 80        ; add r0 rpp r0
    7C 8A <__fatal     ; ims ra <__fatal
    7C 8A >__fatal     ; ims ra >__fatal
    70 8F 8E 8A        ; add rip rpp ra



; ==========================================================
; void fclose(FILE* file);
; ==========================================================
; Closes the given file.
;
; args:
; - file: r0
; vars:
; - handle: r1
; ==========================================================

=fclose
    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; preserve the file
    71 8C 8C 04     ; sub rsp rsp 4     ; push r0
    79 80 00 8C     ; stw r0 0 rsp      ; ^^^

    ; check if this is our output file
    7C 8A <__output_file   ; ims ra <__output_file
    7C 8A >__output_file   ; ims ra >__output_file
    78 81 8E 8A            ; ldw r1 rpp ra
    71 81 81 80            ; sub r1 r1 r0
    7E 81 &__fclose_output_file      ; jz r1 &__fclose_output_file
    7E 00 &__fclose_not_output_file  ; jz 0 &__fclose_not_output_file

:__fclose_output_file
    ; clear the output file
    7C 8A <__output_file      ; ims ra <__output_file
    7C 8A >__output_file      ; ims ra >__output_file
    79 00 8E 8A               ; stw 0 rpp ra
:__fclose_not_output_file

    ; call fflush()
    7C 8A <fflush    ; ims ra <fflush
    7C 8A >fflush    ; ims ra >fflush
    71 8C 8C 04      ; sub rsp rsp 4     ; push return address
    70 8B 8F 08      ; add rb rip 8
    79 8B 00 8C      ; stw rb 0 rsp
    70 8F 8E 8A      ; add rip rpp ra    ; jump
    70 8C 8C 04      ; add rsp rsp 4     ; pop return address

    ; prepare args for syscall fclose(handle)
    78 80 00 8C     ; ldw r0 0 rsp   ; file
    78 80 00 80     ; ldw r0 0 r0    ; file->handle

    ; get syscall fclose into r7
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 04 03   ; shl ra 4 3        ; ra = offset of fclose syscall (4<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fclose syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; get the file
    78 80 00 8C     ; ldw r0 0 rsp

    ; call __file_delete(file)
    7C 8A <__file_delete   ; ims ra <__file_delete
    7C 8A >__file_delete   ; ims ra >__file_delete
    71 8C 8C 04            ; sub rsp rsp 4     ; push return address
    70 8B 8F 08            ; add rb rip 8
    79 8B 00 8C            ; stw rb 0 rsp
    70 8F 8E 8A            ; add rip rpp ra    ; jump
    70 8C 8C 04            ; add rsp rsp 4     ; pop return address

:__fclose_done

    ; return
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp
    70 8C 8C 04     ; add rsp rsp 4     ; ...
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



; ==========================================================
; static size_t __file_fill(FILE* file);
; ==========================================================
; Fills the buffer of the given file that was opened for reading, returning the
; number of bytes read into the buffer.
;
; This assumes the buffer is currently empty. All data in the buffer must be
; consumed first before filling.
;
; vars:
; - file: rfp-4
; ==========================================================

=__file_fill

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 04     ; sub rsp rsp 4

    ; initialize vars
    79 80 8D FC     ; stw r0 rfp -4    ; file

    ; setup args for syscall fread(file->handle, file->buffer, 4096)
    78 81 80 08   ; ldw r1 r0 8   ; r1 = file->buffer
    78 80 80 00   ; ldw r0 r0 0   ; r0 = file->handle
    76 82 01 0C   ; shl r2 1 12   ; r2 = 4096

    ; get syscall fread into r7
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 05 03   ; shl ra 5 3        ; ra = offset of fread syscall (5<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of fread syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 8A &__file_fill_syscall_ok     ; jz ra &__file_fill_syscall_ok
    7E 00 &__file_fill_syscall_fail   ; jz ra &__file_fill_syscall_fail
:__file_fill_syscall_ok

    ; configure buffer
    78 81 8D FC     ; ldw r1 rfp -4    ; r1 = file
    78 82 81 08     ; ldw r2 r1 8      ; r2 = file->buffer
    79 82 81 0C     ; stw r2 r1 12     ; file->start = r2
    70 82 82 80     ; add r2 r2 r0     ; r2 += r0
    79 82 81 10     ; stw r2 r1 16     ; file->end = r2

    ; done
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp
    70 8C 8C 04     ; add rsp rsp 4     ; ...
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

:__file_fill_syscall_fail
    ; fread syscall failed
    7C 80 <__files_error_fread_failed   ; ims r0 <__files_error_fread_failed
    7C 80 >__files_error_fread_failed   ; ims r0 >__files_error_fread_failed
    70 80 8E 80        ; add r0 rpp r0
    7C 8A <__fatal     ; ims ra <__fatal
    7C 8A >__fatal     ; ims ra >__fatal
    70 8F 8E 8A        ; add rip rpp ra



; ==========================================================
; size_t fread(void* output, size_t element_size, size_t element_count, FILE* file);
; ==========================================================
; Reads bytes.
;
; We match the C prototype but the element size must be 1. (This restriction is
; lifted in a later libc stage.)
;
; vars:
; - file: rfp-4
; - output: rfp-8
; - count: rfp-12
; - step: rfp-16
; - total: rfp-20
; ==========================================================

=fread

    ; make sure mode is 0
    78 8A 83 04   ; ldw ra r3 4   ; mode
    7E 8A &__fread_mode_ok
    7E 00 &__fread_mode_fail
:__fread_mode_ok

    ; if the element count is zero, just return zero
    7E 82 &__fread_count_zero      ; jz r2 &__fread_count_zero
    7E 00 &__fread_count_not_zero  ; jz 0 &__fread_count_not_zero
:__fread_count_zero
    70 80 00 00                     ; add r0 0 0        ; mov r0 0
    78 8F 00 8C                     ; ldw rip 0 rsp     ; ret
:__fread_count_not_zero

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 14     ; sub rsp rsp 20

    ; initialize vars
    79 83 8D FC     ; stw r3 rfp -4    ; file
    79 80 8D F8     ; stw r0 rfp -8    ; output
    79 82 8D F4     ; stw r2 rfp -12   ; count
    79 00 8D EC     ; stw 0 rfp -20    ; total = 0

    ; make sure the element size is 1
    71 81 81 01     ; sub r1 r1 1
    7E 81 &__fread_size_ok

    ; element size is not 1, fatal error
    7C 80 <__files_error_bad_element_size   ; ims r0 <__files_error_bad_element_size
    7C 80 >__files_error_bad_element_size   ; ims r0 >__files_error_bad_element_size
    70 80 8E 80        ; add r0 rpp r0
    7C 8A <__fatal     ; ims ra <__fatal
    7C 8A >__fatal     ; ims ra >__fatal
    70 8F 8E 8A        ; add rip rpp ra
:__fread_size_ok

    ; get the number of bytes in the buffer into r0
    78 81 83 0C     ; ldw r1 r3 12     ; file->start
    78 82 83 10     ; ldw r2 r3 16     ; file->end
    71 80 82 81     ; sub r0 r2 r1

:__fread_loop  ; buffer count is in r0

    ; if the buffer is empty, skip memcpy()
    7E 80 &__fread_fill

    ; calculate how much we can take from the buffer (the step size)
    78 82 8D F4     ; ldw r2 rfp -12    ; element count
    7D 8A 80 82     ; ltu ra r0 r2
    7E 8A &__fread_buffer_plenty
    70 82 80 00     ; add r2 r0 0   ; not enough in buffer; take whole buffer
:__fread_buffer_plenty
    79 82 8D F0     ; stw r2 rfp -16    ; step

    ; prepare args for memcpy(output, file->start, count)
    78 80 8D F8     ; ldw r0 rfp -8     ; output
    78 81 8D FC     ; ldw r1 rfp -4     ; file
    78 81 81 0C     ; ldw r1 r1 12      ; file->start

    ; call memcpy
    7C 8A <memcpy    ; ims ra <memcpy
    7C 8A >memcpy    ; ims ra >memcpy
    71 8C 8C 04      ; sub rsp rsp 4    ; push return address
    70 8B 8F 08      ; add rb rip 8
    79 8B 00 8C      ; stw rb 0 rsp
    70 8F 8E 8A      ; add rip rpp ra   ; jump
    70 8C 8C 04      ; add rsp rsp 4    ; pop return address

    ; adjust buffer
    78 82 8D F0     ; ldw r2 rfp -16    ; step
    78 83 8D FC     ; ldw r3 rfp -4     ; file
    78 81 83 0C     ; ldw r1 r3 12      ; file->start
    70 81 81 82     ; add r1 r1 r2      ; file->start += step
    79 81 83 0C     ; stw r1 r3 12

    ; adjust count
    78 81 8D F4     ; ldw r1 rfp -12    ; element count
    71 81 81 82     ; sub r1 r1 r2      ; count -= step
    79 81 8D F4     ; stw r1 rfp -12

    ; adjust total
    78 80 8D EC     ; ldw 0 rfp -20     ; total
    70 80 80 82     ; add r0 r0 r2      ; total += step
    79 80 8D EC     ; stw 0 rfp -20

    ; if count is zero, we're done
    7E 81 &__fread_done

    ; adjust output
    78 80 8D F8     ; ldw r0 rfp -8     ; output
    70 80 80 82     ; add r0 r0 r2      ; output += step
    79 80 8D F8     ; stw r0 rfp -8

:__fread_fill
    ; we need more data. call __file_fill(file)
    78 80 8D FC          ; ldw r0 rfp -4     ; file
    7C 8A <__file_fill   ; ims ra <__file_fill
    7C 8A >__file_fill   ; ims ra >__file_fill
    71 8C 8C 04          ; sub rsp rsp 4    ; push return address
    70 8B 8F 08          ; add rb rip 8
    79 8B 00 8C          ; stw rb 0 rsp
    70 8F 8E 8A          ; add rip rpp ra   ; jump
    70 8C 8C 04          ; add rsp rsp 4    ; pop return address

    ; __file_fill() returned the number of bytes it read. if it read bytes,
    ; loop.
    7E 80 &__fread_no_fill     ; jz r0 &__fread_no_fill
    7E 00 &__fread_loop        ; jz 0 &__fread_loop

:__fread_no_fill
    ; fill didn't read any more data. just return what we've managed to read.
    78 80 8D EC     ; ldw 0 rfp -20     ; total

:__fread_done
    ; total is in r0. return it
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp
    70 8C 8C 04     ; add rsp rsp 4     ; ...
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

:__fread_mode_fail
    ; wrong mode, fatal error
    7C 80 <__files_error_invalid_read   ; ims r0 <__files_error_invalid_read
    7C 80 >__files_error_invalid_read   ; ims r0 >__files_error_invalid_read
    70 80 8E 80        ; add r0 rpp r0
    7C 8A <__fatal     ; ims ra <__fatal
    7C 8A >__fatal     ; ims ra >__fatal
    70 8F 8E 8A        ; add rip rpp ra



;==========================================
; void __write_all(int handle, const char* data, size_t count);
;==========================================
; Writes all of the given data to the given I/O handle.
;
; Calls __fatal() on failure. We don't attempt to recover from write failures
; during bootstrapping.
;
; vars
; - io_handle: rfp-4
; - data: rfp-8
; - remaining: rfp-12
;==========================================

=__write_all

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; store args
    71 8C 8C 10     ; sub rsp rsp 12
    79 80 8D FC     ; stw r0 rfp -4
    79 81 8D F8     ; stw r1 rfp -8
    79 82 8D F4     ; stw r2 rfp -12

:__write_all_loop

    ; get syscall fwrite into r7
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 06 03   ; shl ra 6 3        ; ra = offset of fwrite syscall (6<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of fwrite syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; check the high bit for error
    77 8A 80 1F                   ; shru ra r0 31
    7E 8A &__write_all_no_error   ; jz ra &__write_all_no_error
    7E 00 &__write_all_fail       ; jz 0 &__write_all_fail
:__write_all_no_error

    ; check if we got zero
    7E 80 &__write_all_zero       ; jz r0 &__write_all_zero
    7E 00 &__write_all_not_zero   ; jz 0 &__write_all_not_zero

:__write_all_zero
    ; zero bytes written. this should not be possible; the vm is
    ; malfunctioning. fail, return generic error -1
    70 80 00 FF     ; add r0 0 -1
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
:__write_all_not_zero

    ; adjust pointer and bytes remaining
    78 81 8D F8   ; ldw r1 rfp -8
    78 82 8D F4   ; ldw r2 rfp -12
    70 81 81 80   ; add r1 r1 r0
    71 82 82 80   ; sub r2 r2 r0
    79 81 8D F8   ; stw r1 rfp -8
    79 82 8D F4   ; stw r2 rfp -12

    ; if bytes remaining is zero, we're done
    7E 82 &__write_all_loop_exit   ; jz r2 &__write_all_loop_exit (+2)

    ; otherwise loop.
    78 80 8D FC               ; ldw r0 rfp -4            ; io_handle
    7E 00 &__write_all_loop   ; jz r0 &__write_all_loop

:__write_all_loop_exit

    ; done, return zero
    70 80 00 00     ; add r0 0 0        ; zero r0
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

:__write_all_fail
    ; fwrite syscall failed
    7C 80 <__files_error_fwrite_failed   ; ims r0 <__files_error_fwrite_failed
    7C 80 >__files_error_fwrite_failed   ; ims r0 >__files_error_fwrite_failed
    70 80 8E 80        ; add r0 rpp r0
    7C 8A <__fatal     ; ims ra <__fatal
    7C 8A >__fatal     ; ims ra >__fatal
    70 8F 8E 8A        ; add rip rpp ra



; ==========================================================
; size_t fwrite(const void* data, size_t element_size, size_t element_count, FILE* file);
; ==========================================================
; Writes bytes.
;
; We match the C prototype but the element size must be 1. (This restriction is
; lifted in a later libc stage.)
;
; vars:
; - file: rfp-4
; - data: rfp-8
; - count: rfp-12
; ==========================================================

=fwrite

    ; make sure mode is 1
    78 8A 83 04   ; ldw ra r3 4   ; mode
    71 8A 8A 01   ; sub ra ra 1
    7E 8A &__fwrite_mode_ok
    7E 00 &__fwrite_mode_fail
:__fwrite_mode_ok

    ; if the element count is zero, just return zero
    7E 82 &__fwrite_count_zero      ; jz r2 &__fwrite_count_zero
    7E 00 &__fwrite_count_not_zero  ; jz 0 &__fwrite_count_not_zero
:__fwrite_count_zero
    70 80 00 00                     ; add r0 0 0        ; mov r0 0
    78 8F 00 8C                     ; ldw rip 0 rsp     ; ret
:__fwrite_count_not_zero

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 0C     ; sub rsp rsp 12

    ; preserve args
    79 83 8D FC     ; stw r3 rfp -4    ; file
    79 80 8D F8     ; stw r0 rfp -8    ; data
    79 82 8D F4     ; stw r2 rfp -12   ; count

    ; make sure the element size is 1
    71 81 81 01                 ; sub r1 r1 1
    7E 81 &__fwrite_size_ok      ; jz r1 &__fwrite_size_ok
    7E 00 &__fwrite_size_error   ; jz r1 &__fwrite_size_error
:__fwrite_size_ok

    ; get the free space in the buffer
    78 80 8D FC     ; ldw r0 rfp -4    ; file
    78 81 80 08     ; ldw r1 r0 8      ; file->buffer
    78 82 80 10     ; ldw r2 r0 16     ; file->end
    71 82 82 81     ; sub r2 r2 r1     ; buffer_count
    76 83 01 0C     ; shl r3 1 12      ; 4096
    71 84 83 82     ; sub r4 r3 r2     ; remaining

    ; check if we have enough room in the buffer
    78 82 8D F4             ; ldw r2 rfp -12   ; count
    7D 8A 84 82             ; ltu ra r4 r2     ; ra = (remaining < buffer_count)
    7E 8A &__fwrite_memcpy  ; jz ra &__fwrite_memcpy
    7E 00 &__fwrite_flush   ; jz 0 &__fwrite_flush

:__fwrite_flush
    ; no room in buffer. call fflush(file)
    78 80 8D FC     ; ldw r0 rfp -4    ; file
    7C 8A <fflush    ; ims ra <fflush
    7C 8A >fflush    ; ims ra >fflush
    71 8C 8C 04      ; sub rsp rsp 4     ; push return address
    70 8B 8F 08      ; add rb rip 8
    79 8B 00 8C      ; stw rb 0 rsp
    70 8F 8E 8A      ; add rip rpp ra    ; jump
    70 8C 8C 04      ; add rsp rsp 4     ; pop return address

    ; get the free space in the buffer again
    78 80 8D FC     ; ldw r0 rfp -4    ; file
    78 81 80 08     ; ldw r1 r0 8      ; file->buffer
    78 82 80 10     ; ldw r2 r0 16     ; file->end
    71 82 82 81     ; sub r2 r2 r1     ; buffer_count
    76 83 01 0C     ; shl r3 1 12      ; 4096
    71 84 83 82     ; sub r4 r3 r2     ; remaining

    ; check again if we have enough room in the buffer
    78 82 8D F4             ; ldw r2 rfp -12   ; count
    7D 8A 84 82             ; ltu ra r4 r2     ; ra = (remaining < buffer_count)
    ;7E 8A &__fwrite_memcpy  ; jz ra &__fwrite_memcpy
    7E 00 &__fwrite_all     ; jz 0 &__fwrite_all

:__fwrite_all
    ; the amount requested to write is larger than our empty buffer. send it
    ; directly to the output file.

    ; prepare args for write_all(handle, data, count)
    78 83 8D FC     ; ldw r3 rfp -4    ; file
    78 80 83 00     ; ldw r0 r3 0      ; file->handle
    78 81 8D F8     ; ldw r1 rfp -8    ; data
    78 82 8D F4     ; ldw r2 rfp -12   ; count

    ; call __write_all()
    7C 8A <__write_all  ; ims ra <__write_all
    7C 8A >__write_all  ; ims ra >__write_all
    71 8C 8C 04         ; sub rsp rsp 4     ; push return address
    70 8B 8F 08         ; add rb rip 8
    79 8B 00 8C         ; stw rb 0 rsp
    70 8F 8E 8A         ; add rip rpp ra    ; jump
    70 8C 8C 04         ; add rsp rsp 4     ; pop return address

    ; done
    7E 00 &__fwrite_return  ; jz 0 &__fwrite_return

:__fwrite_memcpy
    ; the data fits in the buffer.

    ; get args for memcpy(file->end, data, count)
    78 83 8D FC     ; ldw r3 rfp -4    ; file
    78 80 83 10     ; ldw r0 r3 16     ; file->end
    78 81 8D F8     ; ldw r1 rfp -8    ; data
    78 82 8D F4     ; ldw r2 rfp -12   ; count

    ; increment file->end
    70 84 80 82     ; add r4 r0 r2
    79 84 83 10     ; stw r4 r3 16

    ; call memcpy
    7C 8A <memcpy   ; ims ra <memcpy
    7C 8A >memcpy   ; ims ra >memcpy
    71 8C 8C 04     ; sub rsp rsp 4     ; push return address
    70 8B 8F 08     ; add rb rip 8
    79 8B 00 8C     ; stw rb 0 rsp
    70 8F 8E 8A     ; add rip rpp ra    ; jump
    70 8C 8C 04     ; add rsp rsp 4     ; pop return address

:__fwrite_return
    ; return the given count
    78 80 8D F4     ; ldw r0 rfp -12    ; count
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp
    70 8C 8C 04     ; add rsp rsp 4     ; ...
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

:__fwrite_mode_fail
    ; wrong mode, fatal error
    7C 80 <__files_error_invalid_write   ; ims r0 <__files_error_invalid_write
    7C 80 >__files_error_invalid_write   ; ims r0 >__files_error_invalid_write
    70 80 8E 80        ; add r0 rpp r0
    7C 8A <__fatal     ; ims ra <__fatal
    7C 8A >__fatal     ; ims ra >__fatal
    70 8F 8E 8A        ; add rip rpp ra

:__fwrite_size_error
    ; element size is not 1, fatal error
    7C 80 <__files_error_bad_element_size   ; ims r0 <__files_error_bad_element_size
    7C 80 >__files_error_bad_element_size   ; ims r0 >__files_error_bad_element_size
    70 80 8E 80        ; add r0 rpp r0
    7C 8A <__fatal     ; ims ra <__fatal
    7C 8A >__fatal     ; ims ra >__fatal
    70 8F 8E 8A        ; add rip rpp ra



; ==========================================================
; int fflush(FILE* file);
; ==========================================================
; Flushes the given stream.
;
; This only flushes output. It is ignored on files opened for reading.
; ==========================================================

=fflush

    ; If mode is 0 (read), do nothing.
    78 8A 80 04   ; ldw ra r0 4
    7E 8A &__fflush_return

    ; If the buffer is empty (file->start == file->end), do nothing.
    78 81 80 0C              ; ldw r1 r0 12
    78 82 80 10              ; ldw r2 r0 16
    71 82 81 82              ; sub r2 r1 r2
    7E 82 &__fflush_return   ; jz r2 &__fflush_return

    ; push the file
    71 8C 8C 04     ; sub rsp rsp 4     ; push r0
    79 80 00 8C     ; stw r0 0 rsp      ; ^^^

    ; get arguments for write_all(handle, bytes, count)
    78 81 80 08     ; ldw r1 r0 8      ; file->buffer
    78 82 80 10     ; ldw r2 r0 16     ; file->end
    71 82 82 81     ; sub r2 r2 r1     ; count
    78 80 80 00     ; ldw r0 r0 0      ; handle

    ; call __write_all()
    7C 8A <__write_all  ; ims ra <__write_all
    7C 8A >__write_all  ; ims ra >__write_all
    71 8C 8C 04         ; sub rsp rsp 4     ; push return address
    70 8B 8F 08         ; add rb rip 8
    79 8B 00 8C         ; stw rb 0 rsp
    70 8F 8E 8A         ; add rip rpp ra    ; jump
    70 8C 8C 04         ; add rsp rsp 4     ; pop return address

    ; reset the buffer
    78 80 00 8C     ; stw r0 0 rsp     ; file
    78 81 80 08     ; ldw r1 r0 8      ; file->buffer
    79 81 80 10     ; stw r1 r0 16     ; file->end = file->buffer

    ; pop the file
    78 80 00 8C     ; ldw r0 0 rsp     ; pop r0
    70 8C 8C 04     ; add rsp rsp 4    ; ^^^

:__fflush_return
    70 80 00 00     ; add r0 0 0        ; zero r0
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



; ==========================================================
; long ftell(FILE* file);
; ==========================================================
; Returns the current file position.
;
; vars:
; - file: rfp-4
; - result: rfp-12 (8 bytes)
; ==========================================================

=ftell

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 0C     ; sub rsp rsp 12

    ; store the file
    79 80 8D FC     ; stw r0 rfp -4    ; file

    ; get args for syscall ftell
    78 80 80 00     ; ldw r0 r0 0      ; file handle
    70 81 8D F4     ; add r1 rfp -12   ; &result

    ; get syscall ftell into r7
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 08 03   ; shl ra 8 3        ; ra = offset of ftell syscall (8<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of ftell syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; TODO error checking!
    ; TODO check that the high 32 bits are zero (not that this is really
    ; necessary since this libc is replaced before we get to the possibility of
    ; large files)

    ; calculate the number of bytes in the buffer
    78 83 8D FC     ; ldw r3 rfp -4    ; file
    78 81 83 0C     ; ldw r1 r3 12     ; file->start
    78 82 83 10     ; ldw r2 r3 16     ; file->end
    71 81 82 81     ; sub r1 r2 r1     ; buffer count

    ; get the result
    78 80 8D F4     ; ldw r0 rfp -12   ; result (ignoring high 32 bits)

    ; add or subtract result based on the mode
    78 8A 83 04           ; ldw ra r3 4   ; mode
    7E 8A &__ftell_read   ; jz ra &__ftell_read
    ; write mode: add the buffer count
    70 80 80 81           ; add r0 r0 r1
    7E 00 &__ftell_done   ; jz 0 &__ftell_done
:__ftell_read
    ; read mode: subtract the buffer count
    71 80 80 81           ; sub r0 r0 r1
:__ftell_done

    ; done
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp
    70 8C 8C 04     ; add rsp rsp 4     ; ...
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



; ==========================================================
; int fseek(FILE* stream, int offset, int whence);
; ==========================================================
; This is only supported on files open for reading, not writing. (The first
; stage Onramp OS does not support seeking writable files.)
;
; For simplicity, we just dump the buffer and call the fseek syscall.
; ==========================================================

=fseek

    ; make sure mode is 0
    78 8A 80 04   ; ldw ra r0 4
    7E 8A &__fseek_mode_ok
    7E 00 &__fseek_mode_fail
:__fseek_mode_ok

    ; dump the buffer
    78 83 80 10     ; ldw r3 r0 16     ; file->end
    79 83 80 0C     ; stw r3 r0 12     ; file->start = file->end

    ; in the system call, base comes first and offset is 64 bits. we need to
    ; move the arguments around.
    78 80 80 00     ; ldw r0 r0 0                 ; handle
    70 8A 81 00     ; add ra r1 0   ; mov ra r1
    70 81 82 00     ; add r1 r2 0   ; mov r1 r2   ; base
    70 82 8A 00     ; add r2 ra 0   ; mov r2 ra   ; offset low
    70 83 00 00     ; add r3 0 0    ; mov r3 0    ; offset high (0)

    ; get syscall fseek into r7
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 07 03   ; shl ra 7 3        ; ra = offset of fseek syscall (7<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of fseek syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; TODO error checking!

    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

:__fseek_mode_fail
    ; wrong mode, fatal error
    7C 80 <__files_error_invalid_seek   ; ims r0 <__files_error_invalid_seek
    7C 80 >__files_error_invalid_seek   ; ims r0 >__files_error_invalid_seek
    70 80 8E 80        ; add r0 rpp r0
    7C 8A <__fatal     ; ims ra <__fatal
    7C 8A >__fatal     ; ims ra >__fatal
    70 8F 8E 8A        ; add rip rpp ra



; ==========================================================
; int feof(FILE* file);
; ==========================================================

=feof
    ; TODO
    70 80 00 01     ; add r0 0 1
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



; ==========================================================
; int fgetc(FILE* file);
; ==========================================================

=fgetc
    ; This function is called extremely often so we optimize for the common
    ; case. If there is data in the buffer we can pop a character.

    ; make sure mode is 0
    78 8A 80 04   ; ldw ra r0 4
    7E 8A &__fgetc_mode_ok
    7E 00 &__fgetc_mode_fail
:__fgetc_mode_ok

    ; check if file->start != file->end
    78 81 80 0C             ; ldw r1 r0 12
    78 82 80 10             ; ldw r2 r0 16
    71 82 81 82             ; sub r2 r1 r2
    7E 82 &__fgetc_fread    ; jz r2 &__fgetc_fread

    ; pop a character
    7A 83 81 00    ; ldw r3 r1 0
    70 81 81 01    ; add r1 r1 1
    79 81 80 0C    ; stw r1 r0 12
    70 80 83 00    ; add r0 r3 0
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret

:__fgetc_fread
    ; no data in buffer. fallback to fread

    ; make space on the stack to read a character
    71 8C 8C 04     ; sub rsp rsp 4

    ; setup args to fread
    70 83 00 80     ; add r3 0 r0    ; mov r3 r0
    70 80 00 8C     ; add r0 0 rsp   ; mov r0 rsp
    70 81 00 01     ; add r1 0 1     ; mov r1 1
    70 82 00 01     ; add r2 0 1     ; mov r2 1

    ; call fread
    7C 8A <fread         ; ims ra <fread
    7C 8A >fread         ; ims ra >fread
    71 8C 8C 04          ; sub rsp rsp 4          ; push return address
    70 8B 8F 08          ; add rb rip 8
    79 8B 00 8C          ; stw rb 0 rsp
    70 8F 8E 8A          ; add rip rpp ra         ; jump
    70 8C 8C 04          ; add rsp rsp 4          ; pop return address

    ; check if it failed
    7E 80 &__fgetc_fail

    ; return the byte read
    7A 80 00 8C     ; ldb r0 0 rsp
    70 8C 8C 04     ; add rsp rsp 4
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; on failure, return -1
:__fgetc_fail
    70 8C 8C 04     ; add rsp rsp 4
    70 80 00 FF     ; add r0 0 -1     ; mov r0 -1
    78 8F 00 8C     ; ldw rip 0 rsp   ; ret

:__fgetc_mode_fail
    ; wrong mode, fatal error
    7C 80 <__files_error_invalid_read   ; ims r0 <__files_error_invalid_read
    7C 80 >__files_error_invalid_read   ; ims r0 >__files_error_invalid_read
    70 80 8E 80        ; add r0 rpp r0
    7C 8A <__fatal     ; ims ra <__fatal
    7C 8A >__fatal     ; ims ra >__fatal
    70 8F 8E 8A        ; add rip rpp ra



; ==========================================================
; int fputc(int c, FILE* file);
; ==========================================================

=fputc

    ; make sure mode is 1
    78 8A 81 04   ; ldw ra r1 4   ; mode
    71 8A 8A 01   ; sub ra ra 1
    7E 8A &__fputc_mode_ok
    7E 00 &__fputc_mode_fail
:__fputc_mode_ok

    ; check if file->end matches the end of the buffer
    78 82 81 08     ; ldw r2 r1 8      ; file->buffer
    76 83 01 0C     ; shl r3 1 12      ; 4096
    70 82 82 83     ; add r2 r2 r3
    78 83 81 10     ; ldw r3 r1 16     ; file->end
    71 82 82 83     ; sub r2 r2 r3

    ; if it matches, we have to flush
    7E 82 &__fputc_flush    ; jz r2 &__fputc_flush
    7E 00 &__fputc_insert   ; jz 0 &__fputc_insert

:__fputc_flush

    ; push args
    71 8C 8C 08     ; sub rsp rsp 8
    79 80 8C 00     ; stw r0 rsp 0
    79 81 8C 04     ; stw r1 rsp 4

    ; call fflush(file)
    70 80 81 00      ; add r0 r1 0
    7C 8A <fflush    ; ims ra <fflush
    7C 8A >fflush    ; ims ra >fflush
    71 8C 8C 04      ; sub rsp rsp 4     ; push return address
    70 8B 8F 08      ; add rb rip 8
    79 8B 00 8C      ; stw rb 0 rsp
    70 8F 8E 8A      ; add rip rpp ra    ; jump
    70 8C 8C 04      ; add rsp rsp 4     ; pop return address

    ; restore args
    78 81 8C 04     ; ldw r1 rsp 4
    78 80 8C 00     ; ldw r0 rsp 0
    70 8C 8C 08     ; add rsp rsp 8

    ; get file->end back into r3
    78 83 81 10     ; ldw r3 r1 16     ; file->end

:__fputc_insert

    ; insert the character at file->end (r3) and bump it
    7B 80 83 00    ; stb r0 r3 0
    70 83 83 01    ; add r3 r3 1
    79 83 81 10    ; stw r3 r1 16     ; file->end

    ; return the character cast to unsigned
    77 81 FF 18    ; shru r1 -1 24     ; r1 = (0xFFFFFFFFu >> 24)
    74 80 80 81    ; and r0 r0 r1
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret

:__fputc_mode_fail
    ; wrong mode, fatal error
    7C 80 <__files_error_invalid_write   ; ims r0 <__files_error_invalid_write
    7C 80 >__files_error_invalid_write   ; ims r0 >__files_error_invalid_write
    70 80 8E 80        ; add r0 rpp r0
    7C 8A <__fatal     ; ims ra <__fatal
    7C 8A >__fatal     ; ims ra >__fatal
    70 8F 8E 8A        ; add rip rpp ra



; ==========================================================
; int fputs(const char* s, FILE* file);
; ==========================================================

=fputs
    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; store string and file on the stack
    71 8C 8C 08     ; sub rsp rsp 8
    79 80 8C 00     ; stw r0 rsp 0
    79 81 8C 04     ; stw r1 rsp 4

    ; call strlen()
    7C 8A <strlen        ; ims ra <strlen
    7C 8A >strlen        ; ims ra >strlen
    71 8C 8C 04          ; sub rsp rsp 4          ; push return address
    70 8B 8F 08          ; add rb rip 8
    79 8B 00 8C          ; stw rb 0 rsp
    70 8F 8E 8A          ; add rip rpp ra         ; jump
    70 8C 8C 04          ; add rsp rsp 4          ; pop return address

    ; set up our args to fwrite
    70 82 00 80      ; add r2 0 r0     ; mov r2 r0
    78 80 8C 00      ; ldw r0 rsp 0
    70 81 00 01      ; add r1 0 1      ; mov r1 1
    78 83 8C 04      ; ldw r3 rsp 4

    ; call fwrite()
    7C 8A <fwrite        ; ims ra <fwrite
    7C 8A >fwrite        ; ims ra >fwrite
    71 8C 8C 04          ; sub rsp rsp 4          ; push return address
    70 8B 8F 08          ; add rb rip 8
    79 8B 00 8C          ; stw rb 0 rsp
    70 8F 8E 8A          ; add rip rpp ra         ; jump
    70 8C 8C 04          ; add rsp rsp 4          ; pop return address

    ; TODO check the return value of fwrite. for now we don't bother since this
    ; is always used either to write to stdout/stderr or to write output file
    ; comments.

    ; fputs must return a non-negative value on success. we always return 0.
    70 80 00 00     ; add r0 0 0        ; zero r0

    ; return
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



; ==========================================================
; int puts(const char* s);
; ==========================================================

=puts
    ; no stack frame

    ; load stdout into r1
    7C 8A <stdout    ; ims ra <stdout
    7C 8A >stdout    ; ims ra >stdout
    78 81 8E 8A      ; ldw r1 rpp ra

    ; call fputs
    ; TODO for now we ignore the return value
    7C 8A <fputs        ; ims ra <fputs
    7C 8A >fputs        ; ims ra >fputs
    71 8C 8C 04         ; sub rsp rsp 4          ; push return address
    70 8B 8F 08         ; add rb rip 8
    79 8B 00 8C         ; stw rb 0 rsp
    70 8F 8E 8A         ; add rip rpp ra         ; jump
    70 8C 8C 04         ; add rsp rsp 4          ; pop return address

    ; call putchar('\n')
    ; TODO for now we ignore the return value
    70 80 00 0A         ; add r0 r0 '\n'
    7C 8A <putchar      ; ims ra <putchar
    7C 8A >putchar      ; ims ra >putchar
    71 8C 8C 04         ; sub rsp rsp 4          ; push return address
    70 8B 8F 08         ; add rb rip 8
    79 8B 00 8C         ; stw rb 0 rsp
    70 8F 8E 8A         ; add rip rpp ra         ; jump
    70 8C 8C 04         ; add rsp rsp 4          ; pop return address

    ; puts must return a non-negative value on success. we always return 0.
    70 80 00 00     ; add r0 0 0
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



; ==========================================================
; int putchar(int c);
; ==========================================================

=putchar
    ; no stack frame

    ; load stdout into r1
    7C 8A <stdout    ; ims ra <stdout
    7C 8A >stdout    ; ims ra >stdout
    78 81 8E 8A      ; ldw r1 rpp ra

    ; tail-call fputc
    7C 8A <fputc        ; ims ra <fputc
    7C 8A >fputc        ; ims ra >fputc
    70 8F 8E 8A         ; add rip rpp ra      ; jump



; ==========================================================
; int fileno(FILE* file);
; ==========================================================

=fileno
    78 80 00 80    ; ldw r0 0 r0
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret



; ==========================================================
; int chmod(const char* filename, int mode);
; ==========================================================

=chmod

    ; get syscall chmod (17) into r7
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 11 03   ; shl ra 17 3       ; ra = offset of chmod syscall (17<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of chmod syscall

    ; check if the syscall is supported. if not return ERROR_UNSUPPORTED.
    78 8A 87 00                   ; ldw ra r7 0
    7E 8A &__chmod_not_supported  ; jz ra &__chmod_not_supported

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; done
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret

:__chmod_not_supported
    70 80 FC 00    ; r0 = ERROR_UNSUPPORTED (0xFFFFFFFC)
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret



; ==========================================================
; int unlink(const char* path);
; ==========================================================
; Delete the file with the given name.
; ==========================================================

=unlink

; TODO the code for this is nearly identical to chmod. If there are several
; more like this it might be useful to condense them into a syscall wrapper
; function.

    ; get syscall unlink (16) into r7
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 10 03   ; shl ra 16 3       ; ra = offset of chmod syscall (16<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of chmod syscall

    ; check if the syscall is supported. if not return ERROR_UNSUPPORTED.
    78 8A 87 00                    ; ldw ra r7 0
    7E 8A &__unlink_not_supported  ; jz ra &__unlink_not_supported

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; done
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret

:__unlink_not_supported
    70 80 FC 00    ; r0 = ERROR_UNSUPPORTED (0xFFFFFFFC)
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret
