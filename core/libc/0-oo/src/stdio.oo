; This file implements C-style I/O functions from <stdio.h> for bootstrapping.
;
; A FILE is a struct containing the following fields:
;
; typedef struct {
;     int handle; // underlying I/O handle
;     int mode; // 0 for read, 1 for write
;     char* buffer; // pointer to allocated 4 KB buffer
;     char* start; // position of first valid byte in buffer (only for reading)
;     char* end; // one past last valid byte in buffer
; } FILE;
;
; The struct and its buffer are each allocated with malloc() and freed when the
; file is closed.
;
; The data between start and end is the valid data in the buffer. In this
; stage, files can only be opened for reading or writing, not both.



; ==========================================================
; FILE* stdin;
; ==========================================================

=stdin
    00 00 00 00



; ==========================================================
; FILE* stdout;
; ==========================================================

=stdout
    00 00 00 00



; ==========================================================
; FILE* stderr;
; ==========================================================

=stderr
    00 00 00 00






; ==========================================================
; void __stdio_init(void);
; ==========================================================
; Initializes the standard IO functionality.
;
; vars:
;    - stdin_handle: rfp-4
;    - stdout_handle: rfp-8
;    - stderr_handle: rfp-12
;    - process_info_table: r9
; ==========================================================

=__stdio_init

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 0C     ; sub rsp rsp 12

    ; load the process info table into r9
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra

    ; save the handles for our standard streams
    78 8A 89 0C   ; ldw ra r9 12     ; stdin
    79 8A 8D FC   ; stw ra rfp -4
    78 8A 89 10   ; ldw ra r9 16     ; stdout
    79 8A 8D F8   ; stw ra rfp -8
    78 8A 89 14   ; ldw ra r9 20     ; stderr
    79 8A 8D F4   ; stw ra rfp -12

    ; call __file_new
    7C 8A <__file_new  ; ims ra <__file_new
    7C 8A >__file_new  ; ims ra >__file_new
    71 8C 8C 04        ; sub rsp rsp 4     ; push return address
    70 8B 8F 08        ; add rb rip 8
    79 8B 00 8C        ; stw rb 0 rsp
    70 8F 8E 8A        ; add rip rpp ra    ; jump
    70 8C 8C 04        ; add rsp rsp 4     ; pop return address

    ; create stdin
    7C 8A <stdin     ; ims ra <stdin
    7C 8A >stdin     ; ims ra >stdin
    79 80 8E 8A      ; stw r0 rpp ra
    78 8A 8D FC      ; ldw ra rfp -4
    79 8A 80 00      ; stw ra r0 0    ; file->handle = stdin_handle
    79 00 80 04      ; stw 0 r0 4     ; file->mode = 0 (read)

    ; call __file_new
    7C 8A <__file_new  ; ims ra <__file_new
    7C 8A >__file_new  ; ims ra >__file_new
    71 8C 8C 04        ; sub rsp rsp 4     ; push return address
    70 8B 8F 08        ; add rb rip 8
    79 8B 00 8C        ; stw rb 0 rsp
    70 8F 8E 8A        ; add rip rpp ra    ; jump
    70 8C 8C 04        ; add rsp rsp 4     ; pop return address

    ; create stdout
    7C 8A <stdout    ; ims ra <stdout
    7C 8A >stdout    ; ims ra >stdout
    79 80 8E 8A      ; stw r0 rpp ra
    78 8A 8D F8      ; ldw ra rfp -8
    79 8A 80 00      ; stw ra r0 0    ; file->handle = stdout_handle
    79 01 80 04      ; stw 1 r0 4     ; file->mode = 1 (write)

    ; call __file_new
    7C 8A <__file_new  ; ims ra <__file_new
    7C 8A >__file_new  ; ims ra >__file_new
    71 8C 8C 04        ; sub rsp rsp 4     ; push return address
    70 8B 8F 08        ; add rb rip 8
    79 8B 00 8C        ; stw rb 0 rsp
    70 8F 8E 8A        ; add rip rpp ra    ; jump
    70 8C 8C 04        ; add rsp rsp 4     ; pop return address

    ; create stderr
    7C 8A <stderr    ; ims ra <stderr
    7C 8A >stderr    ; ims ra >stderr
    79 80 8E 8A      ; stw r0 rpp ra
    78 8A 8D F4      ; ldw ra rfp -12
    79 8A 80 00      ; stw ra r0 0    ; file->handle = stderr_handle
    79 01 80 04      ; stw 1 r0 4     ; file->mode = 1 (write)

    ; return
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp
    70 8C 8C 04     ; add rsp rsp 4     ; ...
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



; ==========================================================
; char* __prepend_wd(const char* filename);
; ==========================================================
; Prepends the working directory to the given path.
; ==========================================================

; TODO decide if we're actually going to do this

;=__prepend_wd
;
;    ; set up a stack frame
;    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
