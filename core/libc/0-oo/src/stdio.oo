=__files_error_fread_failed
    ; "ERROR: fread() failed." '0A '00
    45 52 52 4f 52 3a 20 66  72 65 61 64 28 29 20 66
  ;  E  R  R  O  R  :     f   r  e  a  d  (  )     f
    61 69 6c 65 64 2e 0a 00
  ;  a  i  l  e  d  . \n \0



; ==========================================================
