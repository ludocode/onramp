=__files_error_invalid_fopen_mode
    ; "ERROR: Invalid fopen() mode." '0A '00
    45 52 52 4f 52 3a 20 49  6e 76 61 6c 69 64 20 66
  ;  E  R  R  O  R  :     I   n  v  a  l  i  d     f
    6f 70 65 6e 28 29 20 6d  6f 64 65 2e 0a 00 00 00
  ;  o  p  e  n  (  )     m   o  d  e  . \n \0



; ==========================================================
