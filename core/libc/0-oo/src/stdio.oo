    45 52 52 4f 52 3a 20 43  61 6e 6e 6f 74 20 72 65
  ;  E  R  R  O  R  :     C   a  n  n  o  t     r  e
    61 64 20 66 72 6f 6d 20  61 20 66 69 6c 65 20 69
  ;  a  d     f  r  o  m      a     f  i  l  e     i
    6e 20 77 72 69 74 65 20  6d 6f 64 65 2e 0a 00
