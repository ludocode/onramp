    45 52 52 4f 52 3a 20 66  77 72 69 74 65 28 29 20
  ;  E  R  R  O  R  :     f   w  r  i  t  e  (  )
    66 61 69 6c 65 64 2e 0a  00
  ;  f  a  i  l  e  d  . \n  \0



