; This file contains the implementation of malloc for the first stage Onramp
; libc.
;
; It is a simple-as-possible bump allocator with power-of-two free lists to
; reuse memory.
;
; All allocation sizes are rounded up to powers of two. There is a free list
; for each power of two size. New allocations are created by bump allocation
; from the initial heap. An allocation is freed by adding it to its
; power-of-two free list for later reuse. There is no coalescing of memory.
;
; Most allocations in our compiler stages are either tiny (identifier strings,
; small structs), or they are of a fixed size (e.g. 4096-byte buffers.) This
; reuse strategy therefore works well; it avoids the need for pooling structs
; and allows us to allocate strings at will without worrying about running out
; of memory.



; ==========================================================
; void __malloc_init(void);
; ==========================================================
; Initializes the allocator.
; ==========================================================

=__malloc_init

    ; set up a stack frame
    ;71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    ;79 8D 00 8C     ; stw rfp 0 rsp     ; ^^^
    ;70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; load the process info table into r9
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra

    ; align the break
    78 80 89 04       ; ldw r0 r9 4
    70 80 80 03       ; add r0 r0 3
    74 80 80 FC       ; and r0 r0 -4

    ; store it in __malloc_break
    7C 8B <__malloc_break   ; ims rb <__malloc_break
    7C 8B >__malloc_break   ; ims rb >__malloc_break
    79 80 8E 8B             ; stw r0 rpp rb

    ; subtract 128 kB from the stack pointer to allocate a stack. (This seems
    ; huge for bootstrapping but it's the same amount we use in libc/3 so it's
    ; simpler if we keep it the same.)
    76 82 01 11    ; shl r2 1 17    ; r1 = 131072  (128 KiB)
    71 81 8C 82    ; sub r1 rsp r2

    ; store it in __malloc_end
    7C 8B <__malloc_end     ; ims rb <__malloc_end
    7C 8B >__malloc_end     ; ims rb >__malloc_end
    79 81 8E 8B             ; stw r1 rpp rb

    ; check for overflow. ensure __malloc_break < __malloc_end < rsp
    7D 83 80 81                 ; ltu r3 r0 r1
    7E 83 &__malloc_init_fail   ; jz r3 &__malloc_init_fail
    7D 83 81 8C                 ; ltu r3 r1 rsp
    7E 83 &__malloc_init_fail   ; jz r3 &__malloc_init_fail

    ; return
    ;70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp
    ;78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp
    ;70 8C 8C 04     ; add rsp rsp 4     ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

:__malloc_init_fail
    7C 80 <__malloc_fatal_str   ; ims ra <__malloc_fatal_str
    7C 80 >__malloc_fatal_str   ; ims ra >__malloc_fatal_str
    70 80 8E 80                 ; add r0 rpp r0
    7C 8A <__fatal   ; ims ra <__fatal
    7C 8A >__fatal   ; ims ra >__fatal
    70 8F 8E 8A      ; add rip rpp ra   ; jump



; ==========================================================
; void* __malloc_break;
; ==========================================================
; The current program break.
; ==========================================================

@__malloc_break
    00 00 00 00



; ==========================================================
; void* __malloc_end;
; ==========================================================
; The end of the heap.
; ==========================================================

@__malloc_end
    00 00 00 00



; ==========================================================
; void* __free_lists[29];
; ==========================================================
; The free lists, one for each power-of-two size starting at 4.
;
; Free allocations are stored in intrusively linked lists. The first word of
; each allocation is the pointer to the next one, or NULL for the end of the
; list.
;
; Links point to the allocation (as returned to the program), not the metadata
; that precedes it. We avoid shifting pointers around after the initial
; allocation.
;
; The minimum size is 4, which is size class 0. Size class 1 is 8, size class
; 2 is 16, and so on.
; ==========================================================

@__free_lists
    00 00 00 00  00 00 00 00    00 00 00 00  00 00 00 00
    00 00 00 00  00 00 00 00    00 00 00 00  00 00 00 00
    00 00 00 00  00 00 00 00    00 00 00 00  00 00 00 00
    00 00 00 00  00 00 00 00    00 00 00 00  00 00 00 00
    00 00 00 00  00 00 00 00    00 00 00 00  00 00 00 00
    00 00 00 00  00 00 00 00    00 00 00 00  00 00 00 00
    00 00 00 00  00 00 00 00    00 00 00 00  00 00 00 00
    00 00 00 00



; ==========================================================
; void* malloc(size_t size)
; ==========================================================
; Allocates a chunk of memory of the given size from the heap.
;
; The given size is rounded up to a power of two, with a minimum of 4. The
; power minus 2 is the allocation's size class.
;
; We then check the free list for the given size class. If it has a free
; allocation, we pop it and return it; otherwise, we allocate a new one from
; the empty region of memory.
;
; Each allocation has a single word of metadata before the pointer. The
; metadata contains the allocation's size class.
;
; If allocation fails, the program aborts.
; ==========================================================

=malloc
    ; don't bother to set up a stack frame

    ; check if the high bit is set (to avoid an infinite loop below)
    77 8A 80 1F    ; shru ra r0 31
    7E 8A &__malloc_size_ok   ; jz ra &__malloc_size_ok
    7E 00 &__malloc_fatal     ; jz ra &__malloc_fatal
:__malloc_size_ok

    ; find the power-of-two at least as big as the given size
    70 81 02 00    ; add r1 2 0    ; start at 1<<2 == 4
:__malloc_pow2_loop
    76 82 01 81    ; shl r2 1 r1
    7D 83 82 80    ; ltu r3 r2 r0
    7E 83 &__malloc_pow2_found    ; jz r3 &__malloc_pow2_found
    70 81 81 01    ; add r1 r1 1
    7E 00 &__malloc_pow2_loop
:__malloc_pow2_found
    71 84 81 02    ; sub r4 r1 2    ; size class

    ; check the free list for this size class
    7C 85 <__free_lists   ; ims r5 <__free_lists
    7C 85 >__free_lists   ; ims r5 >__free_lists
    70 85 8E 85           ; add r5 rpp r5
    76 86 84 02           ; shl r6 r4 2
    78 87 85 86           ; ldw r7 r5 r6
    7E 87 &__malloc_new   ; jz r7 &__malloc_new

    ; assert that the size class matches
    78 89 87 FC
    71 89 89 84
    7E 89 01 00
    FF FF FF FF

    ; found! pop it and return
    78 88 87 00    ; ldw r8 r7 0
    79 88 85 86    ; stw r8 r5 r6
    70 80 87 00    ; add r0 r7 0
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

:__malloc_new

    ; we'll need to allocate. calculate the new size
    70 80 82 04    ; add r0 r2 4    ; new size (with metadata)

    ; load the current break
    7C 81 <__malloc_break   ; ims r1 <__malloc_break
    7C 81 >__malloc_break   ; ims r1 >__malloc_break
    78 82 8E 81             ; ldw r2 rpp r1

    ; increment it by the size
    70 83 82 80             ; add r3 r2 r0
    79 83 8E 81             ; stw r3 rpp r1

    ; make sure we haven't gone past the end of the heap
    7C 85 <__malloc_end     ; ims r5 <__malloc_end
    7C 85 >__malloc_end     ; ims r5 >__malloc_end
    78 85 8E 85             ; ldw r5 rpp r5
    7D 86 85 83             ; ltu r6 r5 r3
    7E 86 &__malloc_ok      ; jz r6 &__malloc_ok
    7E 00 &__malloc_fatal   ; jz 0 &__malloc_fatal

:__malloc_ok

    ; write the size class
    79 84 82 00             ; stw r4 r2 0

    ; return the pointer after the metadata
    70 80 82 04             ; add r0 r2 4
    78 8F 00 8C             ; ldw rip 0 rsp            ; ret

:__malloc_fatal
    7C 80 <__malloc_fatal_str   ; ims ra <__malloc_fatal_str
    7C 80 >__malloc_fatal_str   ; ims ra >__malloc_fatal_str
    70 80 8E 80                 ; add r0 rpp r0
    7C 8A <__fatal   ; ims ra <__fatal
    7C 8A >__fatal   ; ims ra >__fatal
    70 8F 8E 8A      ; add rip rpp ra   ; jump



; ==========================================================
; void* realloc(void* old_p, size_t new_size)
; ==========================================================
; Resizes a memory block.
;
; Resizing is performed by allocating a new block, copying the contents, and
; freeing the old block.
;
; vars:
; - old_p: rfp-4
; - new_size: rfp-8
; - new_p: rfp-12
; ==========================================================

=realloc

    ; check if the old pointer is null. if so, we'll forward to malloc.
    7E 80 &__realloc_null_src     ; jz r0 &__realloc_null_src

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp      ; enter
    79 8D 00 8C     ; stw rfp 0 rsp     ; ^^^           ; ^^^
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp   ; ^^^
    71 8C 8C 0C     ; sub rsp rsp 12

    ; save args
    79 80 8D FC     ; stw r0 rfp -4    ; old_p
    79 81 8D F8     ; stw r1 rfp -8    ; new_size

    ; call malloc(new_size)
    70 80 81 00      ; add r0 r1 0    ; mov r0 r1
    7C 8A <malloc    ; ims ra <malloc
    7C 8A >malloc    ; ims ra >malloc
    71 8C 8C 04      ; sub rsp rsp 4     ; push return address
    70 8B 8F 08      ; add rb rip 8
    79 8B 00 8C      ; stw rb 0 rsp
    70 8F 8E 8A      ; add rip rpp ra    ; jump
    70 8C 8C 04      ; add rsp rsp 4     ; pop return address

    ; this stage malloc aborts on failure so no need to check the return value.

    ; save new_p
    79 80 8D F4     ; stw r0 rfp -12   ; new_p

    ; get old size. the size class is stored before the pointer.
    78 81 8D FC     ; ldw r1 rfp -4    ; old_p
    78 82 81 FC     ; ldw r2 r1 -4     ; old_size_class
    70 82 82 02     ; add r2 r2 2
    76 82 01 82     ; shl r2 1 r2      ; old_size

    ; if new_size is less, use new_size instead
    78 83 8D F8     ; ldw r3 rfp -8    ; new_size
    7D 84 83 82     ; ltu r4 r3 r2
    7E 84 &__realloc_size_ok   ; jz r4 &__realloc_size_ok
    70 82 83 00     ; add r2 r3 0    ; mov r2 r3

:__realloc_size_ok

    ; call memcpy(new_p, old_p, min_size);
    7C 8A <memcpy    ; ims ra <memcpy
    7C 8A >memcpy    ; ims ra >memcpy
    71 8C 8C 04      ; sub rsp rsp 4     ; push return address
    70 8B 8F 08      ; add rb rip 8
    79 8B 00 8C      ; stw rb 0 rsp
    70 8F 8E 8A      ; add rip rpp ra    ; jump
    70 8C 8C 04      ; add rsp rsp 4     ; pop return address

    ; call free(old_p)
    78 80 8D FC      ; ldw r0 rfp -4    ; old_p
    7C 8A <free      ; ims ra <free
    7C 8A >free      ; ims ra >free
    71 8C 8C 04      ; sub rsp rsp 4     ; push return address
    70 8B 8F 08      ; add rb rip 8
    79 8B 00 8C      ; stw rb 0 rsp
    70 8F 8E 8A      ; add rip rpp ra    ; jump
    70 8C 8C 04      ; add rsp rsp 4     ; pop return address

    ; return new_p
    78 80 8D F4     ; ldw r0 rfp -12   ; new_p
    70 8C 8D 00     ; add rsp rfp 0    ; mov rsp rfp  ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp    ; pop rfp      ; ^^^
    70 8C 8C 04     ; add rsp rsp 4    ; ^^^          ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp    ; ret

:__realloc_null_src
    ; no old pointer. tail-call malloc(new_size)
    70 80 81 00      ; add r0 r1 0       ; mov r0 r1
    7C 8A <malloc    ; ims ra <malloc
    7C 8A >malloc    ; ims ra >malloc
    70 8F 8E 8A      ; add rip rpp ra    ; jump



; ==========================================================
; const char* __malloc_fatal_str;
; ==========================================================
; The error message printed when malloc() fails.
; ==========================================================

@__malloc_fatal_str
    ; "ERROR: malloc() failed." ^0A ^00
    45 52 52 4f 52 3a 20 6d  61 6c 6c 6f 63 28 29 20
  ;  E  R  R  O  R  :     m   a  l  l  o  c  (  )
    66 61 69 6c 65 64 2e 0a  00
  ;  f  a  i  l  e  d  . \n  \0



; ==========================================================
; void free(void* p);
; ==========================================================
; Frees the given memory, adding it to the free list that corresponds to its
; size class.
;
; There is no coalescing of memory. We simply store the pointer in its
; corresponding free list for later reuse. Once an allocation is made for a
; given size, it stays that size for the life of the program.
;
; The word preceding the pointer is the size class. The word at the pointer is
; the next link for the free list.
; ==========================================================

=free

    ; free(NULL) does nothing
    7E 80 &__free_null

    ; the size class is stored before the pointer
    78 81 80 FC   ; ldw r1 r0 -4

    ; find the slot within the free list array
    7C 82 <__free_lists   ; ims r2 <__free_lists
    7C 82 >__free_lists   ; ims r2 >__free_lists
    70 82 8E 82           ; add r2 rpp r2
    76 81 81 02           ; shl r1 r1 2

    ; push this allocation to the front of the list
    78 83 81 82    ; ldw r3 r1 r2
    79 83 80 00    ; stw r3 r0 0
    79 80 81 82    ; stw r0 r1 r2

:__free_null
    ; done
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret



; ==========================================================
; void* __malloc_largest_unused_region(size_t* out_size);
; ==========================================================
; Returns the bounds of the largest region of memory that is currently
; unallocated.
;
; This can be used as the heap for child processes.
; ==========================================================

; TODO nothing uses this until libc/1 is bootstrapped. but spawn.oo refers to
; it. TODO spawn.oo should move to libc/1
=__malloc_largest_unused_region
    FFFFFFFF;TODO
