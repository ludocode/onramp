; TODO nothing uses this until libc/1 is bootstrapped so this should be moved
; to libc/1 and converted to assembly. but we will need this bytecode spawn
; code for the onramp shell so for now we keep it in bytecode.
;
; TODO this can be largely simplified now that the program image is separate
; from the heap. Almost all of this can be moved into C, and the few bits that
; remain can be in assembly in libc/1.



; ==========================================================
; void __onramp_load_debug(const void* address, const char* /*optional*/ path);
; ==========================================================
; Loads debug info for a child program if supported by the VM.
;
; The return value of the syscall is ignored.
; ==========================================================

=__onramp_load_debug

    ; get syscall debug into r7
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 89 8E 8A                    ; ldw r9 rpp ra
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 16 03   ; shl ra 22 3       ; ra = offset of debug syscall (7<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of debug syscall

    ; check if the syscall exists
    78 86 87 00   ; ldw r6 r7 0    ; r6 = rip of debug syscall
    7E 86 &__onramp_load_debug_not_supported

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

:__onramp_load_debug_not_supported
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



; ==========================================================
; int __onramp_spawn_pit(
;         const void* program,
;         const size_t size,
;         void* process_info_table,
;         const char* filename);
; ==========================================================
; Runs an Onramp executable as a child process within this VM using the given
; process info table.
;
; The given process info table is used for the child. The syscall table will be
; replaced with one allocated by this function. The rest of the process info
; table must be valid before calling this.
;
; vars:
;     program_bytes: rfp-4
;     child_pit: rfp-8
;     exit_code: rfp-12
;     heap_start: rfp-16
;     heap_end: rfp-20
;     program_size: rfp-24
;     filename: rfp-28
;     parent program pointer: rfp-32
; ==========================================================

=__onramp_spawn_pit

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ^^^
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; store vars
    71 8C 8C 20     ; sub rsp rsp 32
    79 80 8D FC     ; stw r0 rfp -4
    79 82 8D F8     ; stw r2 rfp -8
    79 81 8D E8     ; stw r1 rfp -24
    79 83 8D E4     ; stw r3 rfp -28
    79 8E 8D E0     ; stw rpp rfp -32

    ; duplicate our syscall table.
    ; as of this writing there are 25 syscalls. we need 8 bytes per syscall.
        ; TODO this should either use or set the syscall count field. we need to
        ; decide whether we forward unknown syscalls to subprograms.
    7C 8A <__process_info_table    ; ims ra <__process_info_table
    7C 8A >__process_info_table    ; ims ra >__process_info_table
    78 80 8E 8A                    ; ldw r0 rpp ra    ; __process_info_table
    78 80 80 08                    ; ldw r0 r0 8      ; __process_info_table[SYSCALLS]
    76 81 17 03                    ; shl r1 25 3      ; r1 = 25 << 3

    ; call __memdup()
    7C 8A <__memdup   ; ims ra <__memdup
    7C 8A >__memdup   ; ims ra >__memdup
    71 8C 8C 04       ; sub rsp rsp 4          ; push return address
    70 8B 8F 08       ; add rb rip 8
    79 8B 00 8C       ; stw rb 0 rsp
    70 8F 8E 8A       ; add rip rpp ra         ; jump
    70 8C 8C 04       ; add rsp rsp 4          ; pop return address

    ; TODO check for out-of-memory

    ; store the child syscall_table in the child process info table
    78 81 8D F8     ; ldw r1 rfp -8   ; child_pit
    79 80 81 08     ; stw r0 r1 8     ; child_pit[SYSCALLS] = child_syscall_table
    79 19 81 28     ; stw 25 r1 40    ; child_pit[SYSCALL_COUNT] = 25

    ; replace the exit syscall with our own. the child will call this it when
    ; it wants to exit. we pass the stack pointer as the context so we can
    ; share this stack frame.
    7C 8A <__onramp_spawn_syscall_exit   ; ims ra <__onramp_spawn_syscall_exit
    7C 8A >__onramp_spawn_syscall_exit   ; ims ra >__onramp_spawn_syscall_exit
    70 8A 8E 8A     ; add ra rpp ra
    79 8A 80 00     ; stw ra r0 0
    79 8C 80 04     ; stw rsp r0 4

    ; Proxy the close syscall to prevent closing standard streams.
    ; (We don't bother to proxy open or malloc/free. Only cc uses this during
    ; bootstrapping; it prints an error and quits when a child program fails,
    ; and the parent shell will take care of leaks. We'll have a more complete
    ; spawn implementation in a later libc stage.)
    7C 8A <__onramp_spawn_syscall_close   ; ims ra <__onramp_spawn_syscall_close
    7C 8A >__onramp_spawn_syscall_close   ; ims ra >__onramp_spawn_syscall_close
    70 8A 8E 8A     ; add ra rpp ra
    79 8A 80 20     ; stw ra r0 32
    79 8C 80 24     ; stw rsp r0 36

    ; call __malloc_unused_region()
    70 80 8D F0     ; add r0 rfp -16
    7C 8A <__malloc_unused_region   ; ims ra <__malloc_unused_region
    7C 8A >__malloc_unused_region   ; ims ra >__malloc_unused_region
    71 8C 8C 04       ; sub rsp rsp 4          ; push return address
    70 8B 8F 08       ; add rb rip 8
    79 8B 00 8C       ; stw rb 0 rsp
    70 8F 8E 8A       ; add rip rpp ra         ; jump
    70 8C 8C 04       ; add rsp rsp 4          ; pop return address

    ; calculate child heap dimensions
    78 81 8D F0     ; ldw r1 rfp -16
    70 81 80 81     ; add r1 r0 r1
    79 80 8D F0     ; stw r0 rfp -16   ; heap_start
    79 81 8D EC     ; stw r1 rfp -20   ; heap_end

    ; write the child heap start into the pit
    78 81 8D F8     ; ldw r1 rfp -8   ; child_pit
    79 80 81 04     ; stw r0 r1 4     ; child_pit[HEAP_START] = heap_start

    ; call __onramp_load_debug(program, filename)
    78 80 8D FC       ; ldw r0 rfp -4
    78 81 8D E4       ; ldw r1 rfp -28
    7C 8A <__onramp_load_debug     ; ims ra <__onramp_load_debug
    7C 8A >__onramp_load_debug     ; ims ra >__onramp_load_debug
    71 8C 8C 04       ; sub rsp rsp 4          ; push return address
    70 8B 8F 08       ; add rb rip 8
    79 8B 00 8C       ; stw rb 0 rsp
    70 8F 8E 8A       ; add rip rpp ra         ; jump
    70 8C 8C 04       ; add rsp rsp 4          ; pop return address

    ; set registers for the new program. note we're switching stacks here
    78 8E 8D FC     ; ldw rpp rfp -4    ; program_bytes
    78 80 8D F8     ; ldw r0 rfp -8     ; child_pit
    78 8C 8D EC     ; ldw rsp rfp -20   ; heap_end
    70 8D 00 00     ; add rfp 0 0       ; zero rfp     ; not really necessary but helps debugging

    ; jump to the program
    70 8F 8E 00     ; add rip rpp 0    ; mov rip rpp



; ==========================================================
; static void __onramp_spawn_syscall_exit(int exit_code);
; ==========================================================
; A syscall called by a child process to exit.
;
; This shares the stack frame layout of __onramp_spawn_pit().
; ==========================================================

@__onramp_spawn_syscall_exit

    ; This is called by the child via the system call call convention. It has
    ; placed the context, our original stack pointer, in r9.

    ; restore our stack pointer
    70 8C 89 00     ; add rsp r9 0

    ; restore our frame pointer
    70 8D 8C 20     ; add rfp rsp 32

    ; restore our program pointer
    78 8E 8D E0     ; ldw rpp rfp -32

    ; We've now restored the stack frame of __onramp_spawn_pit(), so we can
    ; access all of its variables.

    ; store the exit code
    79 80 8D F4     ; stw r0 rfp -12   ; exit_code

    ; call __onramp_load_debug(heap_start, NULL)
    78 80 8D F0     ; ldw r0 rfp -16   ; heap_start
    70 81 00 00     ; add r1 0 0       ; filename (NULL)
    7C 8A <__onramp_load_debug     ; ims ra <__onramp_load_debug
    7C 8A >__onramp_load_debug     ; ims ra >__onramp_load_debug
    71 8C 8C 04       ; sub rsp rsp 4          ; push return address
    70 8B 8F 08       ; add rb rip 8
    79 8B 00 8C       ; stw rb 0 rsp
    70 8F 8E 8A       ; add rip rpp ra         ; jump
    70 8C 8C 04       ; add rsp rsp 4          ; pop return address

    ; get the new syscall table
    78 81 8D F8     ; ldw r1 rfp -8   ; child_pit
    78 80 81 08     ; ldw r0 r1 8     ; child_pit[SYSCALLS]

    ; call free()
    7C 8A <free     ; ims ra <free
    7C 8A >free     ; ims ra >free
    71 8C 8C 04     ; sub rsp rsp 4          ; push return address
    70 8B 8F 08     ; add rb rip 8
    79 8B 00 8C     ; stw rb 0 rsp
    70 8F 8E 8A     ; add rip rpp ra         ; jump
    70 8C 8C 04     ; add rsp rsp 4          ; pop return address

    ; return exit_code
    78 80 8D F4     ; ldw r0 rfp -12    ; exit_code
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



; ==========================================================
; static void __onramp_spawn_syscall_close(int handle);
; ==========================================================
; The proxied close syscall.
;
; We ignore closing the standard streams.
; ==========================================================

@__onramp_spawn_syscall_close

    ; The original stack pointer is in r9. We can get our original program
    ; pointer from it, and from there the process info table.
    70 88 89 20   ; add r8 rp 32   ; r8 = original rfp
    78 87 88 E0   ; ldw r7 r8 32   ; r7 = original rpp
    7C 8A <__process_info_table   ; ims ra <__process_info_table
    7C 8A >__process_info_table   ; ims ra >__process_info_table
    78 86 87 8A                   ; ldw r6 r7 ra    ; r6 = __process_info_table

    ; Compare against our standard streams. If it matches any of them, skip the
    ; close.
    78 85 86 0C   ; ldw r5 r6 12     ; stdin
    71 84 85 80   ; sub r4 r5 r0
    7E 84 0F 00   ; jz r4 &__onramp_spawn_syscall_close_done (+15)
    78 85 86 10   ; ldw r5 r6 16     ; stdout
    71 84 85 80   ; sub r4 r5 r0
    7E 84 0C 00   ; jz r4 &__onramp_spawn_syscall_close_done (+12)
    78 85 86 14   ; ldw r5 r6 20     ; stderr
    71 84 85 80   ; sub r4 r5 r0
    7E 84 09 00   ; jz r4 &__onramp_spawn_syscall_close_done (+9)

    ; get syscall close into r7
    78 88 86 08   ; ldw r8 r6 8       ; r8 = syscall table
    76 8A 04 03   ; shl ra 4 3        ; ra = offset of close syscall (4<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of close syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

;:__onramp_spawn_syscall_close_done
    ; return 0
    70 80 00 00     ; add r0 0 0        ; zero r0
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



