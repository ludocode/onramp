; This is the implementation of the Onramp shell script tool. It is written in
; hexadecimal Onramp bytecode.
;
; The main purpose of this shell is to run Onramp bootstrap scripts. For
; example `core/build.sh` bootstraps the compiler in a hosted environment.
;
; See the README.md or docs/shell.md for more info.



; Implementation details:
;
; We allocate 32 kB of free memory at startup (either from the initial heap or
; from a malloc syscall.) We use 4 kB for each of the input buffer and the
; stack, and a bit of extra memory for child structures (process info table,
; syscall table.)
;
; The remaining memory is used to parse commands and to load small subprograms.
; If a subprogram doesn't fit in the remaining heap, it gets its own
; allocation. (TODO alloc syscall is not implemented yet.)
;
; TODO may also need to copy env vars; see environ discussion below.
;
; Global variables start at 0x20 and end at 0x70. This allows all globals to be
; accessed with mix-type bytes.
;
; File I/O is buffered for efficiency. The implementation of buffering is
; similar to ld/0 except we only buffer the input file. We don't buffer `echo`
; output, but the line to print is assembled into a single string and can be
; printed in one syscall. We do also implement `cp` by copying in chunks.
;
; The shell runs a subshell by copying its program. For this reason, all global
; variables must be manually initialized. They are given the initial value
; 0xEEEEEEEE to ensure they are initialized properly.



; symbol table:
;     0  __start
;    20  process_info_table
;    24  input_io_handle
;    3C  current_char
;    40  heap_start
;    44  heap_end
;    48  input_buffer
;    50  input_buffer_pos
;    54  input_buffer_end
;    58  stop_on_error
;    5C  child_pit
;    60  args
;    64  arg_count
;    68  heap_ptr
;    6C  last_result
;    70  commands
;   120  error_input
;   140  error_usage
;   170  error_escape
;   1C0  error_out_of_memory
;   1E0  strlen
;   200  strcmp
;   250  exit
;   2A0  start
;   370  initialize
;   420  open_script
;   4F0  allocate
;   580  next_char_impl
;   6C0  next_char
;   780  consume_horizontal_space
;   800  fatal
;   890  write_all
;   980  parse_line
;   AB0  parse_argument
;   B90  append_argument_char
;   C40  error_unrecognized_command
;   C60  run_command
;   D50  command_echo
;   DF0  error_invalid_syntax
;   E10  command_set
;   EB0  handle_line
;   F50  consume_comment
;   FC0  error
;  1090  error_read_program
;  10B0  syscall_fclose
;  10E0  syscall_fseek
;  1110  syscall_ftell
;  1140  get_program_size
;  1290  read_all
;  1360  command_onrampvm
;  1580  run_subprogram
;  1630  cleanup_subprogram
;  1640  skip_preamble
;  16D0  align_heap
;  1740  syscall_mkdir
;  1770  command_mkdir
;  18A0  init_child_syscalls
;  19B0  command_sh
;  1AC0  syscall_debug
;  1B00  child_syscall_exit
;  1B90  syscall_fopen
;  1BC0  error_source_file
;  1BF0  error_destination_file
;  1C20  syscall_fread
;  1C50  syscall_fwrite
;  1C80  command_cp
;  1DC0  command_cp_open_dest
;  1ED0  command_cp_copy_data
;  2040  end_of_program



;==========================================
; [[noreturn]] void __start(uint32_t* process_info_table);
;==========================================

@0x00 =__start
    ; format indicator "~Onr~amp~   "
    7E 4F 6E 72   ; jz 79 29294
    7E 61 6D 70   ; jz 97 28781
    7E 20 20 20   ; jz 32 8224

    ; jump to start()
    7C 8A 00 00   ; ims ra <start
    7C 8A A0 02   ; ims ra >start (0x2A0)
    70 8F 8E 8A   ; add rip rpp ra        ; jump

    ; padding
    00 00 00 00 00 00 00 00
@0x20



;==========================================
; int process_info_table;
;==========================================

@0x20 =process_info_table
    EE EE EE EE
@0x24



;==========================================
; int input_io_handle;
;==========================================

@0x24 =input_io_handle
    EE EE EE EE
@0x28



    ; unused vars
    EE EE EE EE
    EE EE EE EE
    EE EE EE EE
    EE EE EE EE
    EE EE EE EE



;==========================================
; int current_char;
;==========================================
; This is an int because it has value -1 when end-of-file is reached.
;==========================================

@0x3C =current_char
    EE EE EE EE
@0x40



;==========================================
; char* heap_start;
;==========================================
; The start of free memory.
;==========================================

@0x40 =heap_start
    EE EE EE EE
@0x44



;==========================================
; char* heap_end;
;==========================================
; The end of free memory.
;==========================================

@0x44 =heap_end
    EE EE EE EE
@0x48



;==========================================
; char* input_buffer;
;==========================================
; The input buffer.
;
; This is allocated as an array of 4096 bytes at startup.
;
; input_buffer_pos and input_buffer_end point into this buffer. The portion of
; the buffer that contains data is the range between these two pointers.
;==========================================

@0x48 =input_buffer
    EE EE EE EE
@0x4C



;==========================================
; void* frame_pointer;
;==========================================
; The original frame pointer before running a subcommand (`onrampvm` or `sh`.)
;
; This is used to return control after running a child program.
;==========================================

@0x4C =frame_pointer
    EE EE EE EE
@0x50



;==========================================
; char* input_buffer_pos;
;==========================================
; The position of the next byte to be read from the input buffer.
;
; This is a pointer into input_buffer. If this matches input_buffer_end, the
; buffer is empty.
;==========================================

@0x50 =input_buffer_pos
    EE EE EE EE
@0x54



;==========================================
; char* input_buffer_end;
;==========================================
; The end of valid data in the input buffer.
;
; This is a pointer into input_buffer (or one past the last byte in
; input_buffer if the buffer was filled.)
;==========================================

@0x54 =input_buffer_end
    EE EE EE EE
@0x58



;==========================================
; bool stop_on_error;
;==========================================
; 1 if the script should stop on error (`set -e` has been run); 0 otherwise.
;==========================================

@0x58 =stop_on_error
    EE EE EE EE
@0x5C



;==========================================
; uint32_t* child_pit;
;==========================================
; The process info table for child programs.
;==========================================

@0x5C =child_pit
    EE EE EE EE
@0x60



;==========================================
; char** args;
;==========================================
; The parsed command line, stored as a list of null-terminated strings.
;
; Up to 127 arguments are supported. (The list must be null-terminated when
; running a command.)
;==========================================

@0x60 =args
    EE EE EE EE
@0x64



;==========================================
; size_t arg_count;
;==========================================
; The number of arguments in args, not counting the null-terminator.
;==========================================

@0x64 =arg_count
    EE EE EE EE
@0x68



;==========================================
; char* heap_ptr;
;==========================================
; A pointer between heap_start and heap_end that marks the start of free space.
;
; The heap is essentially used as a bump allocator. At the start of parsing a
; command, this is reset to heap_start. The pointer is incremented as data is
; written to the heap: command-line arguments, program to be run under
; `onrampvm`, directory to make with `mkdir`, etc.
;
; This is usually aligned, except after parsing a command when it points to the
; end of the argument list. The align_heap() function is used to align it for
; those commands that need it aligned.
;==========================================

@0x68 =heap_ptr
    EE EE EE EE
@0x6C



;==========================================
; int last_result;
;==========================================
; The result code of the last command that was run.
;
; The shell exits with this code when it reaches the end of the input, or if an
; error occurs after `set -e`.
;==========================================

@0x6C =last_result
    EE EE EE EE
@0x70



;==========================================
; void* commands;
;==========================================
; A mapping of command names and function pointers.
;
; This is a null-terminated list of pairs. Each pair consists of the address of
; the name of a command (as a null-terminated string) and the address of the
; function to handle it. All addresses are relative to the program pointer.
;==========================================

@0x70 =commands

    D0 00 00 00   50 0D 00 00    ; ^echo      ^command_echo (0xD50)
    D5 00 00 00   70 17 00 00    ; ^mkdir     ^command_mkdir (0x1770)
    DB 00 00 00   60 13 00 00    ; ^onrampvm  ^command_onrampvm (0x1360)
    E4 00 00 00   10 0E 00 00    ; ^set       ^command_set (0xE10)
    E8 00 00 00   80 1C 00 00    ; ^cp        ^command_cp (0x1C80)
    EB 00 00 00   B0 19 00 00    ; ^sh        ^command_sh (0x19B0)
    00 00 00 00   00 00 00 00    ; (null terminator)

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00

@0xD0 "echo"
    65 63 68 6f 00
  ;  e  c  h  o \0
@0xD5 "mkdir"
    6d 6b 64 69 72 00
  ;  m  k  d  i  r \0
@0xDB "onrampvm"
    6f 6e 72 61 6d 70 76 6d  00
  ; o  n  r  a  m  p  v  m   \0
@0xE4 "set"
    73 65 74 00
  ;  s  e  t \0
@0xE8 "cp"
    63 70 00
  ;  c  p \0
@0xEB "sh"
    73 68 00
  ;  s  h \0

    ; padding
                      00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x120



;==========================================
; const char error_input[];
;==========================================

@0x120 =error_input
    ; "ERROR: Failed to read input." '0A '00
    45 52 52 4f 52 3a 20 46  61 69 6c 65 64 20 74 6f
  ;  E  R  R  O  R  :     F  a  i  l  e  d     t  o
    20 72 65 61 64 20 66 69  6c 65 2e 0a 00 00 00 00
  ;     r  e  a  d     f  i   l  e  . \n \0
@0x140



