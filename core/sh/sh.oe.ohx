; const char error_usage[];
;==========================================

@0x140 =error_usage
    ; "ERROR: Invalid arguments." '0A
    ; "Usage: <sh> [script]" '0A '00
    45 52 52 4f 52 3a 20 49  6e 76 61 6c 69 64 20 61
  ;  E  R  R  O  R  :     I   n  v  a  l  i  d     a
    72 67 75 6d 65 6e 74 73  2e 0a 55 73 61 67 65 3a
