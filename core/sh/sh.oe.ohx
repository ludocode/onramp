    20 63 68 61 72 61 63 74  65 72 73 20 63 61 6e 20
  ;     c  h  a  r  a  c  t   e  r  s     c  a  n
    62 65 20 65 73 63 61 70  65 64 2e 0a 00 00 00 00
  ;  b  e     e  s  c  a  p   e  d  . \n \0
@0x1C0



;==========================================
; const char error_out_of_memory[];
;==========================================

@0x1C0 error_out_of_memory
    ; "ERROR: Out of memory." '0A '00
    45 52 52 4f 52 3a 20 4f  75 74 20 6f 66 20 6d 65
  ;  E  R  R  O  R  :     O   u  t     o  f     m  e
    6d 6f 72 79 2e 0a 00 00  00 00 00 00 00 00 00 00
  ;  m  o  r  y  . \n \0
@0x1E0



; ==========================================================
; size_t strlen(char* str)
; ==========================================================
; Returns the length of the given null-terminated string, not including the
; null-terminator.
;
; This is the standard C strlen() function.
;
; params:
;     - str: r0
; vars:
;     - count: r1
; ==========================================================

@0x1E0 =strlen
    ; don't bother to set up a stack frame
    ; we accumulate the count in r1, then move it to r0
    70 81 00 00         ; add r1 0 0           ; zero r1
;:strlen_loop
    7A 8A 80 81         ; ldb ra r0 r1
    7E 8A 02 00         ; jz ra &strlen_done (+2)
    70 81 81 01         ; add r1 r1 1          ; inc r1
    7E 00 FC FF         ; jz 0 &strlen_loop (-4)
;:strlen_done
    70 80 00 81         ; add r0 0 r1          ; mov r0 r1
    78 8F 00 8C         ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00
@0x200



; ==========================================================
; int strcmp(const char* left, const char* right)
; ==========================================================
; Compares null-terminated strings left to right lexicographically. Returns -1
; if left comes before right, 1 if left comes after right, 0 if they are equal.
;
; This is the standard C strcmp() function.
;
; params:
;     - left: r0
;     - right: r1
; vars:
;     - index: r2
; ==========================================================

@0x200 =strcmp
    ; don't bother to set up a stack frame

    ; we use an index because it's faster than incrementing both src and dest
    70 82 00 00                ; add r2 0 0           ; zero r2

;:strcmp_loop
    7A 8A 80 82                ; ldb ra r0 r2
    7A 8B 81 82                ; ldb rb r1 r2
    71 83 8A 8B                ; sub r3 ra rb
    7E 83 06 00                ; jz r3 &strcmp_byte_match (+6)

    ; bytes not equal, return a comparison result
    ; TODO this would be much simpler if we just used the subtraction result,
    ; except the rest of Onramp may assume the value is -1 or 1 because that's
    ; what cmpu did, this needs to be fixed
    7D 8A 8A 8B                ; ltu ra ra rb
    7E 8A 01 00                ; jz ra &strcmp_greater (+2)
;:strcmp_less
    70 80 00 FF                ; add r0 0 -1          ; mov r0 -1
    78 8F 00 8C                ; ldw rip 0 rsp        ; ret
;:strcmp_greater
    70 80 00 01                ; add r0 0 1           ; mov r0 1
    78 8F 00 8C                ; ldw rip 0 rsp        ; ret

;:strcmp_byte_match
    ; bytes match. if the byte is zero, it's the null terminator, which means
    ; the strings are equal.
    7E 8B 02 00                ; jz rb &strcmp_equal (+2)

    ; otherwise keep looping
    70 82 82 01                ; add r2 r2 1             ; inc r2
    7E 00 F3 FF                ; jz 0 &strcmp_loop (-13) ; jmp &strcmp_loop

;:strcmp_equal
    70 80 00 00                ; add r0 0 0           ; zero r0
    78 8F 00 8C                ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x250



;==========================================
; [[noreturn] void exit(int status);
;==========================================
; Exits with the given status.
;==========================================

@0x250 =exit
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    78 89 88 04   ; ldw r9 r8 4       ; r9 = r9 of syscall exit
    78 8F 88 00   ; ldw rip r8 0      ; rip = rip of syscall exit

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x280



;==========================================
; const char error_too_many_args[];
;==========================================

@0x280 =error_too_many_args
    ; "ERROR: Too many arguments." '0A '00
    45 52 52 4f 52 3a 20 54  6f 6f 20 6d 61 6e 79 20
  ;  E  R  R  O  R  :     T   o  o     m  a  n  y
    61 72 67 75 6d 65 6e 74  73 2e 0a 00 00 00 00 00
  ;  a  r  g  u  m  e  n  t   s  . \n \0
@0x2A0



;==========================================
; [[noreturn]] void start(uint32_t* process_info_table);
;==========================================
; Starts the program.
;
; params:
; - process_info_table: r0
;==========================================

@0x2A0 =start

    ; set up stack frame (without pushing rfp since we don't return)
    70 8D 00 8C    ; add rfp 0 rsp

    ; store the process info table
    79 80 8E 20   ; stw r0 rpp 0x20       ; process_info_table

    ; call allocate()
    7C 8A 00 00    ; ims ra <allocate
    7C 8A F0 04    ; ims ra >allocate (0x4F0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call open_script()
    7C 8A 00 00    ; ims ra <open_script
    7C 8A 20 04    ; ims ra >open_script (0x420)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call initialize()
    7C 8A 00 00    ; ims ra <initialize
    7C 8A 70 03    ; ims ra >initialize (0x370)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

;:start_handle_line

    ; call handle_line()
    7C 8A 00 00    ; ims ra <handle_line
    7C 8A B0 0E    ; ims ra >handle_line (0xEB0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; if current_char is not EOF, loop
    78 80 8E 3C    ; ldw r0 rpp 0x3C  ; current_char
    71 80 80 FF    ; sub r0 r0 -1
    7E 80 01 00    ; jz r0 &start_eof (+1)
    7E 00 F5 FF    ; jz 0 &start_handle_line (-11)

;:start_eof

    ; get the script handle. we'll close it if it's not stdin
    ; (TODO close it anyway. the VM spec technically says right now that we
    ; can't close stdin but we'll relax that soon.)
    ; (TODO probably shouldn't bother closing it at all, the spec will soon
    ; allow us to exit without closing files)
    78 80 8E 24    ; ldw r0 rpp 0x24  ; input_io_handle
    78 88 8E 20    ; ldw r8 rpp 0x20  ; process_info_table
    78 81 88 0C    ; ldw r1 r8 12     ; stdin
    71 81 81 80    ; sub r1 r1 r0
    7E 81 07 00    ; jz r1 &start_skip_close (+7)

    ; call syscall_fclose()
    7C 8A 00 00    ; ims ra <syscall_fclose
    7C 8A B0 10    ; ims ra >syscall_fclose (0x10B0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address
;:start_skip_close

    ; tail-call exit(last_result)
    78 80 8E 6C    ; ldw r0 rpp 0x6C  ; last_result
    7C 8A 00 00    ; ims ra <exit
    7C 8A 50 02    ; ims ra >exit (0x250)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
@0x370



;==========================================
; void initialize(void);
;==========================================
; Initializes most global variables.
;
; A few variables are initialized separately in start() and allocate() before
; this. This initializes everything else.
;==========================================

@0x370 =initialize
    ; don't bother to set up a stack frame

    ; clear variables
    79 00 8E 3C    ; stw 0 rpp 0x3C   ; current_char
    79 00 8E 50    ; stw 0 rpp 0x50   ; input_buffer_pos
    79 00 8E 54    ; stw 0 rpp 0x54   ; input_buffer_end
    79 00 8E 58    ; stw 0 rpp 0x58   ; stop_on_error
    79 00 8E 6C    ; stw 0 rpp 0x6C   ; last_result

    ; call next_char() to prime current_char
    7C 8A 00 00    ; ims ra <next_char
    7C 8A C0 06    ; ims ra >next_char (0x6C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get both process info tables
    78 80 8E 20   ; ldw r0 rpp 0x20       ; process_info_table
    78 81 8E 5C   ; ldw r1 rpp 0x5C       ; child_pit

    ; copy most of the table into the child
    78 82 80 00   ; ldw r2 r0 0x00   ; version
    79 82 81 00   ; stw r2 r1 0x00
    78 82 80 0C   ; ldw r2 r0 0x0C   ; input stream handle
    79 82 81 0C   ; stw r2 r1 0x0C
    78 82 80 10   ; ldw r2 r0 0x10   ; output stream handle
    79 82 81 10   ; stw r2 r1 0x10
    78 82 80 14   ; ldw r2 r0 0x14   ; error stream handle
    79 82 81 14   ; stw r2 r1 0x14
    78 82 80 20   ; ldw r2 r0 0x20   ; working directory
    79 82 81 20   ; stw r2 r1 0x20
    78 82 80 24   ; ldw r2 r0 0x24   ; capabilities
    79 82 81 24   ; stw r2 r1 0x24

    ; TODO for now we pass env vars as-is, but the child might modify them! We
    ; need to solve this. Either:
    ;
    ; - We copy them here
    ; - We forbid modifying env vars and the final libc will copy them
    ; - We don't allow modifying env vars in child programs of this stage shell
    ; - We don't pass along env vars in this stage shell at all
    ;
    ; The latter two solutions would require a second stage shell. If we can
    ; get a real shell working (oksh?) then maybe we don't need to write our
    ; own second stage. Or maybe we do want a simple second stage, nothing like
    ; POSIX but something that is usable for some very basic interactive use,
    ; like manually running a particular build script.
    ;
    ; Forbidding modifying env vars might be the best solution of all, for VMs
    ; and for the libc and for keeping this shell simple. The main problem with
    ; this is we can't necessarily copy them lazily; environ has to be
    ; declarable as extern char* so it can't be a macro. But, maybe we can do
    ; some magic where environ is a weak var so there's no copy if environ is
    ; never used. Or, maybe we do some compiler magic where environ is replaced
    ; by a builtin even if manually declared; but this could be a significant
    ; pain point if ever anyone else wants to port another compiler (of any
    ; language) to Onramp. Or maybe we're just overthinking the overhead of the
    ; libc copying the environment.
    78 82 80 1C   ; ldw r2 r0 0x1C   ; environ
    79 82 81 1C   ; stw r2 r1 0x1C

    ; initialize other vars
    79 19 81 28   ; stw 25 r1 0x28   ; system call count
    79 0C 81 2C   ; stw 12 r1 0x2C   ; process info count

    ; other pit fields:
    ; - heap start varies based on the loaded program
    ; - syscall table is already set by allocate()
    ; - command-line args is set after parsing

    ; call init_child_syscalls()
    7C 8A 00 00    ; ims ra <init_child_syscalls
    7C 8A A0 18    ; ims ra >init_child_syscalls (0x18A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; return
    78 8F 00 8C    ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x420



;==========================================
; void open_script(void);
;==========================================
; Opens the script file if provided.
;
; If no script was provided, we take commands from standard input.
;
; vars:
; - process_info_table: r0
;==========================================

@0x420 =open_script

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp       ; enter
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; TODO add script path onto working directory

    ; get the first argument if it exists
    78 88 8E 20     ; ldw r8 rpp 0x20 ; get process_info_table
    78 81 88 18     ; ldw r1 r8 24    ; get argv
    7E 81 05 00     ; jz r1 &open_script_no_arg (+5)   ; argv may be null
    78 80 81 00     ; ldw r0 r1 0     ; get argv[0]
    7E 80 03 00     ; jz r0 &open_script_no_arg (+3)   ; argv[0] may be null
    78 80 81 04     ; ldw r0 r1 4     ; get argv[1]
    7E 80 01 00     ; jz r0 &open_script_no_arg (+1)   ; argv[1] may be null
    7E 00 06 00     ; jz 0 &open_script_arg (+6)

;:open_script_no_arg
    ; take input from stdin
    78 80 88 0C     ; ldw r0 r8 12     ; input stream handle
    ; TODO we should check that it's not negative. input is optional; we need a
    ; nice error message if not supported.
    79 80 8E 24     ; stw r0 rpp 0x24  ; input_io_handle

    ; done
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

;:open_script_arg

    ; prepare args for syscall fopen
    70 81 00 00    ; add r1 0 0     ; read-only

    ; get syscall fopen into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 03 03   ; shl ra 3 3        ; ra = offset of fopen syscall (3<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fopen syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 8A 06 00    ; jz ra &open_script_fopen_fail (+6)

    ; failed to open input file. fatal
    7C 80 00 00    ; ims r0 <error_input
    7C 80 20 01    ; ims r0 >error_input (0x120)
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 00 08    ; ims ra >fatal (0x800)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:open_script_fopen_fail

    ; save handle
    79 80 8E 24     ; stw r0 rpp 0x24   ; input_io_handle

    ; done
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret



    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x4F0



;==========================================
; void allocate(void);
;==========================================
; Allocates all static memory.
;
; vars:
; - process_info_table: r0
;==========================================

@0x4F0 =allocate
    ; don't bother to set up a stack frame


    ; load the process info table
    78 80 8E 20   ; ldw r0 rpp 0x20       ; process_info_table

    ; TODO this should call another function called setup_memory(). If there
    ; isn't enough free heap, it should allocate it and switch stacks to it.
    ; The memory allocation syscall doesn't exist yet so for now we just make
    ; sure we have enough space.

    ; check if we have enough space
    78 81 80 04    ; ldw r1 r0 4   ; r1 == process_info_table[PROGRAM_BREAK]
    71 81 8C 81    ; sub r1 rsp r1
    76 82 01 10    ; shl r2 1 16   ; r2 = 64 kB
    7D 81 81 82    ; ltu r1 r1 r2
    7E 81 06 00    ; jz r1 &initialize_memory_ok (+6)

    ; not enough memory
    7C 80 00 00    ; ims r0 <error_out_of_memory
    7C 80 10 01    ; ims r0 >error_out_of_memory
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 00 08    ; ims ra >fatal (0x800)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:initialize_memory_ok

    ; We have enough free memory. We can proceed with the initialization.


    ; get the program break and align it. this is the start of the heap
    ; TODO this should be returned from setup_memory() since it might be newly
    ; allocated.
    78 82 80 04   ; ldw r2 r0 4
    70 82 82 03   ; add r2 r2 3
    74 82 82 FC   ; and r2 r2 -4

    ; allocate 4 kB for our input buffer
    76 85 01 0C   ; shl r5 1 12        ; 1 << 12 == 4096 bytes
    79 82 8E 48   ; stw r2 rpp 0x48    ; input_buffer
    70 82 82 85   ; add r2 r2 r5

    ; allocate a child process info table
    76 85 0C 02   ; shl r5 12 2        ; 12 * 4 == 48 bytes
    79 82 8E 5C   ; stw r2 rpp 0x5C    ; child_pit
    70 83 82 85   ; add r3 r2 r5

    ; allocate a child syscall table
    76 85 19 03   ; shl r5 25 3      ; 25 * 8 == 200 bytes
    79 83 82 08   ; stw r3 r2 8      ; child_pit[syscall_table]
    70 82 83 85   ; add r2 r3 r5

    ; allocate the args array
    76 85 01 09   ; shl r5 1 9        ; 1 << 9 == 512 == 4 * 128 args
    79 82 8E 60   ; stw r2 rpp 0x60   ; args
    70 82 82 85   ; add r2 r2 r5

    ; store the remaining heap as our heap start
    79 82 8E 40   ; stw r2 rpp 0x40    ; heap_start

    ; subtract 4kB for the stack, store it as heap_end
    71 83 8C 85   ; sub r3 rsp r5
    79 83 8E 44   ; stw r3 rpp 0x44    ; heap_end

    ; return
    78 8F 00 8C    ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x580



;==========================================
; void next_char_impl(void);
;==========================================
; Reads a character, or -1 if the end of the file has been reached, into
; current_char, without handling escape sequences.
;
; Note that this does not return the character. This is usually called after
; parsing a character in order to consume it.
;
; This should only be called by next_char() so that escape sequences are
; handled properly.
;
; This is adapted from read_char() in ld/0.
;
; vars:
; - read loop address: rfp-4
;==========================================

@0x580 =next_char_impl

;;;;; print the previous character
;;;70 81 8E 3C    ; add r1 rpp 0x3C    ; current_char
;;;71 82 81 FF    ; sub r2 r1 -1
;;;7E 82 0C 00    ; jz r2 +12
;;;78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
;;;78 80 89 10   ; ldw r0 r8 16     ; stdout
;;;70 82 00 01   ; add r2 0 1
;;;78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
;;;76 8A 06 03   ; shl ra 6 3        ; ra = offset of fwrite syscall (6<<3)
;;;70 87 88 8A   ; add r7 r8 8a      ; r7 = address of fwrite syscall
;;;78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
;;;71 8C 8C 04    ; sub rsp rsp 4    ; push return address
;;;70 8B 8F 08    ; add rb rip 8     ; ^^^
;;;79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
;;;78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
;;;70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 04     ; sub rsp rsp 4

    ; if current_char is -1, we've already reached end of file. we should not
    ; attempt to read again. (reading after eof would probably be a bug but we
    ; check anyway just to make sure)
    78 80 8E 3C     ; ldw r0 rpp 0x3C  ; current_char
    71 82 82 FF     ; sub r2 r2 -1
    7E 82 01 00     ; jz r2 &next_char_impl_already_eof (+1)
    7E 00 04 00     ; jz 0 &next_char_impl_not_already_eof (+4)

;:next_char_impl_already_eof
    ; already at eof. just return.
    ; TODO alternatively we could call fatal() with an internal error (bug) message.
    70 8C 8D 00    ; add rsp rfp 0    ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp    ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4    ; ^^^           ; ^^^
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

;:next_char_impl_not_already_eof

    ; get our buffer start and end pointers
    78 80 8E 50     ; ldw r0 rpp 0x50  ; input_buffer_pos
    78 81 8E 54     ; ldw r1 rpp 0x54  ; input_buffer_end

    ; check if they match. if so, the buffer is empty.
    71 81 81 80     ; sub r1 r1 r0
    7E 81 08 00     ; jz r1 &next_char_impl_buffer_empty (+8)

    ; the buffer has bytes in it. pop one into current_char; we're done.
    7A 82 80 00    ; ldw r2 r0 0
    79 82 8E 3C    ; stw r2 rpp 0x3C  ; current_char = *input_buffer_pos
    70 80 80 01    ; add r0 r0 1
    79 80 8E 50    ; stw r0 rpp 0x50  ; ++input_buffer_pos
    70 8C 8D 00    ; add rsp rfp 0    ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp    ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4    ; ^^^           ; ^^^
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

;:next_char_impl_buffer_empty

    ; the buffer is empty. we need to fill it.

    ; store this position to loop
    79 8F 8D FC    ; stw rip rfp -4
;:next_char_impl_read_loop

    ; prepare args
    78 80 8E 24    ; ldw r0 rpp 0x24  ; input_io_handle
    78 81 8E 48    ; ldw r1 rpp 0x48  ; input_buffer
    76 82 01 0C    ; shl r2 1 12      ; r2 = 4096

    ; get syscall fread into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 05 03   ; shl ra 5 3        ; ra = offset of fread syscall (5<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of fread syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; check if we got ERROR_TRY_LATER. if so loop
    71 8A 80 FB    ; sub ra r0 'FB   ; ERROR_TRY_LATER
    7E 8A 01 00    ; jz ra &next_char_impl_read_try_later (+1)
    7E 00 01 00    ; jz 0 &next_char_impl_read_not_try_later (+1)
;:next_char_impl_read_try_later
    78 8F 8D FC   ; ldw rip rfp -4   ; jump to :next_char_impl_read_loop
;:next_char_impl_read_not_try_later

    ; high bit indicates other error
    77 8A 80 1F    ; shru ra r0 31
    7E 8A 06 00    ; jz ra &next_char_impl_fill_ok (+6)

    ; failed to read from input file. fatal
    7C 80 00 00    ; ims r0 <error_input
    7C 80 20 01    ; ims r0 >error_input (0x120)
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 00 08    ; ims ra >fatal (0x800)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

;:next_char_impl_fill_ok

    ; r0 contains the number of bytes read. if zero, it's end of file.
    7E 80 01 00    ; jz r0 &next_char_impl_eof (+1)
    7E 00 05 00    ; jz 0 &next_char_impl_not_eof (+5)

;:next_char_impl_eof
    ; at end of file, put -1 (as an int) into current_char and return
    79 FF 8E 3C    ; stw -1 rpp 0x3C  ; current_char
    70 8C 8D 00    ; add rsp rfp 0    ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp    ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4    ; ^^^           ; ^^^
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

;:next_char_impl_not_eof

    ; get the first character
    78 81 8E 48    ; ldw r1 rpp 0x48  ; input_buffer
    7A 82 81 00    ; ldb r2 r1 0
    79 82 8E 3C    ; stw r2 rpp 0x3C   ; current_char = input_buffer[0]

    ; reset our buffer pointers
    70 83 81 80    ; add r3 r1 r0
    79 83 8E 54    ; stw r3 rpp 0x54  ; input_buffer_end = &input_buffer + bytes_read
    70 81 81 01    ; add r1 r1 1     (increment past the character we just read)
    79 81 8E 50    ; stw r1 rpp 0x50  ; input_buffer_pos = &input_buffer + 1

    ; finally done
    70 8C 8D 00    ; add rsp rfp 0    ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp    ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4    ; ^^^           ; ^^^
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x6C0



;==========================================
; void next_char(void);
;==========================================
; Reads a character, or -1 if the end of the file has been reached, into
; current_char, handling escape sequences.
;
; Note that this does not return the character. This is usually called after
; parsing a character in order to consume it.
;==========================================

@0x6C0 =next_char

    ; call next_char_impl()
    7C 8A 00 00    ; ims ra <next_char_impl
    7C 8A 80 05    ; ims ra >next_char_impl (0x580)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; check if the current char is '\'
    78 80 8E 3C     ; ldw r0 rpp 0x3C  ; current_char
    71 80 80 5C     ; sub r0 r0 "\"
    7E 80 01 00    ; jz r0 &next_char_escape (+1)

    ; it's not '\'. we're done.
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

;:next_char_escape

    ; escape character found. consume it, call next_char_impl()
    7C 8A 00 00    ; ims ra <next_char_impl
    7C 8A 80 05    ; ims ra >next_char_impl (0x580)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; check if the current character is a line feed
    78 80 8E 3C     ; ldw r0 rpp 0x3C  ; current_char
    71 8A 80 0A     ; sub ra r0 "\n"
    7E 8A 01 00     ; jz ra &next_char_line_feed (+1)
    7E 00 0A 00     ; jz 0 &next_char_not_line_feed (+10)

;:next_char_line_feed
    ; it's a line feed. tail-call ourselves to loop, thus consuming it.
    7C 8A 00 00    ; ims ra <next_char
    7C 8A C0 06    ; ims ra >next_char (0x6C0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

;:next_char_not_line_feed
    ; Not a line feed. We only support line feed. A syntax error is a fatal
    ; error even without `set -e`.
    7C 80 00 00    ; ims r0 <error_escape
    7C 80 70 01    ; ims r0 >error_escape (0x170)
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 00 08    ; ims ra >fatal (0x800)
    70 8F 8E 8A    ; add rip rpp ra

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x780



;==========================================
; void consume_horizontal_space(void);
;==========================================
; Consumes all horizontal space (spaces and horizontal tabs.)
;==========================================

@0x780 =consume_horizontal_space
    ; don't bother to set up a stack frame

;:consume_horizontal_space_loop

    ; get the current char
    78 80 8E 3C     ; ldw r0 rpp 0x3C  ; current_char

    ; check for horizontal whitespace
    71 8A 80 20    ; sub ra r0 " "   (space)
    7E 8A 03 00    ; jz ra &try_parse_whitespace_true (+3)
    71 8A 80 09    ; sub ra r0 "\t"  (horizontal tab)
    7E 8A 01 00    ; jz ra &try_parse_whitespace_true (+1)

    ; not horizontal space. return
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

    ; consume it, call next_char()
    7C 8A 00 00    ; ims ra <next_char
    7C 8A C0 06    ; ims ra >next_char (0x6C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; loop
    7E 00 F2 FF    ; jz 0 &consume_horizontal_space_loop (-14)

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x800



;==========================================
; [[noreturn] void fatal(const char* message);
;==========================================
; Prints the given error message and exits.
;==========================================

@0x800 =fatal
    ; don't bother to set up a stack frame, we're exiting

    ; push message
    71 8C 8C 04     ; sub rsp rsp 4     ; push r0
    79 80 00 8C     ; stw r0 0 rsp      ; ...

    ; call strlen()
    7C 8A 00 00    ; ims ra <strlen
    7C 8A E0 01    ; ims ra >strlen (0x1E0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get args for write_all(stderr, message, length)
    70 82 80 00   ; add r2 r0 0       ; r2 = length
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 80 89 14   ; ldw r0 r9 20      ; r0 = stderr
    78 81 8C 00   ; ldw r1 rsp 0      ; r1 = message

    ; call write_all()
    7C 8A 00 00    ; ims ra <write_all
    7C 8A 90 08    ; ims ra >write_all (0x890)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; If write_all() failed, we exit with status code 2; otherwise we exit with
    ; status code 1. There's not really anything else we can do to indicate
    ; that we failed to write an error message.
    7E 80 02 00    ; jz r0 &fatal_print_ok (+2)
    70 80 02 00    ; add r0 2 0    ; exit status 2
    7E 00 01 00    ; jz r0 &fatal_print_done (+1)
;:fatal_print_ok
    70 80 01 00    ; add r0 1 0    ; exit status 1
;:fatal_print_done

    ; tail-call exit()
    7C 8A 00 00    ; ims ra <exit
    7C 8A 50 02    ; ims ra >exit (0x250)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x890



;==========================================
; int write_all(int handle, const char* data, size_t count);
;==========================================
; Writes all of the given data to the given I/O handle.
;
; Returns zero if successful, or the syscall error code if it fails.
;
; vars
; - io_handle: rfp-4
; - data: rfp-8
; - remaining: rfp-12
; - loop address: rfp-16
;==========================================

@0x890 =write_all

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; store args
    71 8C 8C 10     ; sub rsp rsp 16
    79 80 8D FC     ; stw r0 rfp -4   ; io_handle
    79 81 8D F8     ; stw r1 rfp -8   ; data
    79 82 8D F4     ; stw r2 rfp -12  ; remaining

    ; store the address to loop
    79 8F 8D F0    ; stw rip rfp -16
;:write_all_loop

    ; get args
    78 80 8D FC   ; ldw r0 rfp -4     ; io_handle
    78 81 8D F8   ; ldw r1 rfp -8     ; data
    78 82 8D F4   ; ldw r2 rfp -12    ; remaining

    ; get syscall fwrite into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 06 03   ; shl ra 6 3        ; ra = offset of fwrite syscall (6<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of fwrite syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; check if we got ERROR_TRY_LATER. if so loop
    71 8A 80 FB    ; sub ra r0 'FB   ; ERROR_TRY_LATER
    7E 8A 01 00    ; jz ra &write_all_try_later (+1)
    7E 00 01 00    ; jz 0 &write_all_not_try_later (+1)
;:write_all_try_later
    78 8F 8D F0   ; ldw rip rfp -16   ; jump to :write_all_loop
;:write_all_not_try_later

    ; check the high bit for other errors
    77 8A 80 1F   ; shru ra r0 31
    7E 8A 04 00   ; jz ra &write_all_no_error (+4)
    ; fail, return the error code
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;:write_all_no_error

    ; check if we got zero
    7E 80 01 00   ; jz r0 &write_all_zero (+1)
    7E 00 05 00   ; jz 0 &write_all_not_zero (+5)
;:write_all_zero
    ; zero bytes written. this should not be possible; the vm is
    ; malfunctioning. fail, return generic error -1
    70 80 00 FF     ; add r0 0 -1
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;:write_all_not_zero

    ; adjust pointer and bytes remaining
    78 81 8D F8   ; ldw r1 rfp -8
    78 82 8D F4   ; ldw r2 rfp -12
    70 81 81 80   ; add r1 r1 r0
    71 82 82 80   ; sub r2 r2 r0
    79 81 8D F8   ; stw r1 rfp -8
    79 82 8D F4   ; stw r2 rfp -12

    ; if bytes remaining is zero, we're done
    7E 82 02 00   ; jz r2 &write_all_loop_exit (+2)

    ; otherwise loop.
    78 8F 8D F0   ; ldw rip rfp -16   ; jump to :write_all_loop

;:write_all_loop_exit

    ; done, return zero
    70 80 00 00     ; add r0 0 0        ; zero r0
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x980



;==========================================
; void parse_line(void);
;==========================================
; Parses a line (including escaped newlines.)
;
; Arguments are parsed into heap_ptr starting at heap_start. A pointer to each
; argument is added to the args array. arg_count contains the number of
; arguments (including the command) and is 0 if the line is blank.
;
; vars:
; - loop_address: rfp-4  (rpp + &parse_line_loop)
;==========================================

@0x980 =parse_line

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp       ; enter
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; initialize parsing state
    79 00 8E 64   ; stw 0 rpp 0x64     ; arg_count
    78 8A 8E 40   ; ldw ra rpp 0x40    ; heap_start
    79 8A 8E 68   ; stw ra rpp 0x68    ; heap_ptr

    ; save rip so we can jump back here to loop
    71 8C 8C 04    ; sub rsp rsp 4
    79 8F 8D FC    ; stw rip rfp -4    ; loop_address

;:parse_line_loop

    ; consume horizontal whitespace
    7C 8A 00 00    ; ims ra <consume_horizontal_space
    7C 8A 80 07    ; ims ra >consume_horizontal_space (0x780)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the current character
    78 80 8E 3C     ; ldw r0 rpp 0x3C  ; current_char

    ; check for line feed or EOF
    71 81 80 0A    ; sub r1 r0 "\n"
    7E 81 0C 00    ; jz r1 &parse_line_done (+12)
    71 81 80 FF    ; sub r1 r0 -1
    7E 81 0A 00    ; jz r1 &parse_line_done (+10)

    ; check if we have a comment
    71 81 80 23    ; sub r1 r0 "#"
    7E 81 01 00    ; jz r1 &parse_line_comment (+1)
    7E 00 0B 00    ; jz 0 &parse_line_not_comment (+11)

;:parse_line_comment
    ; we have a comment. consume the rest of the line, call consume_comment()
    7C 8A 00 00    ; ims ra <consume_comment
    7C 8A 50 0F    ; ims ra >consume_comment (0xF50)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

;:parse_line_done

    ; done
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

;:parse_line_not_comment

    ; it's a command line argument.
    ; store heap_ptr as the current argument, increment arg_count
    78 80 8E 60   ; ldw r0 rpp 0x60    ; args
    78 81 8E 64   ; ldw r1 rpp 0x64    ; arg_count
    78 82 8E 68   ; ldw r2 rpp 0x68    ; heap_ptr
    76 8A 81 02   ; shl ra r1 2
    79 82 80 8A   ; stw r2 r0 ra       ; args[arg_count] = heap_ptr
    70 81 81 01   ; add r1 r1 1
    79 81 8E 64   ; stw r1 rpp 0x64    ; arg_count

    ; check if arg_count is 128
    76 8B 01 07   ; shl rb 1 7      ; 128
    71 8A 81 8B   ; sub ra r1 rb
    7E 8A 01 00   ; jz ra &parse_line_too_many_args (+1)
    7E 00 06 00   ; jz 0 &parse_line_arg_count_ok (+6)

;:parse_line_too_many_args
    ; too many arguments. fatal error
    7C 80 00 00    ; ims r0 <error_too_many_args
    7C 80 80 02    ; ims r0 >error_too_many_args (0x280)
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 00 08    ; ims ra >fatal (0x800)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:parse_line_arg_count_ok

    ; call parse_argument()
    7C 8A 00 00    ; ims ra <parse_argument
    7C 8A B0 0A    ; ims ra >parse_argument (0xAB0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; jump back to &parse_line_loop
    78 8F 8D FC    ; ldw rip rfp -4    ; loop_address

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0xAB0



;==========================================
; void parse_argument(void);
;==========================================
; Parses one argument in a command line.
;
; vars:
; - loop_address: rfp-4  (rpp + &parse_argument_loop)
;==========================================

@0xAB0 =parse_argument

    ; set up a stack frame
    71 8C 8C 04    ; sub rsp rsp 4     ; push rfp       ; enter
    79 8D 00 8C    ; stw rfp 0 rsp     ; ...
    70 8D 8C 00    ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 04    ; sub rsp rsp 4

    ; save rip so we can jump back here to loop
    71 8C 8C 04    ; sub rsp rsp 4
    79 8F 8D FC    ; stw rip rfp -4    ; loop_address

;:parse_argument_loop

    ; store the current char, call append_argument_char()
    7A 80 8E 3C    ; ldb r0 rpp 0x3C    ; current_char
    7C 8A 00 00    ; ims ra <append_argument_char
    7C 8A 90 0B    ; ims ra >append_argument_char (0xB90)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call next_char()
    7C 8A 00 00    ; ims ra <next_char
    7C 8A C0 06    ; ims ra >next_char (0x6C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; check if the current char is whitespace or eol
    78 80 8E 3C    ; ldw r0 rpp 0x3C    ; current_char
    71 81 80 20    ; sub r1 r0 " "
    7E 81 07 00    ; jz r1 &parse_argument_eol (+7)
    71 81 80 09    ; sub r1 r0 "\t"
    7E 81 05 00    ; jz r1 &parse_argument_eol (+5)
    71 81 80 0A    ; sub r1 r0 "\n"
    7E 81 03 00    ; jz r1 &parse_argument_eol (+3)
    71 81 80 FF    ; sub r1 r0 -1
    7E 81 01 00    ; jz r1 &parse_argument_eol (+1)
    7E 00 01 00    ; jz 0 &parse_argument_not_eol (+1)

;:parse_argument_eol
    ; end of argument
    7E 00 01 00     ; jz 0 &parse_argument_done (+1)
;:parse_argument_not_eol

    ; jump back to &parse_argument_loop
    78 8F 8D FC    ; ldw rip rfp -4    ; loop_address

;:parse_argument_done

    ; store a null terminator, call append_argument_char()
    70 80 00 00    ; add r0 0 0    ; zero r0
    7C 8A 00 00    ; ims ra <append_argument_char
    7C 8A 90 0B    ; ims ra >append_argument_char (0xB90)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; return
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0xB90



;==========================================
; void append_argument_char(char c);
;==========================================
; Appends the given character to the current argument, raising a fatal error if
; there is not enough space.
;==========================================

@0xB90 =append_argument_char

;71 8C 8C 04     ; sub rsp rsp 4     ; push r0
;79 80 00 8C     ; stw r0 0 rsp      ; ...
;70 81 8C 00    ; add r1 rsp 0
;70 82 01 01
;78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
;78 80 89 10   ; ldw r0 r8 16     ; stdout
;70 82 00 01   ; add r2 0 1
;78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
;76 8A 06 03   ; shl ra 6 3        ; ra = offset of fwrite syscall (6<<3)
;70 87 88 8A   ; add r7 r8 8a      ; r7 = address of fwrite syscall
;78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
;71 8C 8C 04    ; sub rsp rsp 4    ; push return address
;70 8B 8F 08    ; add rb rip 8     ; ^^^
;79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
;78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
;70 8C 8C 04    ; add rsp rsp 4    ; pop return address
;78 80 00 8C     ; ldw r0 0 rsp      ; ...
;70 8C 8C 04     ; add rsp rsp 4     ; pop r0

    ; check if heap_ptr matches heap_end
    78 81 8E 68   ; ldw r1 rpp 0x68    ; heap_ptr
    78 82 8E 44   ; ldw r2 rpp 0x44    ; heap_end
    71 82 81 82   ; sub r2 r1 r2
    7E 82 01 00   ; jz r2 &append_argument_char_oom (+1)
    7E 00 06 00   ; jz 0 &append_argument_char_ok (+6)

;:append_argument_char_oom
    ; not enough memory
    7C 80 00 00    ; ims r0 <error_out_of_memory
    7C 80 10 01    ; ims r0 >error_out_of_memory
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 00 08    ; ims ra >fatal (0x800)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:append_argument_char_ok

    ; store the character at heap_ptr
    7B 80 81 00    ; stb r0 r1 0

    ; increment it
    70 81 81 01    ; add r1 r1 1
    79 81 8E 68    ; stw r1 rpp 0x68    ; heap_ptr

    ; done
    78 8F 00 8C    ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0xC40



;==========================================
; const char error_unrecognized_command[];
;==========================================

@0xC40 =error_unrecognized_command
    ; "ERROR: Unrecognized command." '0A '00
    45 52 52 4f 52 3a 20 55  6e 72 65 63 6f 67 6e 69
  ;  E  R  R  O  R  :     U   n  r  e  c  o  g  n  i
    7a 65 64 20 63 6f 6d 6d  61 6e 64 2e 0a 00 00 00
  ;  z  e  d     c  o  m  m   a  n  d  . \n \0
@0xC60



;==========================================
; void run_command(void);
;==========================================
; Runs the command that was parsed.
;
; vars:
; - command_name: r0, rfp-4
; - commands_ptr: r2, rfp-8
;==========================================

@0xC60 =run_command

    ; if arg_count is zero, the line is blank. return.
    78 80 8E 64    ; ldw r0 rpp 0x64    ; arg_count
    7E 80 01 00    ; jz r0 &run_command_blank
    7E 00 01 00    ; jz 0 &run_command_not_blank
;:run_command_blank
    78 8F 00 8C    ; ldw rip 0 rsp        ; ret
;:run_command_not_blank

    ; set up a stack frame
    71 8C 8C 04    ; sub rsp rsp 4     ; push rfp       ; enter
    79 8D 00 8C    ; stw rfp 0 rsp     ; ^^^            ; ^^^
    70 8D 8C 00    ; add rfp rsp 0     ; mov rfp rsp    ; ^^^
    71 8C 8C 08    ; sub rsp rsp 8

    ; store the command
    78 80 8E 60   ; ldw r0 rpp 0x60    ; args
    78 80 80 00   ; ldw r0 r0 0
    79 80 8D FC   ; stw r0 rfp -4

    ; initialize a pointer into the commands array
    70 82 8E 70   ; add r2 rpp 0x70    ; commands
    79 82 8D F8   ; stw r2 rfp -8

;:run_command_loop

    ; get commands to compare
    78 82 8D F8   ; ldw r2 rfp -8
    78 81 82 00   ; ldw r1 r2 0
    70 81 8E 81   ; add r1 rpp r1
    78 80 8D FC   ; ldw r0 rfp -4

    ; call strcmp()
    7C 8A 00 00    ; ims ra <strcmp
    7C 8A 00 02    ; ims ra >strcmp (0x200)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; if equal, jump out of the loop
    7E 80 0C 00   ;  jz r0 &run_command_found (+12)

    ; increment commands_ptr
    78 82 8D F8   ; ldw r2 rfp -8
    70 82 82 08   ; add r2 r2 8
    79 82 8D F8   ; stw r2 rfp -8

    ; if the next command is null, we're out of commands
    78 81 82 00   ; ldw r1 r2 0
    7E 81 01 00   ; jz r1 &run_command_no_match (+1)

    ; otherwise loop
    7E 00 EE FF   ; jz 0 &run_command_loop (-18)

;:run_command_no_match
    ; no such command
    ; TODO return error code 127
    7C 80 00 00    ; ims r0 <error_unrecognized_command
    7C 80 40 0C    ; ims r0 >error_unrecognized_command (0xC40)
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 00 08    ; ims ra >fatal (0x800)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

;:run_command_found

    ; get the function pointer
    78 82 8D F8   ; ldw r2 rfp -8
    78 80 82 04   ; ldw r0 r2 4

    ; clean up our stack frame
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^

    ; tail-call the command handler
    70 8F 8E 80    ; add rip rpp r0

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0xD50



;==========================================
; void command_echo(void);
;==========================================
; Runs the `echo` command.
;
; The arguments are already adjacent in the heap separated by null terminators.
; We replace the null terminators with spaces and a line feed to compose the
; final string to be written.
;==========================================

@0xD50 =command_echo

    ; heap_ptr points to one past the null-terminator of the last argument.
    ; replace the null-terminator with a line feed.
    78 85 8E 68   ; ldw r5 rpp 0x68    ; heap_ptr
    7B 0A 85 FF   ; stb "\n" r5 -1

    ; if there are no args
    78 81 8E 64   ; ldw r1 rpp 0x64    ; arg_count
    71 8A 81 01   ; sub ra r1 1
    7E 8A 01 00   ; jz ra &command_echo_no_args (+1)
    7E 00 02 00   ; jz 0 &command_echo_args (+2)

;:command_echo_no_args
    ; no args. print only the line feed.
    71 81 85 01   ; sub r1 r5 1
    7E 00 0A 00   ; jz 0 &command_echo_skip_args (+10)

;:command_echo_args
    ; for each argument after the first two, the preceding byte is the
    ; null-terminator of the previous argument. replace the null-terminator
    ; with a space.
    78 80 8E 60   ; ldw r0 rpp 0x60    ; args
    70 82 02 00   ; add r2 2 0         ; index
;:command_echo_loop
    71 8A 82 81   ; sub ra r2 r1
    7E 8A 05 00   ; jz ra &command_echo_break (+5)
    76 83 82 02   ; shl r3 r2 2
    78 84 80 83   ; ldw r4 r0 r3     ; arg
    7B 20 84 FF   ; stb " " r4 -1
    70 82 82 01   ; add r2 r2 1
    7E 00 F9 FF   ; jz 0 &command_echo_loop (-7)
;:command_echo_break

    ; the string to write is from args[1] to heap_ptr.
    78 81 80 04   ; ldw r1 r0 4     ; message: args[1]
;:command_echo_skip_args
    71 82 85 81   ; sub r2 r5 r1    ; length: heap_ptr - message

    ; get stdout
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 80 89 10   ; ldw r0 r9 16      ; r0 = stdout

    ; call write_all()
    7C 8A 00 00    ; ims ra <write_all
    7C 8A 90 08    ; ims ra >write_all (0x890)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; clear last_result
    79 00 8E 6C    ; stw 0 rpp 0x6C   ; last_result

    ; done
    78 8F 00 8C         ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0xDF0



;==========================================
; const char error_invalid_syntax[];
;==========================================

@0xDF0 =error_invalid_syntax
    ; "ERROR: Invalid syntax." '0A '00
    45 52 52 4f 52 3a 20 49  6e 76 61 6c 69 64 20 73
  ;  E  R  R  O  R  :     I   n  v  a  l  i  d     s
    79 6e 74 61 78 2e 0a 00  00 00 00 00 00 00 00 00
  ;  y  n  t  a  x  . \n \0
@0xE10



;==========================================
; void command_set(void);
;==========================================
; Runs the `set` command.
;
; Only `set -e` is supported.
;==========================================

@0xE10 =command_set

    ; we need exactly one arg, plus set itself
    78 81 8E 64   ; ldw r1 rpp 0x64    ; arg_count
    71 8A 81 02   ; sub ra r1 2
    7E 8A 01 00   ; jz ra &command_set_good_arg_count (+1)
    7E 00 0A 00   ; jz ra &command_set_bad_args (+10)
;:command_set_good_arg_count

    ; load the arg
    78 80 8E 60    ; ldw r0 rpp 0x60    ; args
    78 82 80 04    ; ldw r2 r0 4        ; args[1]

    ; make sure the arg is "-e"
    7A 8A 82 00    ; ldb ra r2 0
    71 8A 8A 2D    ; sub ra ra "-"
    7A 8B 82 01    ; ldb rb r2 1
    71 8B 8B 65    ; sub rb rb "e"
    75 8A 8A 8B    ; or ra ra rb
    7A 8B 82 02    ; ldb rb r2 2    ; null-terminator
    75 8A 8A 8B    ; or ra ra rb
    7E 8A 07 00    ; jz ra &command_set_arg_ok (+7)

;:command_set_bad_arg
    ; invalid syntax, tail-call error()
    7C 80 00 00    ; ims r0 <error_invalid_syntax
    7C 80 F0 0D    ; ims r0 >error_invalid_syntax (0xDF0)
    70 80 8E 80    ; add r0 rpp r0
    70 81 00 01    ; add r1 0 1      ; mov r1 1
    7C 8A 00 00    ; ims ra <error
    7C 8A C0 0F    ; ims ra >error (0xFC0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

;:command_set_arg_ok

    ; set stop on error
    79 01 8E 58   ; stw 1 rpp 0x58    ; stop_on_error

    ; clear last_result
    79 00 8E 6C    ; stw 0 rpp 0x6C   ; last_result

    ; done
    78 8F 00 8C         ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0xEB0



;==========================================
; void handle_line(void);
;==========================================
; Parses one line and runs the command (if not blank).
;
; We consume the line ending after running the command in case we are running
; interactively. (Consuming the line ending blocks until another character is
; available.)
;==========================================

@0xEB0 =handle_line

    ; call parse_line()
    7C 8A 00 00    ; ims ra <parse_line
    7C 8A 80 09    ; ims ra >parse_line (0x980)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call run_command()
    7C 8A 00 00    ; ims ra <run_command
    7C 8A 60 0C    ; ims ra >run_command (0xC60)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; loop to consume all line endings
;:handle_line_loop

    ; check if we have a line ending
    78 80 8E 3C    ; ldw r0 rpp 0x3C  ; current_char
    71 80 80 0A    ; sub r0 r0 "\n"
    7E 80 01 00    ; jz r0 &handle_line_next (+1)
    7E 00 08 00    ; jz 0 &handle_line_break (+8)

;:handle_line_next
    ; consume the line ending, call next_char()
    7C 8A 00 00    ; ims ra <next_char
    7C 8A C0 06    ; ims ra >next_char (0x6C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; loop
    7E 00 F4 FF    ; jz 0 &handle_line_loop (-12)
;:handle_line_break

    ; done
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0xF50



;==========================================
; void consume_comment(void);
;==========================================
; Called when a '#' character is found (at the start of an argument.)
;
; Consumes all characters until the end of the line.
;==========================================

@0xF50 =consume_comment

;:consume_comment_loop

    ; call next_char()
    7C 8A 00 00    ; ims ra <next_char
    7C 8A C0 06    ; ims ra >next_char (0x6C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; check for line feed or EOF
    78 80 8E 3C    ; ldw r0 rpp 0x3C  ; current_char
    71 81 80 0A    ; sub r1 r0 "\n"
    7E 81 03 00    ; jz r1 &consume_comment_eol (+3)
    71 81 80 FF    ; sub r1 r0 -1
    7E 81 01 00    ; jz r1 &consume_comment_eol (+1)
    7E 00 F3 FF    ; jz 0 &consume_comment_loop (-13)

;:consume_comment_eol
    ; done
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0xFC0



;==========================================
; void error(char* /*nullable*/ message, int exit_code);
;==========================================
; Handles a recoverable error running a command.
;
; If the given message is non-null, it is printed to stderr. (A null message is
; typically used when a subprogram fails. The program is expected to have
; printed its own error message.)
;
; If `set -e` was run, the shell exits with the given error code; otherwise it
; is stored in last_result in case this is the last command in the script.
;
; vars:
; - message: rfp-4
; - exit_code: rfp-8
;==========================================

@0xFC0 =error

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; store arguments
    71 8C 8C 08     ; sub rsp rsp 8
    79 80 8D FC     ; stw r0 rfp -4    ; message
    79 81 8D F8     ; stw r1 rfp -8    ; exit_code

    ; skip printing if message is null
    7E 80 12 00   ; jz r0 &error_no_message (+18)

    ; call strlen()
    7C 8A 00 00    ; ims ra <strlen
    7C 8A E0 01    ; ims ra >strlen (0x1E0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get args for write_all(stderr, message, length)
    70 82 80 00   ; add r2 r0 0       ; r2 = length
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 80 89 14   ; ldw r0 r9 20      ; r0 = stderr
    78 81 8D FC   ; ldw r1 rfp -4     ; r1 = message

    ; call write_all()
    7C 8A 00 00    ; ims ra <write_all
    7C 8A 90 08    ; ims ra >write_all (0x890)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

;:error_no_message

    ; skip exit if stop_on_error is false
    78 80 8E 58   ; ldw r0 rpp 0x58    ; stop_on_error
    7E 80 04 00   ; jz r0 &error_no_exit (+4)

    ; tail-call exit(exit_code)
    78 80 8D F8    ; ldw r0 rfp -8
    7C 8A 00 00    ; ims ra <exit
    7C 8A 50 02    ; ims ra >exit (0x250)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

;:error_no_exit

    ; store exit_code in last_result
    78 80 8D F8     ; ldw r0 rfp -8    ; exit_code
    79 80 8E 6C     ; stw r0 rpp 0x6C  ; last_result

    ; done
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1090



;==========================================
; const char error_read_program[];
;==========================================

@0x1090 =error_read_program
    ; "ERROR: Failed to read program." '0A '00
    45 52 52 4f 52 3a 20 46  61 69 6c 65 64 20 74 6f
  ;  E  R  R  O  R  :     F   a  i  l  e  d     t  o
    20 72 65 61 64 20 70 72  6f 67 72 61 6d 2e 0a 00
  ;     r  e  a  d     p  r   o  g  r  a  m  . \n \0
@0x10B0



;==========================================
; int syscall_fclose(int handle);
;==========================================

@0x10B0 =syscall_fclose

    ; get syscall fclose into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 04 03   ; shl ra 4 3        ; ra = offset of fclose syscall (4<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fclose syscall

    ; tail-call the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall

    ; TODO probably should not tail-call and instead check the return value.
    ; An error from fclose() is fatal.

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x10E0



;==========================================
; int syscall_fseek(int file_handle, int base, unsigned offset_low, int offset_high);
;==========================================

@0x10E0 =syscall_fseek

    ; get syscall fseek into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 07 03   ; shl ra 7 3        ; ra = offset of fseek syscall (7<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fseek syscall

    ; tail-call the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1110



;==========================================
; int syscall_ftell(int file_handle, unsigned position[2]);
;==========================================

@0x1110 =syscall_ftell

    ; get syscall ftell into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 08 03   ; shl ra 8 3        ; ra = offset of ftell syscall (8<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of ftell syscall

    ; tail-call the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1140



;==========================================
; int get_program_size(int file_handle);
;==========================================
; Returns the program size, or 0 if there was an error.
;
; The maximum program size supported by this shell is 1 GB. If the given file
; is larger, this returns 0. (Such a large program is unlikely to work anyway
; but we check for 1 GB in this function because it makes the rest of the error
; handling simpler.)
;
; vars:
; - file_handle: rfp-4
; - position: rfp-12
;==========================================

@0x1140 =get_program_size

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp       ; enter
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; stash the file handle
    71 8C 8C 0C     ; sub rsp rsp 12
    79 80 8D FC     ; stw r0 rfp -4

    ; prepare arguments to fseek, seek to the end
    70 81 00 02     ; add r1 0 2   ; mov r1 2
    70 82 00 00     ; add r2 0 0   ; zero r2
    70 83 00 00     ; add r3 0 0   ; zero r3

    ; call syscall_fseek()
    7C 8A 00 00    ; ims ra <syscall_fseek
    7C 8A E0 10    ; ims ra >syscall_fseek (0x10E0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 8A 05 00    ; jz ra &get_program_size_fseek_end_ok (+5)

    ; error, return 0
    70 80 00 00     ; add r0 0 0        ; zero r0
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;:get_program_size_fseek_end_ok

    ; prepare arguments to ftell
    78 80 8D FC     ; ldw r0 rfp -4
    70 81 8D F4     ; add r1 rfp -12

    ; call syscall_ftell()
    7C 8A 00 00    ; ims ra <syscall_ftell
    7C 8A 10 11    ; ims ra >syscall_ftell (0x1110)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 8A 01 00    ; jz ra &get_program_size_ftell_call_ok (+1)
    7E 00 06 00    ; jz 0 &get_program_size_ftell_fail (+6)
;:get_program_size_ftell_call_ok
    ; upper word must be zero
    78 8A 8D F8    ; ldw r0 rfp -8
    7E 8A 01 00    ; jz ra &get_program_size_ftell_highword_ok (+1)
    7E 00 03 00    ; jz 0 &get_program_size_ftell_fail (+3)
;:get_program_size_ftell_highword_ok
    ; high two bits of lower word must be zero (max 1GB)
    78 8A 8D F4    ; ldw ra rfp -12
    77 8A 80 1E    ; shru ra r0 30
    7E 8A 05 00    ; jz ra &get_program_size_ftell_ok (+5)

;:get_program_size_ftell_fail
    ; error, return 0
    70 80 00 00     ; add r0 0 0        ; zero r0
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;:get_program_size_ftell_ok

    ; prepare arguments to fseek, seek to the start
    78 80 8D FC     ; ldw r0 rfp -4
    70 81 00 00     ; add r1 0 0   ; zero r1
    70 82 00 00     ; add r2 0 0   ; zero r2
    70 83 00 00     ; add r3 0 0   ; zero r3

    ; call syscall_fseek()
    7C 8A 00 00    ; ims ra <syscall_fseek
    7C 8A E0 10    ; ims ra >syscall_fseek (0x10E0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 8A 05 00    ; jz ra &get_program_size_fseek_end_ok (+5)

    ; error, return 0
    70 80 00 00     ; add r0 0 0        ; zero r0
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; success (or the size is zero), return lower word
    78 80 8D F4     ; ldw r0 rfp -12
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1290



;==========================================
; int read_all(int handle, char* buffer, size_t count);
;==========================================
; Reads exactly the given count of bytes from the given I/O handle into the
; given buffer.
;
; Returns zero if successful, or the syscall error code if it fails.
;
; vars
; - io_handle: rfp-4
; - buffer: rfp-8
; - remaining: rfp-12
; - loop address: rfp-16
;==========================================

@0x1290 =read_all

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; store args
    71 8C 8C 10     ; sub rsp rsp 16
    79 80 8D FC     ; stw r0 rfp -4
    79 81 8D F8     ; stw r1 rfp -8
    79 82 8D F4     ; stw r2 rfp -12

    ; store the address to loop
    79 8F 8D F0    ; stw rip rfp -16
;:read_all_loop

    ; get syscall fread into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 05 03   ; shl ra 5 3        ; ra = offset of fread syscall (5<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of fread syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; check the high bit for error
    ; TODO we should handle busy/wouldblock correctly (the VM spec will soon
    ; allow this even for ordinary files.) the error code for it doesn't exist
    ; yet.
    77 8A 80 1F   ; shru ra r0 31
    7E 8A 04 00   ; jz ra &read_all_no_error (+4)
    ; fail, return the error code
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;:read_all_no_error

    ; check if we got zero
    7E 80 01 00   ; jz r0 &read_all_zero (+1)
    7E 00 05 00   ; jz 0 &read_all_not_zero (+5)
;:read_all_zero
    ; zero bytes read.
    ; TODO a zero byte return won't be allowed soon. for now we interpret it as
    ; EOF. return generic error code because EOF error doesn't exist yet.
    70 80 00 FF     ; add r0 0 -1
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;:read_all_not_zero

    ; adjust pointer and bytes remaining
    78 81 8D F8   ; ldw r1 rfp -8
    78 82 8D F4   ; ldw r2 rfp -12
    70 81 81 80   ; add r1 r1 r0
    71 82 82 80   ; sub r2 r2 r0
    79 81 8D F8   ; stw r1 rfp -8
    79 82 8D F4   ; stw r2 rfp -12

    ; if bytes remaining is zero, we're done
    7E 82 02 00   ; jz r2 &read_all_loop_exit (+2)

    ; otherwise loop.
    78 80 8D FC   ; ldw r0 rfp -4     ; io_handle
    78 8F 8D F0   ; ldw rip rfp -16   ; jump to :read_all_loop

;:read_all_loop_exit

    ; done, return zero
    70 80 00 00     ; add r0 0 0        ; zero r0
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1360



;==========================================
; void command_onrampvm(void);
;==========================================
; Runs the `onrampvm` command.
;
; vars:
; - file_handle: rfp-4
; - error_handler: rfp-8
;==========================================

@0x1360 =command_onrampvm

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp       ; enter
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 08     ; sub rsp rsp 8

    ; store an invalid file handle
    79 FF 8D FC     ; stw -1 rfp -4

    ; call align_heap()
    7C 8A 00 00    ; ims ra <align_heap
    7C 8A D0 16    ; ims ra >align_heap (0x16D0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; We implement the error handler first and store its address. If we
    ; encounter an error, we'll "goto" the error handler by loading its address
    ; into rip (with an optional error message in r0.)

    ; store and skip the error handler
    70 8A 8F 08    ; add ra rip 8
    79 8A 8D F8    ; stw ra rfp -8   ; error_handler
    7E 00 17 00    ; jz 0 &command_onrampvm_start (+23)

;:command_onrampvm_error_handler

    ; r0 contains the error message. call error() with code 125 which is the
    ; code a POSIX VM should return on error.
    70 81 00 7D    ; add r1 0 125     ; VM error
    7C 8A 00 00    ; ims ra <error
    7C 8A C0 0F    ; ims ra >error (0xFC0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; check if the file is open
    78 80 8D FC     ; stw r0 rfp -4
    77 8A 80 1F     ; shru ra r0 31    ; high bit indicates error
    7E 8A 01 00     ; jz ra &command_onrampvm_close (+1)
    7E 00 07 00     ; jz ra &command_onrampvm_error_done (+7)

;:command_onrampvm_close
    ; close the file, call syscall_fclose()
    7C 8A 00 00    ; ims ra <syscall_fclose
    7C 8A B0 10    ; ims ra >syscall_fclose (0x10B0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

;:command_onrampvm_error_done
    ; done
    70 8C 8D 00    ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret

;:command_onrampvm_start


    ; we must have at least two args (including the command)
    78 81 8E 64   ; ldw r1 rpp 0x64    ; arg_count
    7D 8A 81 02   ; ltu ra r1 2
    7E 8A 04 00   ; jz ra &command_onrampvm_args_ok (+4)

    ; error
    7C 80 00 00    ; ims r0 <error_invalid_syntax
    7C 80 F0 0D    ; ims r0 >error_invalid_syntax (0xDF0)
    70 80 8E 80    ; add r0 rpp r0
    78 8F 8D F8    ; ldw rip rfp -8   ; error_handler
;:command_onrampvm_args_ok

    ; open the program
    ; TODO prepend working directory
    ; TODO move this (and prepend wd) to a function open_file(), share with
    ; open_script()

    ; prepare arguments to fopen
    78 80 8E 60    ; ldw r0 rpp 0x60    ; args
    78 80 80 04    ; ldw r0 r0 4        ; args[1] (program filename)
    70 81 00 00    ; add r1 0 0         ; read-only

    ; get syscall fopen into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 03 03   ; shl ra 3 3        ; ra = offset of fopen syscall (3<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fopen syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 8A 04 00    ; jz ra &command_onrampvm_fopen_ok (+4)

    ; failed to open program
    7C 80 00 00    ; ims r0 <error_read_program
    7C 80 90 10    ; ims r0 >error_read_program
    70 80 8E 80    ; add r0 rpp r0
    78 8F 8D F8    ; ldw rip rfp -8   ; goto error_handler
;:command_onrampvm_fopen_ok

    ; save the file handle
    79 80 8D FC     ; stw r0 rfp -4


    ; call get_program_size()
    7C 8A 00 00    ; ims ra <get_program_size
    7C 8A 40 11    ; ims ra >get_program_size (0x1140)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; zero size means error
    7E 80 01 00    ; jz r0 &command_onrampvm_size_zero (+1)
    7E 00 04 00    ; jz 0 &command_onrampvm_size_ok (+4)

;:command_onrampvm_size_zero
    ; failed to read program
    7C 80 00 00    ; ims r0 <error_read_program
    7C 80 90 10    ; ims r0 >error_read_program
    70 80 8E 80    ; add r0 rpp r0
    78 8F 8D F8    ; ldw rip rfp -8   ; goto error_handler
;:command_onrampvm_size_ok

    ; make sure we have enough space, including space for the initial stack
    ; TODO this should be 128 bytes, minimum needed for a stack, but we don't
    ; have alloc syscall yet. for now make sure we have an extra 128 kB.
    ; (this can't overflow because get_program_size() has limited the size)
    ; TODO when we change this to 128 bytes we have to also align the program end
    76 8A 01 11    ; shl ra 1 17   ; ra = 128 kB
    70 8B 80 8A    ; add rb r0 ra
    ; TODO We should malloc() if we don't have enough space. This also means we
    ; need to keep track of our malloc regions, search them for free space, and
    ; pass unused regions to the child program.
    78 81 8E 68   ; ldw r1 rpp 0x68    ; heap_ptr
    78 82 8E 44   ; ldw r2 rpp 0x44    ; heap_end
    71 82 82 81   ; sub r2 r2 r1
    7D 8A 82 8B   ; ltu ra r2 rb
    7E 8A 04 00   ; jz ra &command_onrampvm_heap_ok (+4)

    ; not enough space
    7C 80 00 00    ; ims r0 <error_out_of_memory
    7C 80 C0 01    ; ims r0 >error_out_of_memory
    70 80 8E 80    ; add r0 rpp r0
    78 8F 8D F8    ; ldw rip rfp -8   ; goto error_handler
;:command_onrampvm_heap_ok

    ; store the end of the program as the heap start address in the child pit
    70 8A 81 80    ; add ra r1 r0       ; ra = heap_ptr + size
    78 8B 8E 5C    ; ldw rb rpp 0x5C    ; child_pit
    79 8A 8B 04    ; stw ra rb 0x04     ; child_pit[HEAP_START] = ra

    ; store the command-line arguments in the child pit
    78 85 8E 60    ; ldw r5 rpp 0x60  ; args
    70 85 85 04    ; add r5 r5 4      ; skip `onrampvm`
    79 85 8B 18    ; stw r5 rb 0x18   ; child_pit[HEAP_START]

    ; read program into heap, call read_all()
    70 82 80 00    ; add r2 r0 0    ; mov r2 r0
    78 80 8D FC    ; ldw r0 rfp -4
    7C 8A 00 00    ; ims ra <read_all
    7C 8A 90 12    ; ims ra >read_all (0x1290)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; non-zero return value is error
    7E 80 04 00   ; jz r0 &command_onrampvm_read_all_ok (+4)

    ; failed to read program
    7C 80 00 00    ; ims r0 <error_read_program
    7C 80 90 10    ; ims r0 >error_read_program
    70 80 8E 80    ; add r0 rpp r0
    78 8F 8D F8    ; ldw rip rfp -8   ; goto error_handler
;:command_onrampvm_read_all_ok

    ; close the file, call syscall_fclose()
    78 80 8D FC    ; ldw r0 rfp -4
    7C 8A 00 00    ; ims ra <syscall_fclose
    7C 8A B0 10    ; ims ra >syscall_fclose (0x10B0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call skip_preamble()
    7C 8A 00 00    ; ims ra <skip_preamble
    7C 8A 40 16    ; ims ra >skip_preamble (0x1640)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; tail-call run_subprogram()
    70 8C 8D 00    ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^           ; ^^^
    7C 8A 00 00    ; ims ra <run_subprogram
    7C 8A 80 15    ; ims ra >run_subprogram (0x1580)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1580



;==========================================
; void run_subprogram(void);
;==========================================
; Runs the loaded subprogram for an `onrampvm` or `sh` command.
;
; The program must be loaded at heap_ptr and the end of the program must be
; stored as the start of the heap in the child pit.
;==========================================

@0x1580 =run_subprogram

    ; prepare args for syscall debug
    78 80 8E 68    ; ldw r0 rpp 0x68   ; heap_ptr
    78 8B 8E 5C    ; ldw rb rpp 0x5C   ; child_pit
    78 85 8B 18    ; ldw r5 rb 0x18    ; child_pit[ARGS]
    78 81 85 00    ; ldw r1 r5 0       ; child_pit[ARGS][0]

    ; call syscall_debug()
    7C 8A 00 00    ; ims ra <syscall_debug
    7C 8A C0 1A    ; ims ra >syscall_debug (0x1AC0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; Push a stack frame and store it. This will allow us to restore both rpp
    ; and rfp in child_syscall_exit().
    71 8C 8C 04    ; sub rsp rsp 4     ; push rfp       ; enter
    79 8D 00 8C    ; stw rfp 0 rsp     ; ...
    70 8D 8C 00    ; add rfp rsp 0     ; mov rfp rsp
    79 8D 8E 4C    ; stw rfp rpp 0x4C  ; frame_pointer

    ; null-terminate the argument list
    78 85 8E 60    ; ldw r5 rpp 0x60    ; args
    78 86 8E 64    ; ldw r6 rpp 0x64    ; arg_count
    76 86 86 02    ; shl r6 r6 2        ; r6 *= 4
    79 00 85 86    ; stw 0 r5 r6        ; args[arg_count] = 0

    ; TODO we should consider running ftell() on the source script and if it
    ; works, close it and reopen after running the command. we want bootstrap
    ; to work even if the VM only supports a very small number of simultaneous
    ; open files.

    ; set up initial registers of the child program
    78 80 8E 5C   ; ldw r0 rpp 0x5C     ; child_pit
    78 8C 8E 44   ; ldw rsp rpp 0x44    ; heap_end
    78 8E 8E 68   ; ldw rpp rpp 0x68    ; heap_ptr

    ; Jump to the child program. Note that we don't clean up our stack frame;
    ; it is restored and cleaned up in child_syscall_exit().
    70 8F 8E 00   ; add rip rpp 0

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1630



;==========================================
; void cleanup_subprogram(void)
;==========================================

@0x1630 =cleanup_subprogram

    ; TODO close any open files and dirs, free allocs. For now this is just a
    ; placeholder.

    78 8F 00 8C    ; ldw rip 0 rsp      ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1640



;==========================================
; void skip_preamble(void)
;==========================================
; Checks if the program loaded at heap_ptr starts with #! or REM, and if so,
; skips the first 128 bytes.
;
; (We haven't actually checked that the program is at least 128 bytes, but we
; have ensured we have at least 128 kB of extra space for a stack. TODO revisit
; this once we alloc space for the program.)
;==========================================

@0x1640 =skip_preamble

    ; get the start of the program
    78 89 8E 68   ; ldw r9 rpp 0x68    ; heap_ptr

    ; check if it starts with REM
    7A 80 89 00   ; ldb r0 r9 0
    7A 81 89 01   ; ldb r1 r9 1
    7A 82 89 02   ; ldb r2 r9 2
    71 80 80 52   ; sub r0 r0 "R"
    71 81 81 45   ; sub r1 r1 "E"
    71 82 82 4D   ; sub r2 r2 "M"
    75 80 80 81   ; or r0 r0 r1
    75 80 80 82   ; or r0 r0 r2
    7E 80 06 00   ; jz r0 &skip_preamble_found (+6)

    ; check if it starts with #!
    7A 80 89 00   ; ldb r0 r9 0
    7A 81 89 01   ; ldb r1 r9 1
    71 80 80 23   ; sub r0 r0 "#"
    71 81 81 21   ; sub r1 r1 "!"
    75 80 80 81   ; or r0 r0 r1
    7E 80 01 00   ; jz r0 &skip_preamble_found (+1)

    ; no preamble. return
    78 8F 00 8C    ; ldw rip 0 rsp      ; ret

;:skip_preamble_found

    ; increment heap_ptr by 128 bytes
    76 85 01 07   ; shl r5 1 7        ; 1 << 7 == 128
    70 89 89 85   ; add r9 r9 r5
    79 89 8E 68   ; stw r9 rpp 0x68    ; heap_ptr

    ; done
    78 8F 00 8C   ; ldw rip 0 rsp      ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x16D0



;==========================================
; void align_heap(void)
;==========================================
; Aligns heap_ptr, ensuring it does not overflow.
;
; This is called after parsing arguments for those commands that need an
; aligned heap. (For some commands we can't align it, e.g. echo uses heap_ptr
; as the end of the string.)
;==========================================

@0x16D0 =align_heap

    ; align heap_ptr
    78 80 8E 68     ; ldw r0 rpp 0x68    ; heap_ptr
    70 80 80 03     ; add r0 r0 3
    74 80 80 FC     ; and r0 r0 -4
    79 80 8E 68     ; stw r0 rpp 0x68    ; heap_ptr

    ; make sure alignment doesn't overflow the heap
    78 81 8E 44     ; ldw r1 rpp 0x44    ; heap_end
    7D 8A 81 80     ; ltu ra r1 2
    7E 8A 06 00     ; jz ra &parse_line_not_oom (+6)

    ; not enough memory
    7C 80 00 00    ; ims r0 <error_out_of_memory
    7C 80 10 01    ; ims r0 >error_out_of_memory
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 00 08    ; ims ra >fatal (0x800)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:parse_line_not_oom

    ; done
    78 8F 00 8C   ; ldw rip 0 rsp      ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1740



;==========================================
; int syscall_mkdir(const char* path);
;==========================================

@0x1740 =syscall_mkdir

    ; get syscall mkdir into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 12 03   ; shl ra 18 3       ; ra = offset of mkdir syscall (18<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of mkdir syscall

    ; tail-call the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1770



;==========================================
; void command_mkdir(void)
;==========================================
; Runs the `mkdir` command.
;
; The argument `-p` is required and a single path must follow.
;
; We repeatedly run the `mkdir` syscall on every component in the path,
; temporarily replacing each `/` by a null-terminator to truncate the path at
; each step.
;
; vars:
; - path_start: r0, rfp-4
; - path_pos:   r1, rfp-8
; - loop address: rfp-12
;==========================================

@0x1770 =command_mkdir

    ; we need exactly two args plus mkdir itself
    78 81 8E 64   ; ldw r1 rpp 0x64    ; arg_count
    71 8A 81 03   ; sub ra r1 3
    7E 8A 01 00   ; jz ra &command_mkdir_good_arg_count (+1)
    7E 00 0A 00   ; jz ra &command_mkdir_bad_args (+10)
;:command_mkdir_good_arg_count

    ; load the first arg
    78 80 8E 60    ; ldw r0 rpp 0x60    ; args
    78 82 80 04    ; ldw r2 r0 4        ; args[1]

    ; make sure the arg is "-p"
    7A 8A 82 00    ; ldb ra r2 0
    71 8A 8A 2D    ; sub ra ra "-"
    7A 8B 82 01    ; ldb rb r2 1
    71 8B 8B 70    ; sub rb rb "p"
    75 8A 8A 8B    ; or ra ra rb
    7A 8B 82 02    ; ldb rb r2 2    ; null-terminator
    75 8A 8A 8B    ; or ra ra rb
    7E 8A 07 00    ; jz ra &command_mkdir_args_ok (+7)

;:command_mkdir_bad_args
    ; invalid syntax, tail-call error()
    7C 80 00 00    ; ims r0 <error_invalid_syntax
    7C 80 F0 0D    ; ims r0 >error_invalid_syntax (0xDF0)
    70 80 8E 80    ; add r0 rpp r0
    70 81 00 01    ; add r1 0 1      ; mov r1 1
    7C 8A 00 00    ; ims ra <error
    7C 8A C0 0F    ; ims ra >error (0xFC0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

;:command_mkdir_args_ok

    ; create a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp       ; enter
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 0C     ; sub rsp rsp 12

    ; the second arg is the start of our path
    78 80 8E 60    ; ldw r0 rpp 0x60    ; args
    78 80 80 08    ; ldw r0 r0 8        ; args[2]
    79 80 8D FC    ; stw r0 rfp -4      ; path_start

    ; TODO we need to prepend the working directory and normalize the path to
    ; eliminate any `..`. We basically need a realpath() function copied
    ; between this, ld/0, hex/0 and libc/0 (libc/2 has its own realpath().) For
    ; now we just use the given path as-is and in-place. VMs will be required
    ; to support relative paths until we fix this.

    ; path_pos begins at the start of the path
    70 81 80 00    ; add r1 r0 0    ; mov r1 r0

    ; store the address to loop
    79 8F 8D F4    ; stw rip rfp -12
;:command_mkdir_loop

    ; increment the position. (the argument is guaranteed to not be blank.)
    70 81 81 01    ; add r1 r1 1

    ; check if we have a path divider or null-terminator
    7A 82 81 00    ; ldb r2 r1 0
    7E 82 03 00    ; jz r2 &command_mkdir_null_terminator_found (+3)
    71 83 82 2F    ; sub r2 r2 "/"
    7E 83 0D 00    ; jz r2 &command_mkdir_path_divider_found (+13)

    ; neither. loop
    78 8F 8D F4    ; ldw rip rfp -12   ; jump to :command_mkdir_loop

;:command_mkdir_null_terminator_found

    ; call syscall_mkdir() on the full path
    7C 8A 00 00    ; ims ra <syscall_mkdir
    7C 8A 40 17    ; ims ra >syscall_mkdir (0x1740)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; TODO check for errors. path is allowed to exist so for now we ignore
    ; errors. for all other errors we should call error() and return.

    ; clear last_result
    79 00 8E 6C    ; stw 0 rpp 0x6C   ; last_result

    ; done
    70 8C 8D 00    ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret

;:command_mkdir_path_divider_found

    ; stash this location
    79 81 8D F8    ; stw r1 rfp -8   ; path_pos

    ; replace the path divider with a null-terminator
    7B 00 81 00    ; stb 0 r1 0

    ; call syscall_mkdir() on this portion of the path
    7C 8A 00 00    ; ims ra <syscall_mkdir
    7C 8A 40 17    ; ims ra >syscall_mkdir (0x1740)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; TODO check for errors again.

    ; restore our registers
    78 80 8D FC    ; ldw r0 rfp -4   ; path_start
    78 81 8D F8    ; ldw r1 rfp -8   ; path_pos

    ; restore the slash
    7B 2F 81 00    ; stb "/" r1 0

    ; loop
    78 8F 8D F4    ; ldw rip rfp -12   ; jump to :command_mkdir_loop

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x18A0



;==========================================
; void init_child_syscalls(void);
;==========================================
; Builds the child syscall table.
;
; We copy our own table first, then replace some of them with our proxy
; functions.
;
; vars:
; - parent pit: r0
; - child pit: r1
; - parent syscall table: r2
; - child syscall table: r3
;==========================================

@0x18A0 =init_child_syscalls

    ; get both process info tables
    78 80 8E 20   ; ldw r0 rpp 0x20       ; process_info_table
    78 81 8E 5C   ; ldw r1 rpp 0x5C       ; child_pit

    ; get both syscall tables
    78 82 80 08   ; ldw r2 r0 0x08   ; r2 = parent syscall table
    78 83 81 08   ; ldw r3 r1 0x08   ; r3 = child syscall table

    ; copy the syscall table
    78 84 81 28   ; ldw r4 r1 0x28   ; r4 = system call count
    76 84 84 03   ; shl r4 r4 3      ; r4 = system call table size (in bytes)
    70 85 00 00   ; add r5 0 0       ; zero r5
;:initialize_syscalls_loop
    78 8A 82 85   ; ldw ra r2 r5     ; copy syscall rip
    79 8A 83 85   ; ldw ra r3 r5
    70 85 85 04   ; add r5 r5 4
    78 8A 82 85   ; ldw ra r2 r5     ; copy syscall rpp
    79 8A 83 85   ; ldw ra r3 r5
    70 85 85 04   ; add r5 r5 4
    71 8A 84 85   ; sub ra r4 r5
    7E 8A 01 00   ; jz ra &initialize_syscalls_done (+1)
    7E 00 F7 FF   ; jz 0 &initialize_syscalls_loop (-9)
;:initialize_syscalls_done

    ; proxy the exit syscall
    7C 8A 00 00    ; ims ra <child_syscall_exit
    7C 8A 00 1B    ; ims ra >child_syscall_exit (0x1B00)
    70 8A 8E 8A    ; add ra rpp ra
    79 8A 83 00    ; stw ra r3 0
    79 8E 83 04    ; stw rpp r3 4

    ; TODO we'll need to proxy more syscalls, especially fopen/fclose,
    ; dopen/dclose and alloc/free to prevent leaks

    ; done
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; padding for syscalls we'll soon add
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x19B0



;==========================================
; void command_sh(void)
;==========================================
; Runs the `sh` command.
;
; The command must have a single argument which is the script to run.
;==========================================

@0x19B0 =command_sh

    ; we must have exactly 2 args (including the command)
    78 81 8E 64   ; ldw r1 rpp 0x64    ; arg_count
    71 8A 81 02   ; sub ra r1 2
    7E 8A 07 00   ; jz ra &command_sh_args_ok (+7)

    ; not enough args, tail-call error()
    7C 80 00 00    ; ims r0 <error_invalid_syntax
    7C 80 F0 0D    ; ims r0 >error_invalid_syntax (0xDF0)
    70 80 8E 80    ; add r0 rpp r0
    70 81 00 01    ; add r1 0 1      ; mov r1 1
    7C 8A 00 00    ; ims ra <error
    7C 8A C0 0F    ; ims ra >error (0xFC0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:command_sh_args_ok

    ; call align_heap()
    7C 8A 00 00    ; ims ra <align_heap
    7C 8A D0 16    ; ims ra >align_heap (0x16D0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the size of the program
    7C 80 00 00    ; ims r0 <end_of_program
    7C 80 40 20    ; ims r0 >end_of_program (0x2040)

    ; make sure we have enough space, including space for the initial stack
    ; TODO as with command_onrampvm, this is 128 kB. when we add allocation we
    ; can allocate the stack separately and move this check into
    ; run_subprogram().
    76 8A 01 11   ; shl ra 1 17   ; ra = 128 kB
    70 8B 80 8A   ; add rb r0 ra
    78 81 8E 68   ; ldw r1 rpp 0x68    ; heap_ptr
    78 82 8E 44   ; ldw r2 rpp 0x44    ; heap_end
    71 82 82 81   ; sub r2 r2 r1
    7D 8A 82 8B   ; ltu ra r2 rb
    7E 8A 07 00   ; jz ra &command_sh_heap_ok (+7)

    ; not enough space, tail-call error()
    7C 80 00 00    ; ims r0 <error_out_of_memory
    7C 80 C0 01    ; ims r0 >error_out_of_memory
    70 80 8E 80    ; add r0 rpp r0
    70 81 00 01    ; add r1 0 1      ; mov r1 1
    7C 8A 00 00    ; ims ra <error
    7C 8A C0 0F    ; ims ra >error (0xFC0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:command_sh_heap_ok

    ; copy our program to the heap
    70 83 00 00    ; add r3 0 0   ; zero r3   ; iterator
;:command_sh_copy_loop
    78 8A 8E 83    ; ldw ra rpp r3
    79 8A 81 83    ; stw ra r1 r3
    70 83 83 04    ; add r3 r3 4
    71 8A 83 80    ; sub ra r3 r0
    7E 8A 01 00    ; jz ra &command_sh_copy_done (+1)
    7E 00 FA FF    ; jz 0 &command_sh_copy_loop (-6)
;:command_sh_copy_done

    ; Replace the first arg ('sh') with our program name. This is used to load
    ; debug info. The subshell must also know its program name so it can load
    ; debug info for its own subshells.
    78 85 8E 60    ; ldw r5 rpp 0x60  ; args
    78 88 8E 20    ; ldw r8 rpp 0x20  ; process_info_table
    78 87 88 18    ; ldw r7 r8 24     ; process_info_table[ARGV]
    78 86 87 00    ; ldw r6 r7 0      ; get argv[0]
    79 86 85 00    ; stw r6 r5 0      ; store as child args[0]

    ; store the end of the program as the heap start address in the child pit
    70 8A 81 80    ; add ra r1 r0       ; ra = heap_ptr + size
    78 8B 8E 5C    ; ldw rb rpp 0x5C    ; child_pit
    79 8A 8B 04    ; stw ra rb 0x04     ; child_pit[HEAP_START] = ra

    ; store the command-line arguments in the child pit
    79 85 8B 18    ; stw r5 rb 0x18   ; child_pit[ARGS]

    ; tail-call run_subprogram()
    7C 8A 00 00    ; ims ra <run_subprogram
    7C 8A 80 15    ; ims ra >run_subprogram (0x1580)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1AC0



;==========================================
; int syscall_debug();
;==========================================

@0x1AC0 =syscall_debug

    ; get syscall debug into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 16 03   ; shl ra 22 3       ; ra = offset of debug syscall (22<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of debug syscall

    ; skip the syscall if unimplemented
    78 86 87 00   ; ldw r6 r7 0     ; rip of syscall
    7E 86 02 00   ; jz r6 &syscall_debug_skip (+2)

    ; tail-call the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    70 8F 86 00    ; add rip r6 0     ; rip = rip of syscall

;:syscall_debug_skip
    ; otherwise return
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1B00



;==========================================
; int child_syscall_exit(int return_code);
;==========================================
; Called by subprograms as their `exit` syscall, returning control to the
; shell.
;==========================================

@0x1B00 =child_syscall_exit

    ; our rpp is in r9
    70 8E 89 00    ; add rpp r9 0   ; mov rpp r9

    ; Pop the stored frame pointer. This destroys the stack frame of
    ; run_subprogram().
    78 8C 8E 4C    ; ldw rsp rpp 0x4C   ; frame_pointer
    78 8D 00 8C    ; ldw rfp 0 rsp      ; pop rfp
    70 8C 8C 04    ; add rsp rsp 4      ; ^^^

    ; push the return code
    71 8C 8C 04     ; sub rsp rsp 4     ; push r0
    79 80 00 8C     ; stw r0 0 rsp      ; ...

    ; Unload debug info, call syscall_debug()
    78 80 8E 68    ; ldw r0 rpp 0x68   ; heap_ptr
    70 81 00 00    ; add r1 0 0
    7C 8A 00 00    ; ims ra <syscall_debug
    7C 8A C0 1A    ; ims ra >syscall_debug (0x1AC0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; pop the return code
    78 80 00 8C     ; ldw r0 0 rsp      ; pop r0
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^

    ; If the return code is non-zero, call error() with a null message. (We
    ; expect that the failing program printed its own error message.)
    7E 80 09 00    ; jz r0 &child_syscall_exit_ok (+9)
    70 81 80 00    ; add r1 r0 0    ; mov r1 r0
    70 80 00 00    ; add r0 0 0     ; zero r0
    7C 8A 00 00    ; ims ra <error
    7C 8A C0 0F    ; ims ra >error (0xFC0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address
;:child_syscall_exit_ok

    ; call cleanup_subprogram()
    7C 8A 00 00    ; ims ra <cleanup_subprogram
    7C 8A 30 16    ; ims ra >cleanup_subprogram (0x1630)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; Return. This ultimately returns control to handle_line() after its call
    ; to run_command().
    78 8F 00 8C    ; ldw rip 0 rsp      ; ret

    ; padding
    00 00 00 00
@0x1B90



;==========================================
; int syscall_fopen(const char* path, bool writeable);
;==========================================

@0x1B90 =syscall_fopen

    ; get syscall fopen into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 03 03   ; shl ra 3 3        ; ra = offset of fopen syscall (3<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fopen syscall

    ; tail-call the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1BC0



;==========================================
; const char error_source_file[];
;==========================================

@0x1BC0 =error_source_file
    ; "ERROR: Failed to read source file." '0A '00
    45 52 52 4f 52 3a 20 46  61 69 6c 65 64 20 74 6f
  ;  E  R  R  O  R  :     F   a  i  l  e  d     t  o
    20 72 65 61 64 20 73 6f  75 72 63 65 20 66 69 6c
  ;     r  e  a  d     s  o   u  r  c  e     f  i  l
    65 2e 0a 00 00 00 00 00  00 00 00 00 00 00 00 00
  ;  e  . \n \0
@0x1BF0



;==========================================
; const char error_destination_file[];
;==========================================

@0x1BF0 =error_destination_file
    ; "ERROR: Failed to write destination file." '0A '00
    45 52 52 4f 52 3a 20 46  61 69 6c 65 64 20 74 6f
  ;  E  R  R  O  R  :     F   a  i  l  e  d     t  o
    20 77 72 69 74 65 20 64  65 73 74 69 6e 61 74 69
  ;     w  r  i  t  e     d   e  s  t  i  n  a  t  i
    6f 6e 20 66 69 6c 65 2e  0a 00 00 00 00 00 00 00
  ;  o  n     f  i  l  e  .  \n \0
@0x1C20



;==========================================
; int syscall_fread(const char* path, bool writeable);
;==========================================

@0x1C20 =syscall_fread

    ; get syscall fread into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 05 03   ; shl ra 5 3        ; ra = offset of fread syscall (5<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fread syscall

    ; tail-call the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1C50



;==========================================
; int syscall_fwrite(const char* path, bool writeable);
;==========================================

@0x1C50 =syscall_fwrite

    ; get syscall fwrite into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 06 03   ; shl ra 6 3        ; ra = offset of fwrite syscall (6<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fwrite syscall

    ; tail-call the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1C80



;==========================================
; void command_cp(void)
;==========================================
; Runs the `cp` command.
;
; The command takes two arguments: the source file and the destination file.
;
; (Multiple source files are not supported, and directory destinations are not
; supported; the destination filename must be spelled out in full.)
;
; This opens the source file and then forwards control to
; command_cp_open_dest() to more easily close the source file regardless of any
; errors.
;
; vars:
; - source_handle: rfp-4
;==========================================

@0x1C80 =command_cp

    ; we must have exactly 3 args (including the command)
    78 81 8E 64   ; ldw r1 rpp 0x64    ; arg_count
    71 8A 81 03   ; sub ra r1 3
    7E 8A 07 00   ; jz ra &command_cp_args_ok (+7)

    ; not enough args, tail-call error()
    7C 80 00 00    ; ims r0 <error_invalid_syntax
    7C 80 F0 0D    ; ims r0 >error_invalid_syntax (0xDF0)
    70 80 8E 80    ; add r0 rpp r0
    70 81 00 01    ; add r1 0 1      ; mov r1 1
    7C 8A 00 00    ; ims ra <error
    7C 8A C0 0F    ; ims ra >error (0xFC0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:command_cp_args_ok

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp       ; enter
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 04     ; sub rsp rsp 4

    ; call align_heap()
    7C 8A 00 00    ; ims ra <align_heap
    7C 8A D0 16    ; ims ra >align_heap (0x16D0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; TODO we need to prepend the working directory onto these paths.

    ; prepare args to open source file
    78 80 8E 60    ; ldw r0 rpp 0x60    ; args
    78 80 80 04    ; ldw r0 r0 4        ; args[1]
    70 81 00 00    ; add r1 0 0         ; read-only

    ; call syscall_fopen()
    7C 8A 00 00    ; ims ra <syscall_fopen
    7C 8A 90 1B    ; ims ra >syscall_fopen (0x1B90)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 8A 0A 00    ; jz ra &command_cp_fopen_ok (+10)

    ; failed to open source file. tail-call error()
    70 8C 8D 00    ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^           ; ^^^
    7C 80 00 00    ; ims r0 <error_source_file
    7C 80 C0 1B    ; ims r0 >error_source_file (0x1BC0)
    70 80 8E 80    ; add r0 rpp r0
    70 81 00 01    ; add r1 0 1      ; mov r1 1
    7C 8A 00 00    ; ims ra <error
    7C 8A C0 0F    ; ims ra >error (0xFC0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:command_cp_fopen_ok

    ; save the source file
    79 80 8D FC     ; stw r0 rfp -4

    ; call command_cp_open_dest()
    7C 8A 00 00    ; ims ra <command_cp_open_dest
    7C 8A C0 1D    ; ims ra >command_cp_open_dest (0x1DC0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; restore the source file
    78 80 8D FC    ; ldw r0 rfp -4   ; source_file

    ; call syscall_fclose()
    7C 8A 00 00    ; ims ra <syscall_fclose
    7C 8A B0 10    ; ims ra >syscall_fclose (0x10B0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; done
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1DC0



;==========================================
; void command_cp_open_dest(int source_handle)
;==========================================
; Runs the `cp` command with the given source file.
;
; This opens the destination file and then forwards control to
; command_cp_copy_data() to more easily close the destination file regardless
; of any errors.
;
; vars:
; - source_handle: rfp-4
; - destination_handle: rfp-8
;==========================================

@0x1DC0 =command_cp_open_dest

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp       ; enter
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 08     ; sub rsp rsp 8

    ; save the source file
    79 80 8D FC     ; stw r0 rfp -4

    ; prepare args to open destination file
    78 80 8E 60    ; ldw r0 rpp 0x60    ; args
    78 80 80 08    ; ldw r0 r0 8        ; args[2]
    70 81 01 00    ; add r1 1 0         ; writeable

    ; call syscall_fopen()
    7C 8A 00 00    ; ims ra <syscall_fopen
    7C 8A 90 1B    ; ims ra >syscall_fopen (0x1B90)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 8A 0A 00    ; jz ra &command_cp_open_dest_fopen_fail (+10)

    ; failed to open destination file. tail-call error()
    70 8C 8D 00    ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^           ; ^^^
    7C 80 00 00    ; ims r0 <error_destination_file
    7C 80 F0 1B    ; ims r0 >error_destination_file (0x1BF0)
    70 80 8E 80    ; add r0 rpp r0
    70 81 00 01    ; add r1 0 1      ; mov r1 1
    7C 8A 00 00    ; ims ra <error
    7C 8A C0 0F    ; ims ra >error (0xFC0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:command_cp_open_dest_fopen_fail

    ; save the destination file
    79 80 8D F8    ; stw r0 rfp -8

    ; prepare args for copy
    78 80 8D FC    ; ldw r0 rfp -4   ; source_file
    78 81 8D F8    ; ldw r1 rfp -8   ; destination_file

    ; call command_cp_copy_data()
    7C 8A 00 00    ; ims ra <command_cp_copy_data
    7C 8A D0 1E    ; ims ra >command_cp_copy_data (0x1ED0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; restore the destination file
    78 80 8D F8    ; ldw r0 rfp -8   ; source_file

    ; call syscall_fclose()
    7C 8A 00 00    ; ims ra <syscall_fclose
    7C 8A B0 10    ; ims ra >syscall_fclose (0x10B0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; done
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1ED0



;==========================================
; void command_cp_copy_data(int source_handle, int destination_handle)
;==========================================
; Runs the `cp` command, copying data from the source to destination.
;
; The files have been opened already; this just does the data copying.
;
; vars:
; - source_handle: rfp-4
; - destination_handle: rfp-8
; - buffer_size: rfp-12
; - step_size: rfp-16
; - loop address: rfp-20
;==========================================

@0x1ED0 =command_cp_copy_data

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp       ; enter
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 14     ; sub rsp rsp 20

    ; save the file handles
    79 80 8D FC    ; stw r0 rfp -4
    79 81 8D F8    ; stw r1 rfp -8

    ; calculate available space
    78 81 8E 68   ; ldw r1 rpp 0x68    ; heap_ptr
    78 82 8E 44   ; ldw r2 rpp 0x44    ; heap_end
    71 82 82 81   ; sub r2 r2 r1

    ; TODO we need to check if we have enough space, and if we don't we should
    ; allocate a 4KB or 32KB buffer. For now we just assume it's plenty.

    ; Limit buffer size to 1 MiB. (If we're given a large amount of memory but
    ; it is allocated lazily, we don't want to commit it all unnecessarily.)
    76 8A 01 0A   ; shl ra 1 10        ; 1<<10 == 1048576
    7D 8B 8A 82   ; ltu rb ra r2
    7E 8B 01 00   ; jz rb &command_cp_copy_data_size_ok
    70 82 8A 00   ; add r2 ra 0     ; mov r2 ra
;:command_cp_copy_data_size_ok

    ; save buffer size
    79 82 8D F4    ; stw r2 rfp -12

    ; store the address to loop
    79 8F 8D EC    ; stw rip rfp -20
;:command_cp_copy_data_loop

    ; prepare args for fread
    78 80 8D FC   ; ldw r0 rfp -4      ; source_handle
    78 81 8E 68   ; ldw r1 rpp 0x68    ; heap_ptr
    78 82 8D F4   ; ldw r2 rfp -12     ; buffer_size

    ; call syscall_fread()
    7C 8A 00 00    ; ims ra <syscall_fread
    7C 8A 20 1C    ; ims ra >syscall_fread (0x1C20)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; TODO handle EWOULDBLOCK, EOF

    ; check for a zero return value
    7E 80 01 00   ; jz r2 &command_cp_copy_data_read_zero (+1)
    7E 00 04 00   ; jz 0 &command_cp_copy_data_read_nonzero (+4)

;:command_cp_copy_data_read_zero
    ; zero return is interpreted as EOF, we're done
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;:command_cp_copy_data_read_nonzero

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 8A 0A 00    ; jz ra &command_cp_copy_data_read_ok (+10)

    ; failed to read from source file. tail-call error()
    70 8C 8D 00    ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^           ; ^^^
    7C 80 00 00    ; ims r0 <error_source_file
    7C 80 C0 1B    ; ims r0 >error_source_file (0x1BC0)
    70 80 8E 80    ; add r0 rpp r0
    70 81 00 01    ; add r1 0 1      ; mov r1 1
    7C 8A 00 00    ; ims ra <error
    7C 8A C0 0F    ; ims ra >error (0xFC0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:command_cp_copy_data_read_ok

    ; we've read a non-zero number of bytes. prepare args for write_all()
    70 82 80 00   ; add r2 r0 0    ; mov r2 r0   ; byte count
    78 80 8D F8   ; ldw r0 rfp -8                ; destination_handle
    78 81 8E 68   ; ldw r1 rpp 0x68              ; heap_ptr

    ; call write_all()
    7C 8A 00 00    ; ims ra <write_all
    7C 8A 90 08    ; ims ra >write_all (0x890)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; non-zero return is error
    7E 80 0A 00    ; jz r0 &command_cp_copy_data_write_ok (+10)

    ; failed to write to destination file. tail-call error()
    70 8C 8D 00    ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^           ; ^^^
    7C 80 00 00    ; ims r0 <error_destination_file
    7C 80 F0 1B    ; ims r0 >error_destination_file (0x1BF0)
    70 80 8E 80    ; add r0 rpp r0
    70 81 00 01    ; add r1 0 1      ; mov r1 1
    7C 8A 00 00    ; ims ra <error
    7C 8A C0 0F    ; ims ra >error (0xFC0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:command_cp_copy_data_write_ok

    ; loop.
    78 8F 8D EC   ; ldw rip rfp -20   ; jump to :command_cp_copy_data_loop
;:command_cp_copy_data_done

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x2040



;==========================================
; void* end_of_program;
;==========================================
; This symbol marks the last address in the shell program. The shell runs a
; subshell by copying its own program up to this symbol.
;==========================================

@0x2040 =end_of_program
