; This is the implementation of the Onramp hex tool in hexadecimal Onramp
; bytecode.
;
; All error checks are implemented including address assertions and trailing
; backslashes. It passes all tests. It gives reasonable error messages but
; without line numbers.
;
; File I/O is buffered for efficiency.
;
; Global variables start at 0x20 and end at 0x50, except for the input and
; output buffers which are at 0xD00 and 0xE00. This allows most globals to be
; accessed with mix-type bytes.
;
; The I/O buffers are allocated statically because eventually we will allow VMs
; to provide a memory allocation syscall instead of an initial heap. We don't
; want to bother making a syscall to allocate our buffers.



; symbol table:
;  addr  name
;     0  __start
;    20  process_info_table
;    24  input_io_handle
;    28  output_io_handle
;    2C  current_char
;    30  byte_count
;    34  input_buffer_pos
;    38  input_buffer_end
;    3C  output_buffer_pos
;    50  error_invalid_arguments
;    90  error_input_file
;    C0  error_output_file
;    F0  error_invalid_character
;   110  strlen
;   130  fatal
;   1D0  start
;   270  initialize
;   2C0  arg_is_dash_o
;   320  parse_args
;   410  open_files
;   4B0  parse_character
;   580  try_parse_whitespace
;   5E0  emit_byte
;   650  hex_value
;   6E0  try_parse_hex
;   800  try_parse_comment
;   840  consume_comment
;   8D0  error_backslash_eol
;   900  error_address_assertion
;   930  try_parse_address
;   B40  error_truncated_hex_byte
;   B70  exit
;   BA0  write_all
;   D00  input_buffer
;   E00  output_buffer
;   F00  open_input_file
;   F90  open_output_file
;  1060  read_char
;  11A0  flush
;  1230  end_parsing



;==========================================
; [[noreturn]] void __start(uint32_t* process_info_table);
;==========================================
; The entry point. This must come first.
;
; We forward control over to start().
;==========================================

@0x00 =__start
    ; format indicator "~Onr~amp~   "
    7E 4F 6E 72   ; jz 79 29294
    7E 61 6D 70   ; jz 97 28781
    7E 20 20 20   ; jz 32 8224

    ; jump to start
    7C 8A 00 00   ; ims ra <start
    7C 8A D0 01   ; ims ra >start (0x1D0)
    70 8F 8E 8A   ; add rip rpp ra        ; jump

    ; padding
    00 00 00 00 00 00 00 00
@0x20



;==========================================
; uint32_t* process_info_table;
;==========================================

@0x20 =process_info_table
    00 00 00 00
@0x24



;==========================================
; int input_io_handle;
;==========================================

@0x24 =input_io_handle
    00 00 00 00
@0x28



;==========================================
; int output_io_handle;
;==========================================

@0x28 =output_io_handle
    00 00 00 00
@0x2C



;==========================================
; char current_char;
;==========================================
; The current character being parsed, pulled from the input buffer.
;
; This is an int because it has value -1 when end-of-file is reached.
;==========================================

@0x2C =current_char
    00 00 00 00
@0x30



;==========================================
; size_t byte_count;
;==========================================
; The current address, used for verifying address assertions.
;==========================================

@0x30 =byte_count
    00 00 00 00
@0x34



;==========================================
; char* input_buffer_pos;
;==========================================
; The position of the next byte to be read from the input buffer.
;
; This is a pointer into input_buffer. If this matches input_buffer_end, the
; buffer is empty.
;==========================================

@0x34 =input_buffer_pos
    00 00 00 00
@0x38



;==========================================
; char* input_buffer_end;
;==========================================
; The end of valid data in the input buffer.
;
; This is a pointer into input_buffer (or one past the last byte in
; input_buffer if the buffer was filled.)
;==========================================

@0x38 =input_buffer_end
    00 00 00 00
@0x3C



;==========================================
; char* output_buffer_pos;
;==========================================
; The position of the next byte to be written to the output buffer.
;
; This is a pointer into output_buffer. If this is pointing to the start of
; output_buffer, the buffer is empty.
;==========================================

@0x3C =output_buffer_pos
    00 00 00 00
@0x40



    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00



; ==========================================================
; const char error_invalid_arguments[];
; ==========================================================

@0x50 =error_invalid_arguments
    ; "ERROR: Incorrect arguments." '0A
    ; "Usage: <hex> [input] -o [output]" '0A '00
    45 52 52 4f 52 3a 20 49  6e 63 6f 72 72 65 63 74
  ;  E  R  R  O  R  :     I   n  c  o  r  r  e  c  t
    20 61 72 67 75 6d 65 6e  74 73 2e 0a 55 73 61 67
  ;     a  r  g  u  m  e  n   t  s  . \n  U  s  a  g
    65 3a 20 3c 68 65 78 3e  20 5b 69 6e 70 75 74 5d
  ;  e  :     <  h  e  x  >      [  i  n  p  u  t  ]
    20 2d 6f 20 5b 6f 75 74 70  75 74 5d 0a 00 00 00
  ;     -  o     [  o  u  t  p   u  t  ] \n \0
@0x90



;==========================================
; const char error_input_file[];
;==========================================

@0x90 =error_input_file
    ; "ERROR: Failed to read input file." '0A '00
    45 52 52 4f 52 3a 20 46  61 69 6c 65 64 20 74 6f
  ;  E  R  R  O  R  :     F  a  i  l  e  d     t  o
    20 72 65 61 64 20 69 6e  70 75 74 20 66 69 6c 65
  ;     r  e  a  d     i  n  p  u  t     f  i  l  e
    2e 0a 00 00 00 00 00 00  00 00 00 00 00 00 00 00
  ;  . \n \0
@0xC0



;==========================================
; const char error_output_file[];
;==========================================

@0xC0 =error_output_file
    ; "ERROR: Failed to write output file." '0A '00
    45 52 52 4f 52 3a 20 46  61 69 6c 65 64 20 74 6f
  ;  E  R  R  O  R  :     F   a  i  l  e  d     t  o
    20 77 72 69 74 65 20 6f  75 74 70 75 74 20 66 69
  ;     w  r  i  t  e     o   u  t  p  u  t     f  i
    6c 65 2e 0a 00 00 00 00  00 00 00 00 00 00 00 00
  ;  l  e  . \n \0
@0xF0



;==========================================
; const char error_invalid_character[];
;==========================================

@0xF0 error_invalid_character
    ; "ERROR: Invalid character." '0A '00
    45 52 52 4f 52 3a 20 49  6e 76 61 6c 69 64 20 63
  ;  E  R  R  O  R  :     I   n  v  a  l  i  d     c
    68 61 72 61 63 74 65 72  2e 0a 00 00 00 00 00 00
  ;  h  a  r  a  c  t  e  r   . \n \0
@0x110



; ==========================================================
; size_t strlen(char* str)
; ==========================================================
; Returns the length of the given null-terminated string, not including the
; null-terminator.
;
; This is the standard C strlen() function.
;
; params:
;     - str: r0
; vars:
;     - count: r1
; ==========================================================

@0x110 =strlen
    ; don't bother to set up a stack frame
    ; we accumulate the count in r1, then move it to r0
    70 81 00 00         ; add r1 0 0           ; zero r1
;:strlen_loop
    7A 8A 80 81         ; ldb ra r0 r1
    7E 8A 02 00         ; jz ra &strlen_done (+2)
    70 81 81 01         ; add r1 r1 1          ; inc r1
    7E 00 FC FF         ; jz 0 &strlen_loop (-4)
;:strlen_done
    70 80 00 81         ; add r0 0 r1          ; mov r0 r1
    78 8F 00 8C         ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00
@0x130



;==========================================
; [[noreturn] void fatal(const char* message);
;==========================================
; Prints the given error message to stderr and exits.
;==========================================

@0x130 =fatal
    ; don't bother to set up a stack frame, we're exiting

    ; push message
    71 8C 8C 04     ; sub rsp rsp 4     ; push r0
    79 80 00 8C     ; stw r0 0 rsp      ; ...

    ; call strlen
    7C 8A 00 00    ; ims ra <strlen
    7C 8A 10 01    ; ims ra >strlen
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get args for write_all(stderr, message, length)
    70 82 80 00   ; add r2 r0 0       ; r2 = length
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 80 89 14   ; ldw r0 r9 20      ; r0 = stderr
    78 81 8C 00   ; ldw r1 rsp 0      ; r1 = message

    ; call write_all
    7C 8A 00 00    ; ims ra <write_all
    7C 8A A0 0B    ; ims ra >write_all (0xBA0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; If write_all() failed, we exit with status code 2; otherwise we exit with
    ; status code 1. There's not really anything else we can do to indicate
    ; that we failed to write an error message.
    7E 80 02 00    ; jz r0 &fatal_print_ok (+2)
    70 80 02 00    ; add r0 2 0    ; exit status 2
    7E 00 01 00    ; jz r0 &fatal_print_done (+1)
;:fatal_print_ok
    70 80 01 00    ; add r0 1 0    ; exit status 1
;:fatal_print_done

    ; tail-call exit()
    7C 8A 00 00    ; ims ra <exit
    7C 8A 70 0B    ; ims ra >exit (0xB70)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1D0



;==========================================
; [[noreturn]] void start(uint32_t* process_info_table);
;==========================================

@0x1D0 =start
    ; no stack frame, we don't return

    ; call initialize
    7C 8A 00 00    ; ims ra <initialize
    7C 8A 70 02    ; ims ra >initialize (0x270)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call parse_args() (which also opens files)
    7C 8A 00 00    ; ims ra <parse_args
    7C 8A 20 03    ; ims ra >parse_args
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; read the first char, call read_char()
    7C 8A 00 00    ; ims ra <read_char
    7C 8A 60 10    ; ims ra >read_char (0x1060)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; loop calling parse_character() forever. it will exit when it runs
    ; out of data.
    ;:start_loop
        7C 8A 00 00    ; ims ra <parse_character
        7C 8A B0 04    ; ims ra >parse_character
        71 8C 8C 04    ; sub rsp rsp 4     ; push return address
        70 8B 8F 08    ; add rb rip 8
        79 8B 00 8C    ; stw rb 0 rsp
        70 8F 8E 8A    ; add rip rpp ra    ; jump
        70 8C 8C 04    ; add rsp rsp 4     ; pop return address
    7E 00 F8 FF    ; jz 0 &start_loop (-8)

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x270



;==========================================
; void initialize(uint32_t* process_info_table);
;==========================================
; Initializes all global variables.
;==========================================

@0x270 =initialize
    ; don't bother to set up a stack frame

    ; store the process info table
    79 80 8E 20   ; stw r0 rpp 0x20    ; process_info_table

    ; clear the output buffer
    7C 8A 00 00   ; ims ra <output_buffer
    7C 8A 00 0E   ; ims ra >output_buffer
    70 8A 8A 8E   ; add ra ra rpp
    79 8A 8E 3C   ; stw ra rpp 0x3C    ; output_buffer_pos = &output_buffer

    ; the rest of our globals are either already initialized or don't need to
    ; be initialized here.

    ; return
    78 8F 00 8C    ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x2C0



;==========================================
; void arg_is_dash_o(int arg_offset);
;==========================================
; Returns true if the argument with the given offset is equal to "-o"; false
; otherwise.
;==========================================

@0x2C0 =arg_is_dash_o
    ; no stack frame

    ; get the arg into r0
    78 88 8E 20     ; ldw r8 rpp 0x20  (process_info_table)
    78 81 88 18     ; ldw r1 r8 24     (command-line args)
    78 80 81 80     ; ldw r0 r1 r0

    ; check "-"
    7A 8A 80 00     ; ldw ra r0 0
    71 8A 8A 2D     ; sub ra ra "-"
    7E 8A 02 00     ; jz ra +2
    70 80 00 00     ; add r0 0 0       ; set return value false
    78 8F 00 8C     ; ldw rip 0 rsp    ; ret

    ; check "o"
    7A 8A 80 01     ; ldw ra r0 1
    71 8A 8A 6F     ; sub ra ra "o"
    7E 8A 02 00     ; jz ra +2
    70 80 00 00     ; add r0 0 0       ; set return value false
    78 8F 00 8C     ; ldw rip 0 rsp    ; ret

    ; check null-terminator
    7A 8A 80 02     ; ldw ra r0 2
    71 8A 8A 00     ; sub ra ra 0
    7E 8A 02 00     ; jz ra +2
    70 80 00 00     ; add r0 0 0       ; set return value false
    78 8F 00 8C     ; ldw rip 0 rsp    ; ret

    ; return true
    70 80 00 01     ; add r0 0 1       ; set return value true
    78 8F 00 8C     ; ldw rip 0 rsp    ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x320



;==========================================
; void parse_args(void);
;==========================================
; Verifies that the arguments are valid and opens the input and output files.
;==========================================

@0x320 =parse_args
    ; no stack frame

    ; check that we have exactly four arguments
    78 88 8E 20     ; ldw r8 rpp 0x20  (process_info_table)
    78 81 88 18     ; ldw r1 r8 24     (command-line args)
    78 8A 81 00     ; ldw ra r1 0
    7E 8A 09 00     ; jz ra &parse_args_arg_count_wrong (+9)
    78 8A 81 04     ; ldw ra r1 4
    7E 8A 07 00     ; jz ra &parse_args_arg_count_wrong (+7)
    78 8A 81 08     ; ldw ra r1 8
    7E 8A 05 00     ; jz ra &parse_args_arg_count_wrong (+5)
    78 8A 81 0C     ; ldw ra r1 12
    7E 8A 03 00     ; jz ra &parse_args_arg_count_wrong (+3)
    78 8A 81 10     ; ldw ra r1 16
    7E 00 06 00     ; jz 0 &parse_args_arg_count_ok (+6)

;:parse_args_arg_count_wrong
    ; fatal error_invalid_arguments
    7C 80 00 00        ; ims r0 <error_invalid_arguments
    7C 80 50 00        ; ims r0 >error_invalid_arguments
    70 80 8E 80        ; add r0 rpp r0
    7C 8A 00 00        ; ims ra <fatal
    7C 8A 30 01        ; ims ra >fatal
    70 8F 8E 8A        ; add rip rpp ra
;:parse_args_arg_count_ok

    ; check if the first argument is -o, call arg_is_dash_o
    70 80 00 04    ; add r0 0 4
    7C 8A 00 00    ; ims ra <arg_is_dash_o
    7C 8A C0 02    ; ims ra >arg_is_dash_o
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; if yes, tail-call open_files
    7E 80 05 00    ; jz r0 &parse_args_not_first (+5)
    70 80 00 0C    ; add r0 0 12   ; input file is third arg
    70 81 00 08    ; add r1 0 8    ; output file is second arg
    7C 8A 00 00    ; ims ra <open_files
    7C 8A 10 04    ; ims ra >open_files
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:parse_args_not_first

    ; check if the second argument is -o, call arg_is_dash_o
    70 80 00 08    ; add r0 0 8
    7C 8A 00 00    ; ims ra <arg_is_dash_o
    7C 8A C0 02    ; ims ra >arg_is_dash_o
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; if yes, tail-call open_files
    7E 80 05 00    ; jz r0 &parse_args_not_second (+5)
    70 80 00 04    ; add r0 0 4    ; input file is first arg
    70 81 00 0C    ; add r1 0 12   ; output file is third arg
    7C 8A 00 00    ; ims ra <open_files
    7C 8A 10 04    ; ims ra >open_files
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:parse_args_not_second

    ; fatal error_invalid_arguments
    7C 80 00 00        ; ims r0 <error_invalid_arguments
    7C 80 50 00        ; ims r0 >error_invalid_arguments
    70 80 8E 80        ; add r0 rpp r0
    7C 8A 00 00        ; ims ra <fatal
    7C 8A 30 01        ; ims ra >fatal
    70 8F 8E 8A        ; add rip rpp ra

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x410



; ==========================================================
; void open_files(int input_arg_offset, int output_arg_offset);
; ==========================================================

@0x410 =open_files

    ; get input and output filenames
    78 88 8E 20     ; ldw r8 rpp 0x20  (process_info_table)
    78 82 88 18     ; ldw r2 r8 24     (command-line args)
    78 80 82 80     ; ldw r0 r2 r0
    78 81 82 81     ; ldw r1 r2 r1

    ; push output filename
    71 8C 8C 04    ; sub rsp rsp 4
    79 81 00 8C    ; stw r1 0 rsp

    ; call open_input_file
    7C 8A 00 00    ; ims ra <open_input_file
    7C 8A 00 0F    ; ims ra >open_input_file
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; pop output filename
    78 80 00 8C    ; ldw r0 0 rsp
    70 8C 8C 04    ; add rsp rsp 4

    ; call open_output_file
    7C 8A 00 00    ; ims ra <open_output_file
    7C 8A 90 0F    ; ims ra >open_output_file
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; done
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x4B0



;==========================================
; void parse_character(void);
;==========================================
; Parses the current character.
;
; This will consume the current character and however many additional
; characters are necessary. It will leave an unparsed character (or -1 for
; end-of-file) in current_char.
;==========================================

@0x4B0 =parse_character

    ; This works by calling a series of try_parse functions that return true
    ; when they successfully parse. As soon as one returns true, we return. If
    ; none return true, it's a fatal error. They are ordered roughly in order
    ; of likelyhood.

    ; check for end of file
    78 80 8E 2C    ; ldw r0 rpp 0x2C  ; current_char
    71 8A 80 FF    ; sub ra r0 -1
    7E 8A 01 00    ; jz ra +1
    7E 00 03 00    ; jz 0 &parse_character_no_eof (+3)

    ; if end of file, tail-call end_parsing (this does not return)
    7C 8A 00 00    ; ims ra <end_parsing
    7C 8A 30 12    ; ims ra >end_parsing (0x1230)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:parse_character_no_eof

    ; whitespace
    7C 8A 00 00    ; ims ra <try_parse_whitespace
    7C 8A 80 05    ; ims ra >try_parse_whitespace
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address
    7E 80 01 00    ; jz r0 &parse_character_not_whitespace (+1)
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret
;:parse_character_not_whitespace

    ; hex
    7C 8A 00 00    ; ims ra <try_parse_hex
    7C 8A E0 06    ; ims ra >try_parse_hex
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address
    7E 80 01 00    ; jz r0 &parse_character_not_hex (+1)
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret
;:parse_character_not_hex

    ; comment
    7C 8A 00 00    ; ims ra <try_parse_comment
    7C 8A 00 08    ; ims ra >try_parse_comment
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address
    7E 80 01 00    ; jz r0 &parse_character_not_comment (+1)
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret
;:parse_character_not_comment

    ; address assertion
    7C 8A 00 00    ; ims ra <try_parse_address
    7C 8A 30 09    ; ims ra >try_parse_address
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address
    7E 80 01 00    ; jz r0 &parse_character_not_address (+1)
    78 8F 00 8C    ; ldw rip 0 rsp     ; ret
;:parse_character_not_address

    ; fatal error_invalid_character
    7C 80 00 00    ; ims r0 <error_invalid_character
    7C 80 F0 00    ; ims r0 >error_invalid_character
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x580



;==========================================
; bool try_parse_whitespace(void);
;==========================================
; Tries to parse a whitespace character. Returns true if a whitespace character
; was consumed, false otherwise.
;
; (This only consumes one whitespace character, not a string of whitespace.)
;==========================================

@0x580 =try_parse_whitespace
    ; don't bother to set up a stack frame

    ; get the current char
    78 80 8E 2C    ; ldw r0 rpp 0x2C   ; current_char

    ; check for whitespace
    71 8A 80 20    ; sub ra r0 " "   (space)
    7E 8A 0C 00    ; jz ra &try_parse_whitespace_true (+12)
    71 8A 80 0A    ; sub ra r0 "\n"  (line feed)
    7E 8A 0A 00    ; jz ra &try_parse_whitespace_true (+10)
    71 8A 80 09    ; sub ra r0 "\t"  (horizontal tab)
    7E 8A 08 00    ; jz ra &try_parse_whitespace_true (+8)
    71 8A 80 0D    ; sub ra r0 "\r"  (carriage return)
    7E 8A 06 00    ; jz ra &try_parse_whitespace_true (+6)
    71 8A 80 0C    ; sub ra r0 "\f"  (form feed)
    7E 8A 04 00    ; jz ra &try_parse_whitespace_true (+4)
    71 8A 80 0B    ; sub ra r0 "\v"  (vertical tab)
    7E 8A 02 00    ; jz ra &try_parse_whitespace_true (+2)

    ; not whitespace. return false
    70 80 00 00    ; add r0 0 0
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

;:try_parse_whitespace_true

    ; it's whitespace. consume it
    7C 8A 00 00    ; ims ra <read_char
    7C 8A 60 10    ; ims ra >read_char (0x1060)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; return true
    70 80 00 01    ; add r0 0 1
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

    ; no padding left!
@0x5E0



;==========================================
; void emit_byte(char c);
;==========================================
; Writes a byte to the output buffer. If the buffer is full, the output is
; flushed afterwards.
;
; If any error occurs, the program aborts.
;==========================================

@0x5E0 =emit_byte
    ; don't bother to set up a stack frame

    ; increment byte count
    78 8A 8E 30    ; ldw ra rpp 0x30    ; load byte_count
    70 8A 8A 01    ; add ra ra 1        ; inc ra
    79 8A 8E 30    ; stw ra rpp 0x30    ; store byte_count

    ; the output buffer always has free space. we start by writing
    ; the byte to it and bumping the pointer.
    78 81 8E 3C    ; ldw r1 rpp 0x3C   ; output_buffer_pos
    7B 80 00 81    ; stb r0 0 r1
    70 81 81 01    ; add r1 r1 1
    79 81 8E 3C    ; stw r1 rpp 0x3C

    ; get the output buffer
    7C 8A 00 00    ; ims ra <output_buffer
    7C 8A 00 0E    ; ims ra >output_buffer (0xE00)
    70 82 8E 8A    ; add r2 rpp ra

    ; get the end of the output buffer
    76 83 01 08    ; shl r3 1 8     ; r3 = 256
    70 83 82 83    ; add r3 r2 r3

    ; check if there is space left in the buffer
    71 8A 81 83    ; sub ra r1 r3
    7E 8A 01 00    ; jz ra &emit_byte_full (+1)

    ; if there is still space left, we're done.
    78 8F 00 8C    ; ldw rip 0 rsp        ; ret

;:emit_byte_full

    ; the buffer is full. call flush
    7C 8A 00 00    ; ims ra <flush
    7C 8A A0 11    ; ims ra >flush (0x11A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; reset the buffer pos to the start
    7C 8A 00 00    ; ims ra <output_buffer
    7C 8A 00 0E    ; ims ra >output_buffer (0xE00)
    70 82 8E 8A    ; add r2 rpp ra
    79 82 8E 3C    ; stw r2 rpp 0x3C   ; output_buffer_pos

    ; done
    78 8F 00 8C    ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00
@0x650



;==========================================
; int hex_value(char c);
;==========================================
; Returns the hex value of the given char, or -1 if it's not hex.
;==========================================

@0x650 =hex_value
    ; don't bother to set up a stack frame

    ; check if it's a number 0-9
    7D 8A 80 30   ; ltu ra r0 "0"
    71 8A 01 8A   ; sub ra 1 ra
    7E 8A 05 00   ; jz ra &hex_value_not_number (+5)
    7D 8A 39 80   ; ltu ra "9" r0
    71 8A 01 8A   ; sub ra 1 ra
    7E 8A 02 00   ; jz ra &hex_value_not_number (+2)

    ; it's 0-9
    71 80 80 30         ; sub r0 r0 "0"
    78 8F 00 8C         ; ldw rip 0 rsp        ; ret
;:hex_value_not_number

    ; check if it's uppercase A-F
    7D 8A 80 41   ; ltu ra r0 "A"
    71 8A 01 8A   ; sub ra 1 ra
    7E 8A 05 00   ; jz ra &hex_value_not_uppercase (+5)
    7D 8A 46 80   ; ltu ra "F" r0
    71 8A 01 8A   ; sub ra 1 ra
    7E 8A 02 00   ; jz ra &hex_value_not_uppercase (+2)

    ; it's A-F
    71 80 80 37         ; sub r0 r0 '37 ('A' == 0x41)
    78 8F 00 8C         ; ldw rip 0 rsp        ; ret
;:hex_value_not_uppercase

    ; check if it's lowercase a-f
    7D 8A 80 61   ; ltu ra r0 "a"
    71 8A 01 8A   ; sub ra 1 ra
    7E 8A 05 00   ; jz ra &hex_value_not_lowercase (+5)
    7D 8A 66 80   ; ltu ra "f" r0
    71 8A 01 8A   ; sub ra 1 ra
    7E 8A 02 00   ; jz ra &hex_value_not_lowercase (+2)

    ; it's a-f
    71 80 80 57         ; sub r0 r0 '57 ('a' == 0x61)
    78 8F 00 8C         ; ldw rip 0 rsp        ; ret
;:hex_value_not_lowercase

    ; it's not hex.
    70 80 00 FF         ; add r0 0 -1
    78 8F 00 8C         ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x6E0



;==========================================
; bool try_parse_hex(void);
;==========================================
; Tries to parse a hex byte, returning true if a hex byte was consumed.
;
; If a hex byte is found, the current address is incremented and the byte is
; emitted to the output.
;==========================================

@0x6E0 =try_parse_hex
    ; no stack frame

    ; convert the first char to its hex value
    78 80 8E 2C    ; ldw r0 rpp 0x2C   ; current_char
    7C 8A 00 00    ; ims ra <hex_value
    7C 8A 50 06    ; ims ra >hex_value
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; check if it's actually hex
    71 8A 80 FF    ; sub ra r0 -1
    7E 8A 01 00    ; jz ra &parse_hex_false (+1)
    7E 00 02 00    ; jz 0 &parse_hex_found (+2)

    ; it's not hex. return false
;:parse_hex_false
    70 80 00 00    ; add r0 0 0
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

    ; we've found a hex char!
;:parse_hex_found

    ; shift up the high hex bits
    76 80 80 04    ; shl r0 r0 4

    ; put it on the stack
    71 8C 8C 04    ; sub rsp rsp 4     ; push r0
    79 80 00 8C    ; stw r0 0 rsp      ; ...

    ; consume the character
    7C 8A 00 00    ; ims ra <read_char
    7C 8A 60 10    ; ims ra >read_char (0x1060)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; make sure it's not the end of the file
    78 80 8E 2C    ; ldw r0 rpp 0x2C   ; current_char
    71 8A 80 FF    ; sub ra r0 -1
    7E 8A 0A 00    ; jz ra &parse_hex_byte_invalid (+10)

    ; convert the second char to its hex value
    7C 8A 00 00    ; ims ra <hex_value
    7C 8A 50 06    ; ims ra >hex_value
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; make sure it's actually a hex char
    71 8A 80 FF    ; sub ra r0 -1
    7E 8A 01 00    ; jz ra &parse_hex_byte_invalid (+1)
    7E 00 06 00    ; jz 0 &parse_hex_byte_valid (+6)

    ; invalid or eof, fatal error_truncated_hex_byte
;:parse_hex_byte_invalid
    7C 80 00 00    ; ims r0 <error_truncated_hex_byte
    7C 80 40 0B    ; ims r0 >error_truncated_hex_byte
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:parse_hex_byte_valid

    ; pop the high bits
    78 81 00 8C    ; ldw r1 0 rsp      ; pop r1
    70 8C 8C 04    ; add rsp rsp 4     ; ...

    ; mask them in
    75 80 80 81     ; or r0 r0 r1

    ; call emit_byte
    7C 8A 00 00    ; ims ra <emit_byte
    7C 8A E0 05    ; ims ra >emit_byte (0x5E0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; consume the second hex character
    7C 8A 00 00    ; ims ra <read_char
    7C 8A 60 10    ; ims ra >read_char (0x1060)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; done, return true
    70 80 00 01    ; add r0 0 1
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x800



;==========================================
; bool try_parse_comment(void);
;==========================================
; Tries to parse a comment. Returns true if a comment was consumed, false
; otherwise.
;==========================================

@0x800 =try_parse_comment
    ; don't bother to set up a stack frame

    ; get the current char
    78 80 8E 2C    ; ldw r0 rpp 0x2C   ; current_char

    ; check if comment (we treat debug lines as comments)
    71 8A 80 23    ; sub ra r0 "#"
    7E 8A 04 00    ; jz ra &try_parse_comment_found (+4)
    71 8A 80 3B    ; sub ra r0 ";"
    7E 8A 02 00    ; jz ra &try_parse_comment_found (+2)

    ; not a comment. return false
    70 80 00 00    ; add r0 0 0
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

;:try_parse_comment_found
    ; it's a comment. tail-call consume_comment()
    7C 8A 00 00    ; ims ra <consume_comment
    7C 8A 40 08    ; ims ra >consume_comment
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x840



;==========================================
; bool consume_comment(void);
;==========================================
; Consumes a comment, returning true.
;
; (This returns true so that try_parse functions can tail-call it.)
;==========================================

@0x840 =consume_comment

    ; push a flag to test for a trailing backslash
    71 8C 8C 04    ; sub rsp rsp 4
    79 00 8C 00    ; stw 0 rsp 0    ; clear the flag

;:consume_comment_loop

    ; get the current char
    78 80 8E 2C    ; ldw r0 rpp 0x2C   ; current_char

    ; check if newline (\n or \r) or end of file
    71 8A 80 0A    ; sub ra r0 "\n"
    7E 8A 11 00    ; jz ra &consume_comment_done (+17)
    71 8A 80 0D    ; sub ra r0 "\r"
    7E 8A 0F 00    ; jz ra &consume_comment_done (+15)
    71 8A 80 FF    ; sub ra r0 -1
    7E 8A 0D 00    ; jz ra &consume_comment_done (+13)

    ; check if backslash
    71 8A 80 5C    ; sub ra r0 "\"
    7E 8A 02 00    ; jz ra +2
    79 00 8C 00    ; stw 0 rsp 0    ; clear the flag
    7E 00 01 00    ; jz 0 +1
    79 01 8C 00    ; stw 1 rsp 0    ; set the flag

    ; consume the character
    7C 8A 00 00    ; ims ra <read_char
    7C 8A 60 10    ; ims ra >read_char (0x1060)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; loop
    7E 00 EC FF    ; jz 0 &consume_comment_loop (-20)

;:consume_comment_done

    ; if the backslash flag is set, fatal error
    78 8A 8C 00    ; ldw ra rsp 0
    7E 8A 06 00    ; jz ra &consume_comment_ok (+6)
    7C 80 00 00    ; ims r0 <error_backslash_eol
    7C 80 D0 08    ; ims r0 >error_backslash_eol
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:consume_comment_ok
    70 8C 8C 04    ; add rsp rsp 4     ; pop backslash flag

    ; we've consumed the whole comment. return true.
    70 80 00 01    ; add r0 0 1
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x8D0



;==========================================
; const char error_backslash_eol[];
;==========================================

@0x8D0 =error_backslash_eol
    ; "ERROR: Backslash at end of line is forbidden." '0A '00
    45 52 52 4f 52 3a 20 42  61 63 6b 73 6c 61 73 68
  ;  E  R  R  O  R  :     B   a  c  k  s  l  a  s  h
    20 61 74 20 65 6e 64 20  6f 66 20 6c 69 6e 65 20
  ;     a  t     e  n  d     o   f     l  i  n  e
    69 73 20 66 6f 72 62 69  64 64 65 6e 2e 0a 00 00
  ;  i  s     f  o  r  b  i  d  d  e  n  .  \n \0
@0x900



;==========================================
; const char error_address_assertion[];
;==========================================

@0x900 =error_address_assertion
    ; "ERROR: Invalid address assertion." '0A '00
    45 52 52 4f 52 3a 20 49  6e 76 61 6c 69 64 20 61
  ;  E  R  R  O  R  :     I   n  v  a  l  i  d     a
    64 64 72 65 73 73 20 61  73 73 65 72 74 69 6f 6e
  ;  d  d  r  e  s  s     a   s  s  e  r  t  i  o  n
    2e 0a 00 00 00 00 00 00  00 00 00 00 00 00 00 00
  ;  . \n \0
@0x930



;==========================================
; bool try_parse_address(void);
;==========================================
; Tries to parse an address assertion.
;
; vars:
; - address: rfp-4
; - digit count: rfp-8
;==========================================

@0x930 =try_parse_address

    ; get the current char
    78 80 8E 2C    ; ldw r0 rpp 0x2C   ; current_char

    ; check if it's an address assertion
    71 8A 80 40    ; sub ra r0 "@"
    7E 8A 02 00    ; jz ra &try_parse_address_found (+2)

    ; not an address assertion, return false
    70 80 00 00    ; add r0 0 0
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

;:try_parse_address_found

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; setup local vars
    71 8C 8C 08    ; sub rsp rsp 8
    79 00 8D F8    ; stw 0 rfp -8    ; digit count
    79 00 8D FC    ; stw 0 rfp -4    ; address

    ; consume the "@"
    7C 8A 00 00    ; ims ra <read_char
    7C 8A 60 10    ; ims ra >read_char (0x1060)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; make sure the next char is "0", otherwise fatal error
    78 80 8E 2C    ; ldw r0 rpp 0x2C   ; current_char
    71 8A 80 30    ; sub ra r0 "0"
    7E 8A 06 00    ; jz ra &try_parse_address_zero (+6)
    7C 80 00 00    ; ims r0 <error_address_assertion
    7C 80 00 09    ; ims r0 >error_address_assertion
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:try_parse_address_zero

    ; consume the "0"
    7C 8A 00 00    ; ims ra <read_char
    7C 8A 60 10    ; ims ra >read_char (0x1060)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; make sure the next char is "x" or "X", otherwise fatal error
    78 80 8E 2C    ; ldw r0 rpp 0x2C   ; current_char
    71 8A 80 78    ; sub ra r0 'x'
    7E 8A 08 00    ; jz ra &try_parse_address_x (+8)
    71 8A 80 58    ; sub ra r0 "X"
    7E 8A 06 00    ; jz ra &try_parse_address_x (+6)
    7C 80 00 00    ; ims r0 <error_address_assertion
    7C 80 00 09    ; ims r0 >error_address_assertion
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:try_parse_address_x

    ; consume the "x"
    7C 8A 00 00    ; ims ra <read_char
    7C 8A 60 10    ; ims ra >read_char (0x1060)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

;:try_parse_address_loop

    ; check if the current char is whitespace or end-of-file
    78 80 8E 2C    ; ldw r0 rpp 0x2C   ; current_char
    71 8A 80 FF    ; sub ra r0 -1    (end of file)
    7E 8A 0E 00    ; jz ra &try_parse_address_is_space (+12)
    71 8A 80 20    ; sub ra r0 " "   (space)
    7E 8A 0C 00    ; jz ra &try_parse_address_is_space (+12)
    71 8A 80 0A    ; sub ra r0 "\n"  (line feed)
    7E 8A 0A 00    ; jz ra &try_parse_address_is_space (+10)
    71 8A 80 09    ; sub ra r0 "\t"  (horizontal tab)
    7E 8A 08 00    ; jz ra &try_parse_address_is_space (+8)
    71 8A 80 0D    ; sub ra r0 "\r"  (carriage return)
    7E 8A 06 00    ; jz ra &try_parse_address_is_space (+6)
    71 8A 80 0C    ; sub ra r0 "\f"  (form feed)
    7E 8A 04 00    ; jz ra &try_parse_address_is_space (+4)
    71 8A 80 0B    ; sub ra r0 "\v"  (vertical tab)
    7E 8A 02 00    ; jz ra &try_parse_address_is_space (+2)

    ; (we jump to this little shunt to make it easier for us to change the
    ; below without having to change everything above)
    7E 00 02 00    ; jz 0 &try_parse_address_not_space (+2)
    00 00 00 00    ; padding
;:try_parse_address_is_space
    7E 00 28 00    ; jz 0 &try_parse_address_loop_done (+40)
;:try_parse_address_not_space

    ; get the hex value of the current digit
    7C 8A 00 00    ; ims ra <hex_value
    7C 8A 50 06    ; ims ra >hex_value
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; if it's -1, fatal error
    71 8A 80 FF    ; sub ra r0 -1
    7E 8A 01 00    ; jz ra +1
    7E 00 06 00    ; jz 0 &try_parse_address_hex_ok (+6)
    7C 80 00 00    ; ims r0 <error_address_assertion
    7C 80 00 09    ; ims r0 >error_address_assertion
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:try_parse_address_hex_ok

    ; increment digit count. if we already have 8, fatal error
    78 8A 8D F8    ; ldw ra rfp -8    ; load digit count
    71 8B 8A 08    ; sub rb ra 8
    7E 8B 01 00    ; jz rb +1
    7E 00 06 00    ; jz 0 +6
        7C 80 00 00    ; ims r0 <error_address_assertion
        7C 80 00 09    ; ims r0 >error_address_assertion
        70 80 8E 80    ; add r0 rpp r0
        7C 8A 00 00    ; ims ra <fatal
        7C 8A 30 01    ; ims ra >fatal
        70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8A 8A 01    ; add ra ra 1      ; inc ra
    79 8A 8D F8    ; stw ra rfp -8    ; store digit count

    ; shift up the address and add the new digit
    78 8A 8D FC    ; ldw ra rfp -4   ; load address
    76 8A 8A 04    ; shl r0 r0 4
    70 80 8A 80    ; add r0 ra r0
    79 80 8D FC    ; stw r0 rfp -4   ; store address

    ; consume the digit
    7C 8A 00 00    ; ims ra <read_char
    7C 8A 60 10    ; ims ra >read_char (0x1060)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; loop
    7E 00 C6 FF    ; jz 0 &try_parse_address_loop (-58)

;:try_parse_address_loop_done

    ; check that we had at least one digit, and check that the address matches.
    ; if not, fatal error
    78 8A 8D F8    ; ldw ra rfp -8    ; load digit count
    7E 8A 04 00    ; jz ra +4
    78 8A 8D FC    ; ldw ra rfp -4      ; load address
    78 8B 8E 30    ; ldw rb rpp 0x30    ; load byte_count
    71 8A 8A 8B    ; sub ra ra rb
    7E 8A 06 00    ; jz ra +6
        7C 80 00 00    ; ims r0 <error_address_assertion
        7C 80 00 09    ; ims r0 >error_address_assertion
        70 80 8E 80    ; add r0 rpp r0
        7C 8A 00 00    ; ims ra <fatal
        7C 8A 30 01    ; ims ra >fatal
        70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; clean up our stack frame
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp
    70 8C 8C 04     ; add rsp rsp 4     ; ...

    ; the rest of the line is a comment. tail-call consume_comment()
    7C 8A 00 00    ; ims ra <consume_comment
    7C 8A 40 08    ; ims ra >consume_comment
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0xB40



;==========================================
; const char error_truncated_hex_byte[];
;==========================================

@0xB40 =error_truncated_hex_byte
    ; "ERROR: Truncated or invalid hex byte." '0A '00
    45 52 52 4f 52 3a 20 54  72 75 6e 63 61 74 65 64
  ;  E  R  R  O  R  :     T   r  u  n  c  a  t  e  d
    20 6f 72 20 69 6e 76 61  6c 69 64 20 68 65 78 20
  ;     o  r     i  n  v  a   l  i  d     h  e  x
    62 79 74 65 2e 0a 00 00  00 00 00 00 00 00 00 00
  ;  b  y  t  e  . \n \0
@0xB70



;==========================================
; [[noreturn] void exit(int status);
;==========================================
; Exits with the given status.
;==========================================

@0xB70 =exit
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    78 89 88 04   ; ldw r9 r8 4       ; r9 = r9 of syscall exit
    78 8F 88 00   ; ldw rip r8 0      ; rip = rip of syscall exit

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0xBA0



;==========================================
; int write_all(int handle, const char* data, size_t count);
;==========================================
; Writes all of the given data to the given I/O handle.
;
; Returns zero if successful, or the syscall error code if it fails.
;
; vars
; - io_handle: rfp-4
; - data: rfp-8
; - remaining: rfp-12
; - loop address: rfp-16
;==========================================

@0xBA0 =write_all

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; store args
    71 8C 8C 10     ; sub rsp rsp 16
    79 80 8D FC     ; stw r0 rfp -4
    79 81 8D F8     ; stw r1 rfp -8
    79 82 8D F4     ; stw r2 rfp -12

    ; store the address to loop
    79 8F 8D F0    ; stw rip rfp -16
;:write_all_loop

    ; get syscall fwrite into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 06 03   ; shl ra 6 3        ; ra = offset of fwrite syscall (6<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of fwrite syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; check the high bit for error
    77 8A 80 1F   ; shru ra r0 31
    7E 8A 04 00   ; jz ra &write_all_no_error (+4)
    ; fail, return the error code
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;:write_all_no_error

    ; check if we got zero
    7E 80 01 00   ; jz r0 &write_all_zero (+1)
    7E 00 05 00   ; jz 0 &write_all_not_zero (+5)
;:write_all_zero
    ; zero bytes written. this should not be possible; the vm is
    ; malfunctioning. fail, return generic error -1
    70 80 00 FF     ; add r0 0 -1
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;:write_all_not_zero

    ; adjust pointer and bytes remaining
    78 81 8D F8   ; ldw r1 rfp -8
    78 82 8D F4   ; ldw r2 rfp -12
    70 81 81 80   ; add r1 r1 r0
    71 82 82 80   ; sub r2 r2 r0
    79 81 8D F8   ; stw r1 rfp -8
    79 82 8D F4   ; stw r2 rfp -12

    ; if bytes remaining is zero, we're done
    7E 82 02 00   ; jz r2 &write_all_loop_exit (+2)

    ; otherwise loop.
    78 80 8D FC   ; ldw r0 rfp -4     ; io_handle
    78 8F 8D F0   ; ldw rip rfp -16   ; jump to :write_all_loop

;:write_all_loop_exit

    ; done, return zero
    70 80 00 00     ; add r0 0 0        ; zero r0
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0xC90



    ; extra padding due to moved functions
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00



;==========================================
; char input_buffer[256];
;==========================================
; The input buffer.
;
; input_buffer_pos and input_buffer_end point into this buffer. The portion of
; the buffer that contains data is the range between the two pointers.
;==========================================

@0xD00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
@0xE00



;==========================================
; char output_buffer[256];
;==========================================
; The output buffer.
;
; output_buffer_pos points into this buffer. The portion of the buffer that
; contains data is the range from the start of this buffer to the pointer.
;==========================================

@0xE00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
@0xF00



;==========================================
; void open_input_file(const char* filename);
;==========================================
; Opens the input file.
;==========================================

@0xF00 =open_input_file
    ; don't bother to set up a stack frame

    ; setup args for fopen(filename, read_only)
    ; filename is already in r0
    70 81 00 00    ; add r1 0 0     ; read-only

    ; get syscall fopen into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 03 03   ; shl ra 3 3        ; ra = offset of fopen syscall (3<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fopen syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 00 06 00    ; jz 0 &open_input_file_ok (+6)

    ; failed to open input file. fatal
;:open_input_file_fail
    7C 80 00 00    ; ims r0 <error_input_file
    7C 80 90 00    ; ims r0 >error_input_file (0x90)
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:open_input_file_ok

    ; store input handle
    79 80 8E 24    ; stw r0 rpp 0x24  (input_io_handle)

    ; return
    78 8F 00 8C    ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0xF90



;==========================================
; void open_output_file(const char* filename);
;==========================================
; Opens the output file.
;
; The first half of this function is very similar to open_input_file, with
; differences in mode (i.e. writeable) and the error message on failure.
;
; There is some additional work needed to truncate the file in case it already
; existed.
;==========================================

@0xF90 =open_output_file
    ; don't bother to set up a stack frame

    ; setup args for fopen(filename, read_write)
    ; filename is already in r0
    70 81 01 00    ; add r1 1 0     ; read_write

    ; get syscall fopen into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 03 03   ; shl ra 3 3        ; ra = offset of fopen syscall (3<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fopen syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 00 06 00    ; jz ra &open_output_file_ok (+6)

    ; failed to open output file. fatal
;:open_output_file_fail
    7C 80 00 00    ; ims r0 <error_output_file
    7C 80 C0 00    ; ims r0 >error_output_file
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:open_output_file_ok

    ; store output handle
    79 80 8E 28    ; stw r0 rpp 0x28  (output_io_handle)

    ; We need to call ftrunc on the output file in case it already contained
    ; data. We do this only if the ftrunc syscall is supported.
    ;
    ; TODO: We should have some means of checking that the output is empty if
    ; ftrunc is not supported. For example maybe we should try fseek/ftell. We
    ; need to be careful to make sure streams (e.g. /dev/stdout) are still
    ; supported. If we can tell that it's not a stream we could also try to
    ; unlink it before opening it. Or, maybe none of this is important during
    ; bootstrapping, and we only need to do this stuff in the final stage
    ; (hex/c89) hex tool. This is only used to bootstrap ld/0 anyway, so even
    ; if the file already contains data, the start will be overwritten by ld/0
    ; and it should still work.

    ; get syscall ftrunc into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 09 03   ; shl ra 9 3        ; ra = offset of ftrunc syscall (9<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of ftrunc syscall

    ; check if the syscall is supported
    78 8A 87 00   ; ldw ra r7 0       ; ra = syscall ftrunc
    7E 8A 08 00   ; jz ra &open_output_file_skip_truncate (+8)

    ; prepare args for syscall
    70 81 00 00   ; add r1 0 0
    70 82 00 00   ; add r2 0 0

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; TODO check for errors (making sure not to break streams)

;:open_output_file_skip_truncate

    ; return
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1060



;==========================================
; void read_char(void);
;==========================================
; Reads a character, or -1 if the end of the file has been reached, into
; current_char.
;
; Note that this does not return the character. This is usually called after
; parsing a character in order to consume it. This might have been better named
; consume_char().
;==========================================

@0x1060 =read_char

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; if current_char is -1, we've already reached end of file. we should not
    ; attempt to read again. (reading after eof would probably be a bug but we
    ; check anyway just to make sure)
    78 82 8E 2C     ; ldw r2 rpp 0x2C
    71 82 82 FF     ; sub r2 r2 -1
    7E 82 01 00     ; jz r2 &read_char_already_eof (+1)
    7E 00 04 00     ; jz 0 &read_char_not_already_eof (+4)

;:read_char_already_eof
    ; already at eof. just return.
    ; TODO alternatively we could call fatal() with an internal error (bug) message.
    70 8C 8D 00    ; add rsp rfp 0    ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp    ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4    ; ^^^           ; ^^^
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

;:read_char_not_already_eof

    ; get our buffer start and end pointers
    78 80 8E 34     ; ldw r0 rpp 0x34  ; input_buffer_pos
    78 81 8E 38     ; ldw r1 rpp 0x38  ; input_buffer_end

    ; check if they match. if so, the buffer is empty.
    71 81 81 80     ; sub r1 r1 r0
    7E 81 08 00     ; jz r1 &read_char_buffer_empty (+8)

    ; the buffer has bytes in it. pop one into current_char; we're done.
    7A 82 80 00    ; ldw r2 r0 0
    79 82 8E 2C    ; stw r2 rpp 0x2C  ; current_char = *input_buffer_pos
    70 80 80 01    ; add r0 r0 1
    79 80 8E 34    ; stw r0 rpp 0x34  ; ++input_buffer_pos
    70 8C 8D 00    ; add rsp rfp 0    ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp    ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4    ; ^^^           ; ^^^
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

;:read_char_buffer_empty

    ; the buffer is empty. we need to fill it. prepare args
    78 80 8E 24    ; ldw r0 rpp 0x24  ; input_io_handle
    7C 8A 00 00    ; ims ra <input_buffer
    7C 8A 00 0D    ; ims ra >input_buffer (0xD00)
    70 81 8E 8A    ; add r1 rpp ra
    76 82 01 08    ; shl r2 1 8     ; r2 = 256

    ; get syscall fread into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 05 03   ; shl ra 5 3        ; ra = offset of fread syscall (5<<3)
    70 87 88 8A   ; add r7 r8 8a      ; r7 = address of fread syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 00 06 00    ; jz ra &read_char_fill_ok (+6)

    ; failed to read from input file. fatal
    7C 80 00 00    ; ims r0 <error_input_file
    7C 80 90 00    ; ims r0 >error_input_file (0x90)
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump

;:read_char_fill_ok

    ; r0 contains the number of bytes read. if zero, it's end of file.
    7E 80 01 00    ; jz r0 &read_char_eof (+1)
    7E 00 05 00    ; jz 0 &read_char_not_eof (+5)

;:read_char_eof
    ; at end of file, put -1 (as an int) into current_char and return
    79 FF 8E 2C    ; stw -1 rpp 0x2C  ; current_char
    70 8C 8D 00    ; add rsp rfp 0    ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp    ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4    ; ^^^           ; ^^^
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

;:read_char_not_eof

    ; get the first character
    7C 8A 00 00    ; ims ra <input_buffer
    7C 8A 00 0D    ; ims ra >input_buffer (0xD00)
    70 81 8E 8A    ; add r1 rpp ra
    7A 82 81 00    ; ldb r2 r1 0
    79 82 8E 2C    ; stw r2 rpp 0x2C   ; current_char = input_buffer[0]

    ; reset our buffer pointers
    70 83 81 80    ; add r3 r1 r0
    79 83 8E 38    ; stw r3 rpp 0x38  ; input_buffer_end = &input_buffer + bytes_read
    70 81 81 01    ; add r1 r1 1     (increment past the character we just read)
    79 81 8E 34    ; stw r1 rpp 0x34  ; input_buffer_pos = &input_buffer + 1

    ; finally done
    70 8C 8D 00    ; add rsp rfp 0    ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp    ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4    ; ^^^           ; ^^^
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x11A0



;==========================================
; void flush(void);
;==========================================
; Flushes the buffer to the output file.
;
; Raises a fatal error on failure.
;==========================================

@0x11A0 =flush

    ; get the output buffer
    7C 8A 00 00    ; ims ra <output_buffer
    7C 8A 00 0E    ; ims ra >output_buffer (0xE00)
    70 81 8E 8A    ; add r1 rpp ra

    ; get the byte count
    78 82 8E 3C    ; ldw r2 rpp 0x3C   ; output_buffer_pos
    71 82 82 81    ; sub r2 r2 r1

    ; if there are no bytes in the buffer, we're done.
    7E 82 01 00    ; jz r2 &flush_empty (+1)
    7E 00 01 00    ; jz 0 &flush_have_data (+1)
;:flush_empty
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret
;:flush_have_data

    ; get output_io_handle
    78 80 8E 28    ; ldw r0 rpp 0x28  ; output_io_handle

    ; call write_all
    7C 8A 00 00    ; ims ra <write_all
    7C 8A A0 0B    ; ims ra >write_all (0xBA0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; non-zero return value indicates error
    7E 80 06 00    ; jz r0 &flush_ok (+6)

    ; failed to write to output file. fatal
    7C 80 00 00    ; ims r0 <error_output_file
    7C 80 C0 00    ; ims r0 >error_output_file
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:flush_ok

    ; we don't reset the output pos here. it's reset in emit_byte.

    ; done
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1230



;==========================================
; [[noreturn] void end_parsing(void);
;==========================================
; Flushes the output, closes files, and exits with a success status (if no
; errors occurred.)
;==========================================

@0x1230 =end_parsing

    ; call flush
    7C 8A 00 00    ; ims ra <flush
    7C 8A A0 11    ; ims ra >flush (0x11A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address


    ; close output

    ; get output_io_handle
    78 80 8E 28    ; ldw r0 rpp 0x28  ; output_io_handle

    ; get syscall fclose into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 04 03   ; shl ra 4 3        ; ra = offset of fclose syscall (4<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fclose syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; high bit indicates error
    ; TODO any non-zero value should probably be considered an error
    77 8A 80 1F    ; shru ra r0 31
    7E 00 06 00    ; jz 0 &end_parsing_output_ok (+6)

    ; failed to close output file. fatal
;:end_parsing_output_fail
    7C 80 00 00    ; ims r0 <error_output_file
    7C 80 C0 00    ; ims r0 >error_output_file
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:end_parsing_output_ok


    ; close input

    ; get input_io_handle
    78 80 8E 24    ; ldw r0 rpp 0x24  ; input_io_handle

    ; get syscall fclose into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 04 03   ; shl ra 4 3        ; ra = offset of fclose syscall (4<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fclose syscall

    ; make the syscall
    78 89 87 04    ; ldw r9 r7 4      ; r9 = r9 of syscall
    71 8C 8C 04    ; sub rsp rsp 4    ; push return address
    70 8B 8F 08    ; add rb rip 8     ; ^^^
    79 8B 00 8C    ; stw rb 0 rsp     ; ^^^
    78 8F 87 00    ; ldw rip r7 0     ; rip = rip of syscall
    70 8C 8C 04    ; add rsp rsp 4    ; pop return address

    ; high bit indicates error
    77 8A 80 1F    ; shru ra r0 31
    7E 00 06 00    ; jz 0 &end_parsing_input_ok (+6)

    ; failed to close input file. fatal
;:end_parsing_input_fail
    7C 80 00 00    ; ims r0 <error_input_file
    7C 80 90 00    ; ims r0 >error_input_file (0x90)
    70 80 8E 80    ; add r0 rpp r0
    7C 8A 00 00    ; ims ra <fatal
    7C 8A 30 01    ; ims ra >fatal
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:end_parsing_input_ok



    ; tail-call exit(0)
    70 80 00 00    ; add r0 0 0    ; zero r0
    7C 8A 00 00    ; ims ra <exit
    7C 8A 70 0B    ; ims ra >exit (0xB70)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1320
