; format indicator `~Onr~amp~   `
7E 4F 6E 72   ; jz 79 29294
7E 61 6D 70   ; jz 97 28781
7E 20 20 20   ; jz 32 8224

; move process info table to r9
70 89 00 80   ; add r9 0 r0

; get syscall table into r8
78 88 89 08   ; ldw r8 r9 8

; set exit status to -1. the vm must truncate this to the low byte and treat it
; as unsigned, resulting in 255.
70 80 00 FF   ; add r0 0 -1

; load r9 and rip of exit function
; (note that we don't push a return address. exit doesn't return.)
78 89 88 04   ; ldw r9 r8 4   ; syscall exit r9
78 8F 88 00   ; ldw rip r8 0  ; syscall exit rip
