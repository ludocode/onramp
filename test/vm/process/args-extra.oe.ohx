; format indicator `~Onr~amp~   `
7E 4F 6E 72   ; jz 79 29294
7E 61 6D 70   ; jz 97 28781
7E 20 20 20   ; jz 32 8224

; move process info table to r9
70 89 00 80   ; add r9 0 r0

; get argv into r1
78 81 89 18   ; ldw r1 r9 24

; count the args into r2
70 82 00 00   ; add r2 0 0
78 8A 81 82   ; ldw ra r1 r2
7E 8A 02 00   ; jz ra 2
70 82 82 04   ; add r2 r2 4
7E 00 FC FF   ; jz 0 -4
77 82 82 02   ; shru r2 r2 2   ; divide by 4

; make sure we have 5 args
71 8A 82 05   ; sub ra r2 5
7E 8A 04 00   ; jz ra 4

; fail, exit 1
70 80 00 01   ; add r0 0 1    ; exit code 1
78 88 89 08   ; ldw r8 r9 8   ; syscall table
78 8E 88 04   ; ldw rpp r8 4  ; syscall exit rpp
78 8F 88 00   ; ldw rpp r8 0  ; syscall exit rip

;TODO check args

; success. exit 0
70 80 00 00   ; add r0 0 0    ; exit code 0
78 88 89 08   ; ldw r8 r9 8   ; syscall table
78 8E 88 04   ; ldw rpp r8 4  ; syscall exit rpp
78 8F 88 00   ; ldw rpp r8 0  ; syscall exit rip
