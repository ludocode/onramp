;==========================================
; [[noreturn]] void __start(uint32_t* process_info_table);
;==========================================
; The entry point of the program.
;==========================================

@0x00 =_start
    ; format indicator `~Onr~amp~   `
    7E 4F 6E 72   ; jz 79 29294
    7E 61 6D 70   ; jz 97 28781
    7E 20 20 20   ; jz 32 8224

    ; store process info table
    79 80 8E 20   ; stw r0 rpp 0x20

    ; jump to test
    70 8F 8E 60   ; add rip rpp 0x60

    ; padding
    00 00 00 00
    00 00 00 00
    00 00 00 00
@0x20



;==========================================
; uint32_t* process_info_table;
;==========================================

@0x20 =process_info_table
    00 00 00 00

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x30



;==========================================
; const char hello_world[];
;==========================================
; The null-terminated string to print.
;==========================================

@0x30 =hello_world
    48 65 6c 6c 6f  ; Hello
    20              ; <space>
    77 6f 72 6c 64  ; world
    21              ; !
    0a              ; \n
    00              ; null-terminator

    ; padding
    00 00
@0x40



;==========================================
; [[noreturn]] void exit(int);
;==========================================

@0x40 =exit

    ; push invalid return address on the stack in case exit returns
    71 8C 8C 04   ; sub rsp rsp 4
    79 FF 8C 00   ; stw -1 rsp 0    ; return address = 0xFFFFFFFF

    ; syscall exit
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    78 8E 88 04   ; ldw rpp r8 4      ; rpp = rpp of syscall exit
    78 8F 88 00   ; ldw rpp r8 0      ; rip = rip of syscall exit

    ; padding
    00 00 00 00 00 00 00 00
@0x60



;==========================================
; void test(void);
;==========================================
; vars:
;     - string position: r1, rfp-4
;     - bytes left: r2, rfp-8
;==========================================

@0x60 =test

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 08     ; sub rsp rsp 8

    ; get the string
    70 81 8E 30     ; add r1 rpp 0x30 (^hello_world)
    79 81 8D FC     ; stw r1 rfp -4

    ; get its length
    70 82 00 00     ; add r2 0 0   ; zero r1
;:test_length_loop
    7A 83 81 82     ; ldb r3 r1 r2
    7E 83 02 00     ; jz r3 &test_length_loop_exit (+?)
    70 82 82 01     ; add r2 r2 1
    7E 00 FC FF     ; jz 0 &test_length_loop (-4)
;:test_length_loop_exit
    79 82 8D F8     ; stw r2 rfp -8

    ; loop to write the string
;:test_write_loop

    ; args for fwrite(fd, string pos, bytes left);
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 80 89 10   ; ldw r0 r9 16      ; r0 = stdout
    78 81 8D FC   ; ldw r1 rfp -4     ; r1 = string postiion
    78 82 8D F8   ; ldw r2 rfp -8     ; r2 = bytes left

    ; get syscall fwrite into r7
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 06 03   ; shl ra 6 3        ; ra = offset of fwrite syscall (6<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fwrite syscall

    ; make the syscall (external call convention)
    71 8C 8C 08   ; sub rsp rsp 8     ; make stack space
    79 8E 8C 04   ; stw rpp rsp 4     ; preserve rpp
    78 8E 87 04   ; ldw rpp r7 4      ; rpp = syscall fwrite
    70 8A 8F 08   ; add ra rip 8      ; ra = return address
    79 8A 8C 00   ; stw ra rsp 0      ; store return address
    78 8F 87 00   ; ldw rpp r7 0      ; rip = syscall fwrite
    78 8E 8C 04   ; ldw rpp rsp 4     ; restore rpp
    70 8C 8C 08   ; add rsp rsp 8     ; free stack space

    ; check the high bit for error
    77 8A 80 1F   ; shru ra r0 31
    7E 8A 02 00   ; jz ra &test_write_no_error (+2)
    ; fail, exit(1)
    70 80 01 00   ; add r0 1 0
    70 8F 8E 40   ; add rip rpp ^exit (0x40)
;:test_write_no_error

    ; check if we got zero
    7E 80 01 00   ; jz r0 &test_write_zero (+1)
    7E 00 02 00   ; jz 0 &test_write_not_zero (+2)
;:test_write_zero
    ; zero bytes written. fail, exit(2)
    70 80 02 00   ; add r0 2 0
    70 8F 8E 40   ; add rip rpp ^exit (0x40)
;:test_write_not_zero

    ; check if we got too many bytes written
    78 82 8D F8   ; ldw r2 rfp -8     ; r2 = bytes left
    7D 8A 82 80   ; ltu ra r2 r0
    7E 8A 02 00   ; jz ra &test_write_not_too_large (+2)
    ; too many bytes written. fail, exit(3)
    70 80 03 00   ; add r0 3 0
    70 8F 8E 40   ; add rip rpp ^exit (0x40)
;:test_write_not_too_large

    ; adjust pointer and bytes remaining
    78 81 8D FC   ; ldw r1 rfp -4     ; r1 = string postiion
    70 81 81 80   ; add r1 r1 r0
    71 82 82 80   ; sub r2 r2 r0
    79 81 8D FC   ; stw r1 rfp -4
    79 82 8D F8   ; stw r2 rfp -8

    ; if bytes remaining is zero, we're done. otherwise loop
    7E 82 01 00   ; jz r2 &test_write_loop_exit (+1)
    7E 00 DD FF   ; jz 0 &test_write_loop (-35)

;:test_write_loop_exit

    ; success! exit(0)
    70 80 00 00   ; add r0 0 0
    70 8F 8E 40   ; add rip rpp ^exit (0x40)
