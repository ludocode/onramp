; format indicator `~Onr~amp~   `
7E 4F 6E 72   ; jz 79 29294
7E 61 6D 70   ; jz 97 28781
7E 20 20 20   ; jz 32 8224

; we put our data first and jump over it so we can access it with a single
; mix-type byte
7E 00 02 00  ; jz 0 2
@0x10
56 34 12 00  ; 0x123456
@0x14
BC 9A 78 56  ; 0x56789ABC

; move process info table to r9
70 89 00 80   ; add r9 0 r0

; push invalid return address on the stack in case exit returns
71 8C 8C 04   ; sub rsp rsp 4
79 FF 8C 00   ; stw -1 rsp 0    ; return address = 0xFFFFFFFF

; put 0x12 into r0, then insert 0x3456 using ims, make sure it matches our data
70 81 00 00   ; add r1 0 0   ; zero r1
70 81 00 12   ; add r1 0 0x12
7C 81 56 34   ; ims r1 0x3456
78 82 8E 10   ; ldw r2 rpp 0x10
71 8A 81 82   ; sub ra r1 r2
7E 8A 04 00   ; jz ra 4

; fail. exit 1
70 80 00 01   ; add r0 0 1    ; exit code 1
78 88 89 08   ; ldw r8 r9 8   ; syscall table
78 89 88 04   ; ldw r9 r8 4   ; syscall exit r9
78 8F 88 00   ; ldw rip r8 0  ; syscall exit rip

; load 0x56789ABC into r0 with double ims, make sure it matches our data
70 81 00 00   ; add r1 0 0   ; zero r1
7C 81 78 56   ; ims r1 0x1234    ; testing overflow
7C 81 78 56   ; ims r1 0x5678
7C 81 BC 9A   ; ims r1 0x9ABC
78 82 8E 14   ; ldw r2 rpp 0x14
71 8A 81 82   ; sub ra r1 r2
7E 8A 04 00   ; jz ra 4

; fail. exit 2
70 80 00 02   ; add r0 0 2    ; exit code 2
78 88 89 08   ; ldw r8 r9 8   ; syscall table
78 89 88 04   ; ldw r9 r8 4   ; syscall exit r9
78 8F 88 00   ; ldw rip r8 0  ; syscall exit rip

; success. exit 0
70 80 00 00   ; add r0 0 0    ; exit code 0
78 88 89 08   ; ldw r8 r9 8   ; syscall table
78 89 88 04   ; ldw r9 r8 4   ; syscall exit r9
78 8F 88 00   ; ldw rip r8 0  ; syscall exit rip
