@0x00 =__start
    ; format indicator `~Onr~amp~   `
    7E 4F 6E 72   ; jz 79 29294
    7E 61 6D 70   ; jz 97 28781
    7E 20 20 20   ; jz 32 8224

    ; store process info vector in r9
    70 89 80 00   ; add r9 r0 0

    ; load version
    78 81 89 00   ; ldw r1 r9 0

    ; make sure the version matches
    ; (set r0 to 0 if match, 1 if no match)
    71 81 81 02   ; sub r1 r1 2
    7D 80 00 81   ; ltu r0 0 r1    ; bool r0 r1

    ; syscall exit
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    78 8E 88 04   ; ldw rpp r8 4      ; rpp = rpp of syscall exit
    78 8F 88 00   ; ldw rpp r8 0      ; rip = rip of syscall exit
