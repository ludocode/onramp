    74 72 75 6e 63 3A 20 20  20 20 20 00 00 00 00 00  ; "trunc:     " '00
  ;  t  r  u  n  c  :                 \0

    5b 75 6e 75 73 65 64 5d  3a 20 20 00 00 00 00 00  ; "[unused]:  " '00   ; formerly dopen
  ;  [  u  n  u  s  e  d  ]   :       \0

    5b 75 6e 75 73 65 64 5d  3a 20 20 00 00 00 00 00  ; "[unused]:  " '00   ; formerly dclose
  ;  [  u  n  u  s  e  d  ]   :       \0

    64 69 72 65 6e 74 3A 20  20 20 20 00 00 00 00 00  ; "dirent:    " '00
  ;  d  i  r  e  n  t  :              \0

    73 74 61 74 3A 20 20 20  20 20 20 00 00 00 00 00  ; "stat:      " '00
  ;  s  t  a  t  :                    \0

    72 65 6e 61 6d 65 3A 20  20 20 20 00 00 00 00 00  ; "rename:    " '00
  ;  r  e  n  a  m  e  :              \0

    5b 75 6e 75 73 65 64 5d  3a 20 20 00 00 00 00 00  ; "[unused]:  " '00   ; formerly symlink
  ;  [  u  n  u  s  e  d  ]   :       \0

    75 6e 6c 69 6e 6b 3A 20  20 20 20 00 00 00 00 00  ; "unlink:    " '00
  ;  u  n  l  i  n  k  :              \0

    63 68 6d 6f 64 3A 20 20  20 20 20 00 00 00 00 00  ; "chmod:     " '00
  ;  c  h  m  o  d  :                 \0

    6d 6b 64 69 72 3A 20 20  20 20 20 00 00 00 00 00  ; "mkdir:     " '00
  ;  m  k  d  i  r  :                 \0

    5b 75 6e 75 73 65 64 5d  3a 20 20 00 00 00 00 00  ; "[unused]:  " '00   ; formerly rmdir
  ;  [  u  n  u  s  e  d  ]   :       \0

    5b 75 6e 75 73 65 64 5d  3a 20 20 00 00 00 00 00  ; "[unused]:  " '00   ; formerly spawn
  ;  [  u  n  u  s  e  d  ]   :       \0

    5b 75 6e 75 73 65 64 5d  3a 20 20 00 00 00 00 00  ; "[unused]:  " '00   ; formerly waitpid
  ;  [  u  n  u  s  e  d  ]   :       \0

    64 65 62 75 67 3A 20 20  20 20 20 00 00 00 00 00  ; "debug:     " '00
  ;  d  e  b  u  g  :                 \0

    61 6c 6c 6f 63 3A 20 20  20 20 20 00 00 00 00 00  ; "alloc:     " '00
  ;  a  l  l  o  c  :                 \0

    66 72 65 65 3A 20 20 20  20 20 20 00 00 00 00 00  ; "free:      " '00
  ;  f  r  e  e  :                    \0



    ; padding
    00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00  00 00 00 00 00 00 00 00
@0x2000



;==========================================
; void print_free_memory_regions(void);
;==========================================
; Print the contents of the free memory region list.
;
; vars:
;     index: rfp-4
;     total: rfp-8
;     loop_address: rfp-12
;==========================================

@0x2000 =print_free_memory_regions

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 0C     ; sub rsp rsp 12

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get string "Free Memory Regions: "
    7C 80 00 00    ; ims r0 <str_free_memory_regions
    7C 80 F0 0F    ; ims r0 >str_free_memory_regions (0xFF0)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the vm major version
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 00   ; ldw r8 r9 00      ; r8 = version

    ; check if major version is at least 4
    7E 88 02 00   ; jz r8 &print_free_memory_regions_v3 (+2)   ; skip ltu in v0
    7D 8B 88 04   ; ltu rb r8 3
    7E 8B 11 00   ; jz rb &print_free_memory_regions_v4 (+17)


;:print_free_memory_regions_v3
    ; version is less than 4. just print indented (none).

    ; call print_indentation(1)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get "(none)\n"
    7C 80 00 00    ; ims r0 <str_none
    7C 80 50 09    ; ims r0 >str_none (0x950)
    70 80 8E 80    ; add r0 rpp r0

    ; tail-call print_string()
    70 8C 8D 00    ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4   ; ^^^           ; ^^^
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump


;:print_free_memory_regions_v4


    ; Address

    ; call print_indentation(1)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get "Address: "
    7C 80 00 00    ; ims r0 <str_address
    7C 80 00 09    ; ims r0 >str_address (0x900)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the free memory region address
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 80 89 2C   ; ldw r0 r9 44      ; r0 = free regions

    ; call print_value()
    7C 8A 00 00    ; ims ra <print_value
    7C 8A A0 10    ; ims ra >print_value (0x10A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address


    ; Values

    ; call print_indentation(1)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get "Values: "
    7C 80 00 00    ; ims r0 <str_values
    7C 80 20 09    ; ims r0 >str_values (0x920)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the free memory region address again
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 80 89 2C   ; ldw r0 r9 44      ; r0 = free regions

    ; check if the address is null
    7E 80 01 00    ; jz r0 &print_free_memory_regions_null (+1)
    7E 00 0E 00    ; jz 0 &print_free_memory_regions_not_null (+14)

;:print_free_memory_regions_null
    ; address is null. get "(null)\n"
    7C 80 00 00    ; ims r0 <str_null
    7C 80 60 09    ; ims r0 >str_null (0x960)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; return  (r0 is 0)
    70 8C 8D 00   ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C   ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04   ; add rsp rsp 4   ; ^^^           ; ^^^
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret
;:print_free_memory_regions_not_null


    ; check if the first value is null
    78 80 80 00    ; ldw r0 r0 0
    7E 80 01 00    ; jz r0 &print_free_memory_regions_none (+1)
    7E 00 0E 00    ; jz 0 &print_free_memory_regions_not_none (+14)

;:print_free_memory_regions_none
    ; free memory regions array is empty. get "(none)\n"
    7C 80 00 00    ; ims r0 <str_none
    7C 80 50 09    ; ims r0 >str_none (0x950)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; return  (r0 is 0)
    70 8C 8D 00   ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C   ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04   ; add rsp rsp 4   ; ^^^           ; ^^^
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret
;:print_free_memory_regions_not_none


    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_free_memory_region_values
    7C 8A 00 00    ; ims ra <print_free_memory_region_values
    7C 8A 20 23    ; ims ra >print_free_memory_region_values (0x2320)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; count was returned. tail-call print_count()
    70 8C 8D 00   ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C   ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04   ; add rsp rsp 4   ; ^^^           ; ^^^
    7C 8A 00 00   ; ims ra <print_count
    7C 8A 90 18   ; ims ra >print_count (0x1890)
    70 8F 8E 8A   ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x2320



;==========================================
; void print_free_memory_region_values(void);
;==========================================
; Print the values list of the free memory regions section, returning the
; count.
;
; vars:
;     index: rfp-4
;     loop_address: rfp-8
;     address of current free region: rfp-12
;==========================================

@0x2320 =print_free_memory_region_values

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 0C     ; sub rsp rsp 12

    ; initialize index
    79 00 8D FC    ; stw 0 rfp -4

    ; store this address to loop
    79 8F 8D F8    ; stw rip rfp -8
;:print_free_memory_region_values_loop

    ; get the address of the current entry in the free memory region list
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 80 89 2C   ; ldw r0 r9 44      ; r0 = free regions
    78 8A 8D FC   ; ldw ra rfp -4     ; ra = index
    76 8A 8A 03   ; shl ra ra 3       ; ra = offset
    70 81 80 8A   ; add r1 r0 ra      ; r1 = address of entry
    79 81 8D F4   ; stw r1 rfp -12

    ; check if the address of the region is 0
    78 80 81 00   ; ldw r0 r1 0    ; r0 = address of free memory region
    7E 80 01 00   ; jz r0 &print_free_memory_region_values_done (+1)
    7E 00 05 00   ; jz 0 &print_free_memory_region_values_not_done (+5)

;print_free_memory_region_values_done
    ; found the null-terminator. return count
    78 80 8D FC     ; ldw r0 rfp -4
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;print_free_memory_region_values_not_done

    ; call print_indentation(2)
    70 80 00 02    ; add r0 0 2   ; mov r0 2
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get "Address: "
    7C 80 00 00    ; ims r0 <str_address
    7C 80 00 09    ; ims r0 >str_address (0x900)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the address of the current free memory region
    78 81 8D F4   ; ldw r1 rfp -12
    78 80 81 00   ; ldw r0 r1 0

    ; call print_hex()
    7C 8A 00 00    ; ims ra <print_hex
    7C 8A 40 0B    ; ims ra >print_hex (0xB40)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_indentation(1)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get "Size: "
    7C 80 00 00    ; ims r0 <str_size
    7C 80 70 09    ; ims r0 >str_size (0x970)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the size of the current free memory region
    78 81 8D F4   ; ldw r1 rfp -12
    78 80 81 04   ; ldw r0 r1 4

    ; call print_value()
    7C 8A 00 00    ; ims ra <print_value
    7C 8A A0 10    ; ims ra >print_value (0x10A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; print a newline, call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; increment the index
    78 81 8D FC   ; ldw r1 rfp -4
    70 81 81 01   ; add r1 r1 1   ; inc r1
    79 81 8D FC   ; stw r1 rfp -4

    ; load the loop address to loop
    78 8F 8D F8   ; ldw rip rfp -8    ; jump to print_registers_loop

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x24F0



;==========================================
; void print_syscall_table_contents(void);
;==========================================
; Prints the contents of the syscall table section (the Address, Count and
; Values fields.)
;
; The entries are printed by print_syscall_entries().
;==========================================

@0x24F0 =print_syscall_table_contents

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; call print_indentation(1)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get "Address: "
    7C 80 00 00    ; ims r0 <str_address
    7C 80 00 09    ; ims r0 >str_address (0x900)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the syscall table address
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 80 89 08   ; ldw r0 r9 8       ; r0 = syscall table

    ; call print_value()
    7C 8A 00 00    ; ims ra <print_value
    7C 8A A0 10    ; ims ra >print_value (0x10A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the number of syscall entries, call get_syscall_count()
    7C 8A 00 00    ; ims ra <get_syscall_count
    7C 8A 40 04    ; ims ra >get_syscall_count (0x440)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; store the count
    71 8C 8C 04    ; sub rsp rsp 4     ; push r1
    79 80 00 8C    ; stw r0 0 rsp      ; ^^^

    ; call print_count()
    ; (Note that we're printing the count here before the values, unlike with
    ; other lists where we print the count afterwards. This is intentional. For
    ; this table we know the size up-front so we print it first to reflect
    ; that. The other lists are null-terminated so we have to iterate through
    ; them before we know their size.)
    7C 8A 00 00    ; ims ra <print_count
    7C 8A 90 18    ; ims ra >print_count (0x1890)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_indentation(1)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get "Values: "
    7C 80 00 00    ; ims r0 <str_values
    7C 80 20 09    ; ims r0 >str_values (0x920)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; tail-call print_syscall_entries(count)
    78 80 00 8C    ; ldw r0 0 rsp
    70 8C 8D 00    ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4   ; ^^^           ; ^^^
    7C 8A 00 00    ; ims ra <print_syscall_entries
    7C 8A 20 03    ; ims ra >print_syscall_entries (0x320)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x26C0



    ; We add 256 bytes of padding at the end of the program in case the program
    ; and heap/stack are adjacent and the VM has not provided enough stack
    ; space. We'll print a warning if the heap/stack space is insufficient.
    ; TODO check and print the warning
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
