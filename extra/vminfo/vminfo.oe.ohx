@0x10A0



;==========================================
; void print_value(unsigned);
;==========================================
; Prints a value in both hexadecimal and decimal.
;==========================================

@0x10A0 =print_value

    ; store the value
    71 8C 8C 04    ; sub rsp rsp 4     ; push r0
    79 80 00 8C    ; stw r0 0 rsp      ; ^^^

    ; call print_hex
    7C 8A 00 00    ; ims ra <print_hex
    7C 8A 40 0B    ; ims ra >print_hex (0xB40)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; restore the value
    78 80 00 8C    ; ldw r0 0 rsp      ; pop r0
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^

    ; tail-call print_decimal_parens
    7C 8A 00 00    ; ims ra <print_decimal_parens
    7C 8A 80 0D    ; ims ra >print_decimal_parens (0xD80)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x10F0



;==========================================
; void print_pit_entry(const char* str, int index);
;==========================================
; Print the entry with the given index in the process info table.
;==========================================

@0x10F0 =print_pit_entry

    ; store the index
    71 8C 8C 04    ; sub rsp rsp 4     ; push r1
    79 81 00 8C    ; stw r1 0 rsp      ; ^^^

    ; store the string
    71 8C 8C 04    ; sub rsp rsp 4     ; push r1
    79 80 00 8C    ; stw r0 0 rsp      ; ^^^

    ; call print_indentation(1)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; restore the string
    78 80 00 8C    ; ldw r0 0 rsp      ; pop r0
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; restore the index
    78 80 00 8C    ; ldw r0 0 rsp      ; pop r0
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^

    ; load the value in the pit
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    72 80 80 04   ; mul r0 r0 4       ; r0 *= 4
    78 80 89 80   ; ldw r0 r9 r0

    ; call print_value()
    7C 8A 00 00    ; ims ra <print_value
    7C 8A A0 10    ; ims ra >print_value (0x10A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; tail-call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x11A0



;==========================================
; const char str_process_info_table[];
;==========================================

@0x11A0 =str_process_info_table
    ; "Process Info Table:" '0A '00
    50 72 6f 63 65 73 73 20  49 6e 66 6f 20 54 61 62
  ;  P  r  o  c  e  s  s     I  n  f  o      T  a  b
    6c 65 3A 0A 00 00 00 00  00 00 00 00 00 00 00 00
  ;  l  e  : \n \0
@0x11C0



;==========================================
; void print_pit(void);
;==========================================
; Print the contents of the process info table.
;
; vars:
;     index: rfp-4
;     total: rfp-8
;     loop_address: rfp-12
;==========================================

@0x11C0 =print_pit

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 0C     ; sub rsp rsp 12

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get string "Process Info Table"
    7C 80 00 00    ; ims r0 <str_process_info_table
    7C 80 A0 11    ; ims r0 >str_process_info_table (0x11A0)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call fixup_pit_header_names()
    7C 8A 00 00    ; ims ra <fixup_pit_header_names
    7C 8A 40 13    ; ims ra >fixup_pit_header_names (0x1340)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; It returned the number of entries in the pit.
    ; Initialize vars
    79 80 8D F8    ; stw r0 rfp -8   ; total
    79 00 8D FC    ; stw 0 rfp -4    ; index

    ; store this address to loop
    79 8F 8D F4    ; stw rip rfp -12
;:print_pit_loop

    ; check if we've printed the whole table
    78 80 8D F8    ; ldw r0 rfp -8   ; total
    78 81 8D FC    ; ldw r1 rfp -4   ; index
    71 82 80 81    ; sub r2 r0 r1
    7E 82 01 00    ; jz r2 &print_pit_done (+1)
    7E 00 04 00    ; jz 0 &print_pit_not_done (+4)

;:print_pit_done
    ; we're done. return
    70 8C 8D 00   ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C   ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04   ; add rsp rsp 4   ; ^^^           ; ^^^
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret
;:print_pit_not_done

    ; get the header name
    7C 8A 00 00    ; ims ra <pit_header_names
    7C 8A C0 08    ; ims ra >pit_header_names (0x8C0)
    70 8A 8E 8A    ; add ra rpp ra
    72 8B 81 04    ; mul rb r1 4
    78 80 8A 8B    ; ldw r0 ra rb
    70 80 8E 80    ; add r0 rpp r0

    ; call print_pit_entry()
    7C 8A 00 00    ; ims ra <print_pit_entry
    7C 8A F0 10    ; ims ra >print_pit_entry (0x10F0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; increment the index
    78 80 8D FC    ; ldw r0 rfp -4    ; index
    70 80 80 01    ; add r0 r0 1   ; inc r0
    79 80 8D FC    ; stw r0 rfp -4    ; index

    ; load the loop address to loop
    78 8F 8D F4   ; ldw rip rfp -12    ; jump to print_pit_loop

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
    00 00 00 00
@0x1340



;==========================================
; void fixup_pit_header_names(void);
;==========================================
; Correct the pit_header_names based on the VM version and return the number of
; entries to print.
;==========================================

@0x1340 =fixup_pit_header_names

    ; Get the header names array
    7C 80 00 00    ; ims r0 <pit_header_names
    7C 80 C0 08    ; ims r0 >pit_header_names (0x8C0)
    70 80 8E 80    ; add r0 rpp r0

    ; Get the version
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 00   ; ldw r8 r9 00      ; r8 = version

    ; Check if the version is under 4
    7D 87 88 04   ; ltu/cmpu r7 r8 4
    ; cmpu workaround: convert cmpu to ltu
    78 8B 8E 2C   ; ldw rb rpp 0x2C    ; cmpu_instruction
    7E 8B 04 00   ; jz rb +4
    70 87 87 01   ; add r7 r7 1
    7E 87 01 00   ; jz r7 +1       ; isz r7 r7
    70 87 00 01   ; add r7 0 1     ; ^^^
    71 87 01 87   ; sub r7 1 r7    ; ^^^

    ; For version 4 and later, the first entry is "Major Version"; otherwise
    ; it's just "Version".
    7E 87 03 00   ; jz r7 &fixup_pit_header_names_major_version (+7)
    7C 81 00 00   ; ims r1 <str_version
    7C 81 60 0E   ; ims r1 >str_version (0xE60)
    79 81 80 00   ; stw r1 r0 0
;:fixup_pit_header_names_major_version

    ; For version 2 and later, the third entry is called "Syscall Table
    ; Address"; before that it was "Exit Address".
    7E 88 03 00   ; jz r8 +3
    71 8A 88 01   ; sub ra r8 1
    7E 8A 01 00   ; jz ra +1
    7E 00 03 00   ; jz 0 +3
    7C 81 00 00   ; ims r1 <str_exit_address
    7C 81 D0 0E   ; ims r1 >str_exit_address (0xED0)
    79 81 80 08   ; stw r1 r0 8

    ; Version 3 had "System Call Count" and "Process Info Count" fields.
    71 87 88 03   ; sub r7 r8 3
    7E 87 01 00   ; jz r7 &fixup_pit_header_names_counts (+1)
    7E 00 06 00   ; jz 0 &fixup_pit_header_names_no_counts (+6)
;:fixup_pit_header_names_counts
    7C 81 00 00   ; ims r1 <str_system_call_count
    7C 81 B0 0F   ; ims r1 >str_system_call_count (0xFB0)
    79 81 80 28   ; stw r1 r0 40
    7C 81 00 00   ; ims r1 <str_process_info_count
    7C 81 D0 0F   ; ims r1 >str_process_info_count (0xFD0)
    79 81 80 2C   ; stw r1 r0 44
;:fixup_pit_header_names_no_counts

    ; Get the pit length.
    ; - Version 0, 1 and 2: length is 10
    ; - Version 3 and later: length is 12
    7E 88 05 00   ; jz r8 &fixup_pit_header_names_10 (+5)
    71 87 88 01   ; sub r7 r8 1
    7E 87 03 00   ; jz r7 &fixup_pit_header_names_10 (+3)
    71 87 88 02   ; sub r7 r8 2
    7E 87 01 00   ; jz r7 &fixup_pit_header_names_10 (+1)
    7E 00 02 00   ; jz 0 &fixup_pit_header_names_12 (+2)

;:fixup_pit_header_names_10
    ; return 10
    70 80 00 0A   ; add r0 0 10     ; mov r0 10
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret

;:fixup_pit_header_names_12
    ; return 12
    70 80 00 0C   ; add r0 0 12     ; mov r0 12
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00

@0x1410



;==========================================
; void print_syscall_table(void);
;==========================================
; Print the system call table section.
;
; Most of the work is done by print_syscall_table_contents(); this mostly just
; has fallbacks for older VMs.
;==========================================

@0x1410 =print_syscall_table

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get string "System Call Table: "
    7C 80 00 00    ; ims r0 <str_system_call_table
    7C 80 B0 0E    ; ims r0 >str_system_call_table (0xEB0)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; check if we have a syscall table
    78 8B 8E 28   ; ldw rb rpp 0x28    ; sys_instruction
    7E 8B 11 00   ; jz rb &print_syscall_table_have_table (+17)


    ; VM uses a sys instruction; there's no table. just print indented (none).

    ; call print_indentation(1)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get "(none)\n"
    7C 80 00 00    ; ims r0 <str_none
    7C 80 50 09    ; ims r0 >str_none (0x950)
    70 80 8E 80    ; add r0 rpp r0

    ; tail-call print_string()
    70 8C 8D 00    ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4   ; ^^^           ; ^^^
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump


;:print_syscall_table_have_table

    ; tail-call print_syscall_table_contents()
    70 8C 8D 00    ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C    ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04    ; add rsp rsp 4   ; ^^^           ; ^^^
    7C 8A 00 00    ; ims ra <print_syscall_table_contents
    7C 8A F0 24    ; ims ra >print_syscall_table_contents (0x24F0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1540



;==========================================
; void print_syscall_entry(int index);
;==========================================
; Print the entry with the given index in the system call table.
;==========================================

@0x1540 =print_syscall_entry

    ; store the index
    71 8C 8C 04    ; sub rsp rsp 4     ; push r1
    79 80 00 8C    ; stw r0 0 rsp      ; ^^^

    ; call print_indentation(2)
    70 80 00 02    ; add r0 0 2   ; mov r0 2
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the vm major version
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 00   ; ldw r8 r9 00      ; r8 = version

    ; choose syscall name table based on version
    7C 8A 00 00   ; ims ra '00 '00
    7E 88 02 00   ; jz r8 &print_syscall_entry_v3 (+2)   ; skip ltu in v0
    7D 8B 88 04   ; ltu rb r8 3
    7E 8B 02 00   ; jz rb &print_syscall_entry_v4 (+2)
;:print_syscall_entry_v3
    7C 8A 50 1C    ; ims ra >syscall_names_v3 (0x1C50)
    7E 00 01 00    ; jz 0 &print_syscall_entry_version_done (+1)
;:print_syscall_entry_v4
    7C 8A E0 1D    ; ims ra >syscall_names_v4 (0x1DE0)
;:print_syscall_entry_version_done

    ; get the syscall name
    78 80 00 8C    ; ldw r0 0 rsp   ; index
    70 8A 8E 8A    ; add ra rpp ra
    72 8B 80 10    ; mul rb r0 16
    70 80 8A 8B    ; add r0 ra rb

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_register_name(RIP)
    70 80 00 0F    ; add r0 0 15    ; mov r0 15
    7C 8A 00 00    ; ims ra <print_register_name
    7C 8A F0 00    ; ims ra >print_register_name (0xF0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the rip value of the syscall
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    78 8B 00 8C   ; ldw rb 0 rsp      ; rb = index
    76 8A 8B 03   ; shl ra rb 3       ; ra = offset of syscall
    78 80 88 8A   ; ldw r0 r8 ra      ; r0 = rip of syscall

    ; call print_hex()
    7C 8A 00 00    ; ims ra <print_hex
    7C 8A 40 0B    ; ims ra >print_hex (0xB40)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_indentation(1)
    ; (doesn't make sense to print indentation here but we just want spaces)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_register_name(R9)
    70 80 00 09    ; add r0 0 9    ; mov r0 9
    7C 8A 00 00    ; ims ra <print_register_name
    7C 8A F0 00    ; ims ra >print_register_name (0xF0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the r9 value of the syscall
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    78 8B 00 8C   ; ldw rb 0 rsp      ; rb = index
    76 8A 8B 03   ; shl ra rb 3       ; ra = offset of syscall
    70 8A 8A 04   ; add ra ra 4       ; ra = offset of r9 of syscall
    78 80 88 8A   ; ldw r0 r8 ra      ; r0 = r9 of syscall

    ; call print_value()
    7C 8A 00 00    ; ims ra <print_value
    7C 8A A0 10    ; ims ra >print_value (0x10A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; done
    70 8C 8C 04    ; add rsp rsp 4   ; popd
    78 8F 00 8C    ; ldw rip 0 rsp   ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x16C0



;==========================================
; void print_args(void);
;==========================================
; Print the command-line arguments.
;==========================================

@0x16C0 =print_args

    ; get str_command_line_arguments
    7C 80 00 00    ; ims r0 <str_command_line_arguments
    7C 80 40 0F    ; ims r0 >str_command_line_arguments (0xF40)
    70 80 8E 80    ; add r0 rpp r0

    ; get args address
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 81 89 18   ; ldw r1 r9 24      ; command-line args

    ; tail-call print_string_array
    7C 8A 00 00    ; ims ra <print_string_array
    7C 8A 20 17    ; ims ra >print_string_array (0x1720)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x16F0



;==========================================
; void print_env(void);
;==========================================
; Print the environment variables.
;==========================================

@0x16F0 =print_env

    ; get str_environment_variables
    7C 80 00 00    ; ims r0 <str_environment_variables
    7C 80 60 0F    ; ims r0 >str_environment_variables (0xF60)
    70 80 8E 80    ; add r0 rpp r0

    ; get env vars address
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 81 89 1C   ; ldw r1 r9 28      ; env vars

    ; tail-call print_string_array
    7C 8A 00 00    ; ims ra <print_string_array
    7C 8A 20 17    ; ims ra >print_string_array (0x1720)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x1720



;==========================================
; void print_string_array(const char* title, const char** values);
;==========================================
; Print an array of strings with the given title.
;
; This is used to print command-line arguments and environment variables.
;
; We print the values before printing the count because getting the count
; requires walking the array. If the array is invalid (for example missing a
; null-terminator), we may crash before printing anything. Instead we print the
; values first so that if there is a bad value we'll crash when actually trying
; to print it.
;
; vars:
;     values: rfp-4
;     count: rfp-8
;==========================================

@0x1720 =print_string_array

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 08     ; sub rsp rsp 8

    ; store values
    79 81 8D FC    ; stw r1 rfp -4

    ; push the title
    71 8C 8C 04    ; sub rsp rsp 4     ; push r0
    79 80 00 8C    ; stw r0 0 rsp      ; ^^^

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; pop the title
    78 80 00 8C    ; ldw r0 0 rsp      ; pop r0
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_indentation(1)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get "Address: "
    7C 80 00 00    ; ims r0 <str_address
    7C 80 00 09    ; ims r0 >str_address (0x900)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_value(values)
    78 80 8D FC    ; ldw r0 rfp -4   ; values
    7C 8A 00 00    ; ims ra <print_value
    7C 8A A0 10    ; ims ra >print_value (0x10A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_string_array_values(values)
    78 80 8D FC    ; ldw r0 rfp -4   ; values
    7C 8A 00 00    ; ims ra <print_string_array_values
    7C 8A 70 19    ; ims ra >print_string_array_values (0x1970)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; count was returned. tail-call print_count()
    70 8C 8D 00   ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C   ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04   ; add rsp rsp 4   ; ^^^           ; ^^^
    7C 8A 00 00   ; ims ra <print_count
    7C 8A 90 18   ; ims ra >print_count (0x1890)
    70 8F 8E 8A   ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00

@0x1890



;==========================================
; void print_count(int count);
;==========================================
; Prints indented "Count: " and the given count.
;
; vars:
;     count: rfp-4
;==========================================

@0x1890 =print_count

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 04     ; sub rsp rsp 4

    ; store the count
    79 80 8D FC    ; stw r0 rfp -4  ; count

    ; call print_indentation(1)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get "Count"
    7C 80 00 00    ; ims r0 <str_count
    7C 80 10 09    ; ims r0 >str_count (0x910)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_decimal(count)
    78 80 8D FC    ; ldw r0 rfp -4  ; count
    7C 8A 00 00    ; ims ra <print_decimal
    7C 8A B0 0C    ; ims ra >print_decimal (0xCB0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; done
    70 8C 8D 00   ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C   ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04   ; add rsp rsp 4   ; ^^^           ; ^^^
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1970



;==========================================
; void print_string_array_values(const char** values);
;==========================================
; Print the values portion of a string array.
;
; This is used to print command-line arguments and environment variables.
;
; vars:
;     values: rfp-4
;     count: rfp-8
;     loop_address: rfp-12
;==========================================

@0x1970 =print_string_array_values

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 0C     ; sub rsp rsp 12

    ; initialize vars
    79 80 8D FC    ; stw r0 rfp -4
    79 00 8D F8    ; stw 0 rfp -8
    79 00 8D F4    ; stw 0 rfp -12

    ; call print_indentation(1)
    70 80 00 01    ; add r0 0 1   ; mov r0 1
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get "Values: "
    7C 80 00 00    ; ims r0 <str_values
    7C 80 20 09    ; ims r0 >str_values (0x920)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address


    ; check if the address is null
    78 80 8D FC    ; ldw r0 rfp -4
    7E 80 01 00    ; jz r0 &print_string_array_values_null (+1)
    7E 00 0E 00    ; jz 0 &print_string_array_values_not_null (+14)

;:print_string_array_values_null
    ; address is null. get "(null)\n"
    7C 80 00 00    ; ims r0 <str_null
    7C 80 60 09    ; ims r0 >str_null (0x960)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; return  (r0 is 0)
    70 8C 8D 00   ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C   ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04   ; add rsp rsp 4   ; ^^^           ; ^^^
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret
;:print_string_array_values_not_null


    ; check if the first value is null
    78 80 80 00    ; ldw r0 r0 0
    7E 80 01 00    ; jz r0 &print_string_array_values_none (+1)
    7E 00 0E 00    ; jz 0 &print_string_array_values_not_none (+14)

;:print_string_array_values_none
    ; arguments array is empty. get "(none)\n"
    7C 80 00 00    ; ims r0 <str_none
    7C 80 50 09    ; ims r0 >str_none (0x950)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; return  (r0 is 0)
    70 8C 8D 00   ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C   ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04   ; add rsp rsp 4   ; ^^^           ; ^^^
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret
;:print_string_array_values_not_none


    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; store this address to loop
    79 8F 8D F4    ; stw rip rfp -12
;:print_string_array_values_loop

    ; get the next value
    78 80 8D FC    ; ldw r0 rfp -4
    78 81 8D F8    ; ldw r1 rfp -8
    72 81 81 04    ; mul r1 r1 4
    78 80 80 81    ; ldw r0 r0 r1

    ; check if we found the null-terminator
    7E 80 01 00    ;  jz r0 &print_string_array_values_done (+1)
    7E 00 05 00    ;  jz 0 &print_string_array_values_not_done (+5)

;:print_string_array_values_done
    ; return count
    78 80 8D F8    ; ldw r0 rfp -8
    70 8C 8D 00   ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C   ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04   ; add rsp rsp 4   ; ^^^           ; ^^^
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret
;:print_string_array_values_not_done

    ; call print_indentation(2)
    70 80 00 02    ; add r0 0 2   ; mov r0 2
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the next value again
    78 80 8D FC    ; ldw r0 rfp -4
    78 81 8D F8    ; ldw r1 rfp -8
    72 81 81 04    ; mul r1 r1 4
    78 80 80 81    ; ldw r0 r0 r1

    ; call print_value()
    7C 8A 00 00    ; ims ra <print_value
    7C 8A A0 10    ; ims ra >print_value (0x10A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get ": "
    7C 80 00 00    ; ims r0 <str_colon
    7C 80 F0 08    ; ims r0 >str_colon (0x8F0)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; get the next value again
    78 80 8D FC    ; ldw r0 rfp -4
    78 81 8D F8    ; ldw r1 rfp -8
    72 81 81 04    ; mul r1 r1 4
    78 80 80 81    ; ldw r0 r0 r1

    ; call print_string()
    ; TODO should probably escape it
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_char('\n')
    70 80 0A 00    ; add r0 "\n" 0     ; mov r0 "\n"
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; bump the count
    78 81 8D F8    ; ldw r1 rfp -8
    70 81 81 01    ; add r1 r1 1   ; inc r1
    79 81 8D F8    ; stw r1 rfp -8

    ; load the loop address to loop
    78 8F 8D F4   ; ldw rip rfp -12    ; jump to print_string_array_values_loop

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1BE0



;==========================================
; void print_indentation(int depth);
;==========================================
; Prints indentation of the given depth.
;==========================================

@0x1BE0 =print_indentation

    ; if depth is zero, return
    7E 80 01 00    ; jz r0 &print_indentation_zero (+1)
    7E 00 01 00    ; jz 0 &print_indentation_not_zero (+1)
;:print_indentation_zero
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret
;:print_indentation_not_zero

    ; push the depth
    71 8C 8C 04    ; sub rsp rsp 4     ; push r0
    79 80 00 8C    ; stw r0 0 rsp      ; ^^^

    ; get indentation
    7C 80 00 00    ; ims r0 <str_indentation
    7C 80 B0 07    ; ims r0 >str_indentation (0x7B0)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; pop the depth
    78 80 00 8C    ; ldw r0 0 rsp      ; pop r0
    70 8C 8C 04    ; add rsp rsp 4     ; ^^^

    ; decrement it
    71 80 80 01    ; sub r0 r0 1

    ; recurse
    7C 8A 00 00    ; ims ra <print_indentation
    7C 8A E0 1B    ; ims ra >print_indentation (0x1BE0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x1C50



