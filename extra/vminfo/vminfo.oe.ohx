; This is the Onramp vminfo tool.
;
; It prints information about the VM environment.
;
; All versions of the Onramp VM spec are supported. As long as the VM declares
; its version correctly in the process info table, this tool will work around
; differences between VM versions.
;
; (Note that version 0 was still experimental and underwent several changes
; without a version bump. This supports the "final" iteration of version 0,
; with contiguous syscall numbers (fwrite is 6) but before the xor, ror and
; cmpu instructions were replaced. It is not possible to detect whether fwrite
; is 6 or 19 so there is no way to automatically support both.)



; Implementation details:
;
; The entry point is more complicated than most programs because we need to
; preserve the initial register states. Some of them change immediately (like
; rip) and others we need to change to store anything (like rsp) so we have to
; recompute their original values. See __start() and __start_2().
;
; At startup we check the VM version and set several flags (`sys_instruction`,
; `cmpu_instruction`, etc.) on old versions. These flags are used wherever we
; need to apply workarounds.
;
; Left shifts didn't exist on VM version 0 so we avoid them except in contexts
; where we know the version is newer. For right shifts, the instruction was
; rotate on version 0, so we mask off the bits before or after running the
; instruction. This is harmless on newer VMs so we do it unconditionally.
;
; The tool is buffered like hex/0-onramp but it flushes on newlines and colons.
; We do this in case it crashes: it makes it obvious what the program was
; trying to do which may help debug the VM.



; symbol table:
;  addr  name
;     0  __start
;    20  process_info_table
;    24  initial_register_values
;    2C  cmpu_instruction
;    3C  output_buffer_pos
;    80  __start_2
;   140  main
;   2A0  output_buffer
;   320  print_syscall_entries
;   3B0  check_version
;   440  get_syscall_count
;   4A0  print_char
;   540  flush
;   5D0  syscall_exit
;   640  initialize
;   6A0  write_all
;   790  str_initial_register_values
;   7B0  str_indentation
;   7C0  print_string
;   860  print_register_name
;   8C0  pit_header_names
;   8F0  str_colon
;   900  str_address
;   910  str_count
;   920  str_values
;   950  str_none
;   960  str_null
;   970  str_size
;   9B0  print_registers
;   B40  print_hex
;   C60  int_to_hex
;   CB0  print_decimal
;   D80  print_decimal_parens
;   E60  str_version
;   E70  str_major_version
;   E80  str_minor_version
;   E90  str_heap_start
;   EB0  str_system_call_table
;   ED0  str_exit_address
;   EE0  str_input_stream_handle
;   F00  str_output_stream_handle
;   F20  str_error_stream_handle
;   F40  str_command_line_arguments
;   F60  str_environment_variables
;   F80  str_working_directory
;   FA0  str_capabilities
;   FB0  str_system_call_count
;   FD0  str_process_info_count
;   FF0  str_free_memory_regions
;  1010  str_major_version_not_supported
;  1040  str_minor_version_not_supported
;  10A0  print_value
;  10F0  print_pit_entry
;  11A0  str_process_info_table
;  11C0  print_pit
;  1340  fixup_pit_header_names
;  1410  print_syscall_table
;  1540  print_syscall_entry
;  16C0  print_args
;  16F0  print_env
;  1720  print_string_array
;  1890  print_count
;  1970  print_string_array_values
;  1BE0  print_indentation
;  1C50  syscall_names_v3
;  1DE0  syscall_names_v4
;  2000  print_free_memory_regions
;  2320  print_free_memory_region_values
;  24F0  print_syscall_table_contents



;==========================================
; [[noreturn]] void __start(uint32_t* process_info_table);
;==========================================
; The entry point. This must come first.
;
; The start process is fairly large because we want to preserve the exact
; initial state of all registers. We want small addresses to be available for
; quick access to global variables (since they fit in a mix-type byte) so we
; jump directly to 0x80 __start_2().
;==========================================

@0x00 =__start

    ; format indicator "~Onr~amp~   "
    7E 4F 6E 72   ; jz 79 29294
    7E 61 6D 70   ; jz 97 28781
    7E 20 20 20   ; jz 32 8224

    ; jump by +0x70 to go directly to 0x80 start_2(). this saves the region
    ; from 0x10 to 0x80 for global variables.
    70 8F 8F 70   ; add rip rip 0x70
@0x10



    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00



;==========================================
; uint32_t* process_info_table;
;==========================================

@0x20 =process_info_table
    00 00 00 00
@0x24



;==========================================
; uint32_t* initial_register_values;
;==========================================

@0x24 =initial_register_values
    00 00 00 00
@0x28



;==========================================
; int sys_instruction;
;==========================================
; Whether the VM uses a sys instruction instead of the syscall table.
;
; This is 1 for version 0 and 1 VMs, and 0 for versions 2 and later.
;==========================================

@0x28 =sys_instruction
    00 00 00 00
@0x2C



;==========================================
; int cmpu_instruction;
;==========================================
; Whether the VM uses cmpu instead of ltu as a comparison instruction.
;
; This is 1 for version 0 VMs, and 0 for versions 1 and later.
;==========================================

@0x2C =cmpu_instruction
    00 00 00 00
@0x30



    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00



;==========================================
; char* output_buffer_pos;
;==========================================
; The position of the next byte to be written to the output buffer.
;
; This is a pointer into output_buffer. If this is pointing to the start of
; output_buffer, the buffer is empty.
;==========================================

@0x3C =output_buffer_pos
    00 00 00 00
@0x40



    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00



;==========================================
; [[noreturn]] void __start_2(uint32_t* process_info_table);
;==========================================
; The continuation of the entry point. This must be at exactly 0x80; it cannot
; be moved.
;
; All registers are first pushed to the stack to preserve their initial values.
; We then forward control over to main(), which is an ordinary function that
; can be placed anywhere.
;==========================================

@0x80 =__start_2

    ; make stack space and store r0
    71 8C 8C 40    ; sub rsp rsp 64
    79 80 8C 00    ; stw r0 rsp 0

    ; we can now use r0 to calculate and store our original rip and rsp
    71 80 8F 0C    ; sub r0 rip 12    ; subtract instructions up to this point in __start_2
    71 80 80 40    ; sub r0 r0 40     ; subtract the address of __start_2
    71 80 80 40    ; sub r0 r0 40     ;    (0x80 is too large to fit in a mix-type byte)
    79 80 8C 3C    ; stw r0 rsp 60    ; store original rip
    70 80 8C 40    ; add r0 rsp 64
    79 80 8C 30    ; stw r0 rsp 48    ; store original rsp

    ; store the rest of our registers
    79 81 8C 04    ; stw r1 rsp 4
    79 82 8C 08    ; stw r2 rsp 8
    79 83 8C 0C    ; stw r3 rsp 12
    79 84 8C 10    ; stw r4 rsp 16
    79 85 8C 14    ; stw r5 rsp 20
    79 86 8C 18    ; stw r6 rsp 24
    79 87 8C 1C    ; stw r7 rsp 28
    79 88 8C 20    ; stw r8 rsp 32
    79 89 8C 24    ; stw r9 rsp 36
    79 8A 8C 28    ; stw ra rsp 40
    79 8B 8C 2C    ; stw rb rsp 44
    79 8D 8C 34    ; stw rfp rsp 52
    79 8E 8C 38    ; stw rpp rsp 56

    ; tail-call main(), passing the register array as argument
    70 80 8C 00   ; add r0 rsp 0     ; mov r0 rsp
    7C 8A 00 00   ; ims ra <main
    7C 8A 40 01   ; ims ra >main (0x140)
    70 8F 8E 8A   ; add rip rpp ra        ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00
@0xF0




;==========================================
; void print_register_name(int index);
;==========================================
; Prints the name of the given register with a ": " suffix and alignment
; spacing.
;==========================================

@0xF0 =print_register_name

    ; get the register name
    72 80 80 06    ; mul r0 r0 6
    7C 8A 00 00    ; ims ra <register_name
    7C 8A 60 08    ; ims ra >register_name (0x860)
    70 8A 8E 8A    ; add ra rpp ra
    70 80 8A 80    ; add r0 ra r0

    ; tail-call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x140



;==========================================
; [[noreturn]] void main(uint32_t* initial_register_values);
;==========================================

@0x140 =main

    ; call initialize()
    7C 8A 00 00    ; ims ra <initialize
    7C 8A 40 06    ; ims ra >initialize (0x640)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call check_version()
    7C 8A 00 00    ; ims ra <check_version
    7C 8A B0 03    ; ims ra >check_version (0x3B0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_pit()
    7C 8A 00 00    ; ims ra <print_pit
    7C 8A C0 11    ; ims ra >print_pit (0x11C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_syscall_table()
    7C 8A 00 00    ; ims ra <print_syscall_table
    7C 8A 10 14    ; ims ra >print_syscall_table (0x1410)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_registers()
    7C 8A 00 00    ; ims ra <print_registers
    7C 8A B0 09    ; ims ra >print_registers (0x9B0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_args()
    7C 8A 00 00    ; ims ra <print_args
    7C 8A C0 16    ; ims ra >print_args (0x16C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_env()
    7C 8A 00 00    ; ims ra <print_env
    7C 8A F0 16    ; ims ra >print_env (0x16F0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; call print_free_memory_regions()
    7C 8A 00 00    ; ims ra <print_free_memory_regions
    7C 8A 00 20    ; ims ra >print_free_memory_regions (0x2000)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; TODO move flush and syscall to exit() function, use it also for errors
    ; call flush()
    7C 8A 00 00    ; ims ra <flush
    7C 8A 40 05    ; ims ra >flush (0x540)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; tail-call syscall_exit(0)
    70 80 00 00    ; add r0 0 0     ; zero r0
    7C 8A 00 00    ; ims ra <syscall_exit
    7C 8A D0 05    ; ims ra >syscall_exit (0x5D0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x2A0




;==========================================
; char output_buffer[128];
;==========================================
; The output buffer.
;
; output_buffer_pos points into this buffer. The portion of the buffer that
; contains data is the range from the start of this buffer to the pointer.
;
; This is hardcoded so we don't have to allocate anything. We're line buffered
; so the buffer doesn't need to be very big.
;==========================================

@0x2A0
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00    00 00 00 00 00 00 00 00
@0x320



;==========================================
; void print_syscall_entries(int count);
;==========================================
; Prints the entries in the system call table.
;
; vars:
;     index: rfp-4
;     total: rfp-8
;     loop_address: rfp-12
;==========================================

@0x320 =print_syscall_entries

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 0C     ; sub rsp rsp 12

    ; initialize vars
    79 80 8D F8    ; stw r0 rfp -8   ; total
    79 00 8D FC    ; stw 0 rfp -4    ; index

    ; store this address to loop
    79 8F 8D F4    ; stw rip rfp -12
;:print_syscall_table_loop

    ; check if we've printed the whole table
    78 81 8D F8    ; ldw r1 rfp -8   ; total
    78 80 8D FC    ; ldw r0 rfp -4   ; index
    71 82 80 81    ; sub r2 r0 r1
    7E 82 01 00    ; jz r2 &print_syscall_table_done (+1)
    7E 00 04 00    ; jz 0 &print_syscall_table_not_done (+4)

;:print_syscall_table_done
    ; we're done. return
    70 8C 8D 00   ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C   ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04   ; add rsp rsp 4   ; ^^^           ; ^^^
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret
;:print_syscall_table_not_done

    ; call print_syscall_entry()
    7C 8A 00 00    ; ims ra <print_syscall_entry
    7C 8A 40 15    ; ims ra >print_syscall_entry (0x1540)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; increment the index
    78 80 8D FC    ; ldw r0 rfp -4    ; index
    70 80 80 01    ; add r0 r0 1   ; inc r0
    79 80 8D FC    ; stw r0 rfp -4    ; index

    ; load the loop address to loop
    78 8F 8D F4   ; ldw rip rfp -12    ; jump to print_syscall_table_loop

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x3B0



;==========================================
; void check_version(void);
;==========================================
; Check the version, printing a warning or error if it's not supported.
;==========================================

@0x3B0 =check_version

    ; Get the vm major version
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 00   ; ldw r8 r9 00      ; r8 = version

    ; Check if the version is greater than 4
    7E 88 10 00   ; jz r8 &check_version_major_ok (+16)   ; skip ltu in v0
    7D 8B 04 88   ; ltu rb 4 r8
    7E 8B 0E 00   ; jz rb &check_version_major_ok (+14)


    ; Fatal error, major version unsupported. Get message
    7C 80 00 00    ; ims r0 <str_major_version_not_supported
    7C 80 10 10    ; ims r0 >str_major_version_not_supported (0x1010)
    70 80 8E 80    ; add r0 rpp r0

    ; call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; tail-call syscall_exit(1)
    70 80 00 01    ; add r0 0 1     ; mov r0 1
    7C 8A 00 00    ; ims ra <syscall_exit
    7C 8A D0 05    ; ims ra >syscall_exit (0x5D0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump


;:check_version_major_ok

    ; Check if the minor version is 0
    78 87 89 28   ; ldw r7 r9 40      ; r7 = minor version
    7E 87 06 00   ; jz r7 &check_version_minor_ok (+6)

    ; Warning, minor version unsupported. Get message
    7C 80 00 00    ; ims r0 <str_minor_version_not_supported
    7C 80 40 10    ; ims r0 >str_minor_version_not_supported (0x1040)
    70 80 8E 80    ; add r0 rpp r0

    ; tail-call print_string()
    7C 8A 00 00    ; ims ra <print_string
    7C 8A C0 07    ; ims ra >print_string (0x7C0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump


;:check_version_minor_ok
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x440



;==========================================
; int get_syscall_count();
;==========================================
; Returns the number of entries in the syscall table.
;
; This is only called for VM versions that actually have a syscall table
; (version 2 and up.)
;==========================================

@0x440 =get_syscall_count

    ; Get the vm major version
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 00   ; ldw r8 r9 00      ; r8 = version

    ; In version 2 there were 23 syscalls.
    71 8A 88 02   ; sub ra r8 2
    7E 8A 01 00   ; jz ra &get_syscall_count_v2 (+1)
    7E 00 02 00   ; jz 0 &get_syscall_count_not_v2 (+2)
;:get_syscall_count_v2
    70 80 00 17   ; add r0 0 23     ; r0 = 23
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret
;:get_syscall_count_not_v2

    ; In version 3 the syscall count is in the PIT.
    ; (If the syscall count is out of bounds we will eventually crash.)
    71 8A 88 03   ; sub ra r8 3
    7E 8A 01 00   ; jz ra &get_syscall_count_v3 (+1)
    7E 00 02 00   ; jz 0 &get_syscall_count_not_v3 (+2)
;:get_syscall_count_v3
    78 80 89 28   ; ldw r0 r9 r8    ; r0 = pit[SYSCALL_COUNT]
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret
;:get_syscall_count_not_v3

    ; In version 4 the syscall count depends on the minor version. For now we
    ; only support 4.0 which has 25 syscall entries (though some are unused.)
    70 80 00 19   ; add r0 0 29     ; r0 = 29
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x4A0



;==========================================
; void print_char(char c);
;==========================================
; Writes the given byte to the output buffer. If the buffer becomes full, the
; output is flushed afterwards.
;
; If any error occurs, the program aborts.
;==========================================

@0x4A0 =print_char
    ; don't bother to set up a stack frame

    ; the output buffer always has free space. we start by writing
    ; the byte to it and bumping the pointer.
    78 81 8E 3C    ; ldw r1 rpp 0x3C   ; output_buffer_pos
    7B 80 00 81    ; stb r0 0 r1
    70 81 81 01    ; add r1 r1 1
    79 81 8E 3C    ; stw r1 rpp 0x3C

    ; get the output buffer
    7C 8A 00 00    ; ims ra <output_buffer
    7C 8A A0 02    ; ims ra >output_buffer (0x2A0)
    70 82 8E 8A    ; add r2 rpp ra

    ; get the end of the output buffer
    72 83 10 08    ; mul r3 16 8    ; r3 = 128
    70 83 82 83    ; add r3 r2 r3

    ; We flush if the buffer is full or if we printed a newline or a colon. See
    ; the comment at the top of the file for details.

    ; check if we printed a newline or colon
    71 84 80 0A    ; sub r4 r0 "\n"
    7E 84 05 00    ; jz r4 &print_char_flush (+5)
    71 84 80 3A    ; sub r4 r0 ":"
    7E 84 03 00    ; jz r4 &print_char_flush (+3)

    ; check if there is space left in the buffer
    71 8A 81 83    ; sub ra r1 r3
    7E 8A 01 00    ; jz ra &print_char_flush (+1)

    ; we don't need to flush. done
    78 8F 00 8C    ; ldw rip 0 rsp        ; ret

;:print_char_flush

    ; call flush()
    7C 8A 00 00    ; ims ra <flush
    7C 8A 40 05    ; ims ra >flush (0x540)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; done
    78 8F 00 8C    ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x540



;==========================================
; void flush(void);
;==========================================
; Flushes the buffer to standard output.
;
; Raises a fatal error on failure.
;==========================================

@0x540 =flush

    ; get the output buffer
    7C 8A 00 00    ; ims ra <output_buffer
    7C 8A A0 02    ; ims ra >output_buffer (0x2A0)
    70 81 8E 8A    ; add r1 rpp ra

    ; get the byte count
    78 82 8E 3C    ; ldw r2 rpp 0x3C   ; output_buffer_pos
    71 82 82 81    ; sub r2 r2 r1

    ; if there are no bytes in the buffer, we're done.
    7E 82 01 00    ; jz r2 &flush_empty (+1)
    7E 00 01 00    ; jz 0 &flush_have_data (+1)
;:flush_empty
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret
;:flush_have_data

    ; get stdout handle
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 80 89 10   ; ldw r0 r9 16

    ; call write_all
    7C 8A 00 00    ; ims ra <write_all
    7C 8A A0 06    ; ims ra >write_all (0x6A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; non-zero return value indicates error
    7E 80 04 00    ; jz r0 &flush_ok (+4)

    ; failed to write to standard output. nothing we can do but exit.
    ; tail-call syscall_exit(1)
    70 80 00 01    ; add r0 0 1     ; mov r0 1
    7C 8A 00 00    ; ims ra <syscall_exit
    7C 8A D0 05    ; ims ra >syscall_exit (0x5D0)
    70 8F 8E 8A    ; add rip rpp ra    ; jump
;:flush_ok

    ; reset the buffer pos to the start
    7C 8A 00 00    ; ims ra <output_buffer
    7C 8A A0 02    ; ims ra >output_buffer (0x2A0)
    70 82 8E 8A    ; add r2 rpp ra
    79 82 8E 3C    ; stw r2 rpp 0x3C   ; output_buffer_pos

    ; done
    78 8F 00 8C    ; ldw rip 0 rsp    ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x5D0



;==========================================
; [[noreturn] void syscall_exit(int status);
;==========================================
; Exits with the given status.
;==========================================

@0x5D0 =syscall_exit

    ; check if we need to use a sys instruction
    78 8B 8E 28   ; ldw rb rpp 0x28    ; sys_instruction
    7E 8B 01 00   ; jz rb &syscall_exit_table (+1)

    ; sys instruction
    7F 00 00 00   ; sys halt (0)

;:syscall_exit_table
    ; tail-call syscall exit
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    78 89 88 04   ; ldw r9 r8 4       ; r9 = r9 of syscall exit
    78 8F 88 00   ; ldw rip r8 0      ; rip = rip of syscall exit

    ; padding
    00 00 00 00
@0x5F0



;==========================================
; int syscall_fwrite(const char* path, bool writeable);
;==========================================

@0x5F0 =syscall_fwrite

    ; check if we need to use a sys instruction
    78 8B 8E 28   ; ldw rb rpp 0x28    ; sys_instruction
    7E 8B 02 00   ; jz rb &syscall_fwrite_table (+2)

    ; sys instruction
    7F 06 00 00   ; sys fwrite (6)
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret

;:syscall_fwrite_table

    ; get syscall fwrite into r7
    78 89 8E 20   ; ldw r9 rpp 0x20   ; r9 = process_info_table
    78 88 89 08   ; ldw r8 r9 8       ; r8 = syscall table
    76 8A 06 03   ; shl ra 6 3        ; ra = offset of fwrite syscall (6<<3)
    70 87 88 8A   ; add r7 r8 ra      ; r7 = address of fwrite syscall

    ; tail-call the syscall
    78 89 87 04   ; ldw r9 r7 4      ; r9 = r9 of syscall
    78 8F 87 00   ; ldw rip r7 0     ; rip = rip of syscall

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x640



;==========================================
; void initialize(uint32_t* initial_register_values);
;==========================================
; Initializes all global variables.
;==========================================

@0x640 =initialize

    ; store the initial register values
    79 80 8E 24   ; stw r0 rpp 0x24    ; initial_register_values

    ; store the process info table
    78 80 80 00   ; ldw r0 r0 0
    79 80 8E 20   ; stw r0 rpp 0x20    ; process_info_table

    ; store whether we need workarounds for the cmpu instruction
    78 81 80 00   ; ldw r1 r0 0   ; version
    7E 81 01 00   ; jz r1 &initialize_cmpu (+1)
    7E 00 01 00   ; jz 0 &initialize_ltu (+1)
;:initialize_cmpu
    79 01 8E 2C   ; stw 1 rpp 0x2C    ; cmpu_instruction
;:initialize_ltu

    ; store whether we need to use a sys instruction
    78 81 80 00   ; ldw r1 r0 0   ; version
    7E 81 03 00   ; jz r1 &initialize_sys (+3)
    71 81 81 01   ; sub r1 r1 1
    7E 81 01 00   ; jz r1 &initialize_sys (+1)
    7E 00 01 00   ; jz 0 &initialize_no_sys (+1)
;:initialize_sys
    79 01 8E 28   ; stw 1 rpp 0x28    ; sys_instruction
;:initialize_no_sys

    ; clear the output buffer
    7C 8A 00 00   ; ims ra <output_buffer
    7C 8A A0 02   ; ims ra >output_buffer (0x2A0)
    70 8A 8A 8E   ; add ra ra rpp
    79 8A 8E 3C   ; stw ra rpp 0x3C    ; output_buffer_pos = &output_buffer

    ; return
    78 8F 00 8C    ; ldw rip 0 rsp        ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
@0x6A0



;==========================================
; int write_all(int handle, const char* data, size_t count);
;==========================================
; Writes all of the given data to the given I/O handle.
;
; Returns zero if successful, or the syscall error code if it fails.
;
; vars
; - io_handle: rfp-4
; - data: rfp-8
; - remaining: rfp-12
; - loop address: rfp-16
;==========================================

@0x6A0 =write_all

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp

    ; store args
    71 8C 8C 10     ; sub rsp rsp 16
    79 80 8D FC     ; stw r0 rfp -4
    79 81 8D F8     ; stw r1 rfp -8
    79 82 8D F4     ; stw r2 rfp -12

    ; store the address to loop
    79 8F 8D F0    ; stw rip rfp -16
;:write_all_loop

    ; call syscall_fwrite()
    7C 8A 00 00    ; ims ra <syscall_fwrite
    7C 8A F0 05    ; ims ra >syscall_fwrite (0x5F0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; check the high bit for error
    77 8A 80 1F   ; shru/ror ra r0 31
    74 8A 8A 01   ; and ra ra 1   ; in version 0 shru was ror
    7E 8A 04 00   ; jz ra &write_all_no_error (+4)
    ; fail, return the error code
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;:write_all_no_error

    ; check if we got zero
    7E 80 01 00   ; jz r0 &write_all_zero (+1)
    7E 00 05 00   ; jz 0 &write_all_not_zero (+5)
;:write_all_zero
    ; zero bytes written. this should not be possible; the vm is
    ; malfunctioning. fail, return generic error -1
    70 80 00 FF     ; add r0 0 -1
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret
;:write_all_not_zero

    ; adjust pointer and bytes remaining
    78 81 8D F8   ; ldw r1 rfp -8
    78 82 8D F4   ; ldw r2 rfp -12
    70 81 81 80   ; add r1 r1 r0
    71 82 82 80   ; sub r2 r2 r0
    79 81 8D F8   ; stw r1 rfp -8
    79 82 8D F4   ; stw r2 rfp -12

    ; if bytes remaining is zero, we're done
    7E 82 02 00   ; jz r2 &write_all_loop_exit (+2)

    ; otherwise loop.
    78 80 8D FC   ; ldw r0 rfp -4     ; io_handle
    78 8F 8D F0   ; ldw rip rfp -16   ; jump to :write_all_loop

;:write_all_loop_exit

    ; done, return zero
    70 80 00 00     ; add r0 0 0        ; zero r0
    70 8C 8D 00     ; add rsp rfp 0     ; mov rsp rfp   ; leave
    78 8D 00 8C     ; ldw rfp 0 rsp     ; pop rfp       ; ^^^
    70 8C 8C 04     ; add rsp rsp 4     ; ^^^           ; ^^^
    78 8F 00 8C     ; ldw rip 0 rsp     ; ret

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x790



;==========================================
; const char str_initial_register_values[];
;==========================================

@0x790 =str_initial_register_values
    ; "Initial Register Values" '0A '00
    49 6e 69 74 69 61 6c 20  52 65 67 69 73 74 65 72
  ;  I  n  i  t  i  a  l      R  e  g  i  s  t  e  r
    20 56 61 6c 75 65 73 3A  0a 00 00 00 00 00 00 00
  ;     V  a  l  u  e  s  :  \n \0
@0x7B0



;==========================================
; const char str_indentation[];
;==========================================

@0x7B0 =str_indentation
    ; "    " '00
    20 20 20 20 00 00 00 00  00 00 00 00 00 00 00 00
  ;             \0
@0x7C0




;==========================================
; void print_string(const char* str);
;==========================================
; Print the given null-terminated string verbatim.
;
; vars:
;     str: rfp-4
;     loop_address: rfp-8
;==========================================

@0x7C0 =print_string

    ; set up a stack frame
    71 8C 8C 04     ; sub rsp rsp 4     ; push rfp
    79 8D 00 8C     ; stw rfp 0 rsp     ; ...
    70 8D 8C 00     ; add rfp rsp 0     ; mov rfp rsp
    71 8C 8C 08     ; sub rsp rsp 8

    ; store the string
    79 80 8D FC    ; stw r0 rfp -4

    ; store this address to loop
    79 8F 8D F8    ; stw rip rfp -8
;:print_string_loop

    ; check if the current character is the null-terminator
    78 81 8D FC   ; ldw r1 rfp -4
    7A 80 81 00   ; ldb r0 r1 0
    7E 80 01 00   ; jz r0 &print_string_done (+1)    ; jnz r0 &print_string_output
    7E 00 04 00   ; jz 0 &print_string_output (+4)   ; ^^^

;:print_string_done
    ; return
    70 8C 8D 00   ; add rsp rfp 0   ; mov rsp rfp   ; leave
    78 8D 00 8C   ; ldw rfp 0 rsp   ; pop rfp       ; ^^^
    70 8C 8C 04   ; add rsp rsp 4   ; ^^^           ; ^^^
    78 8F 00 8C   ; ldw rip 0 rsp   ; ret

;:print_string_output

    ; call print_char()
    7C 8A 00 00    ; ims ra <print_char
    7C 8A A0 04    ; ims ra >print_char (0x4A0)
    71 8C 8C 04    ; sub rsp rsp 4     ; push return address
    70 8B 8F 08    ; add rb rip 8
    79 8B 00 8C    ; stw rb 0 rsp
    70 8F 8E 8A    ; add rip rpp ra    ; jump
    70 8C 8C 04    ; add rsp rsp 4     ; pop return address

    ; increment the string
    78 81 8D FC   ; ldw r1 rfp -4
    70 81 81 01   ; add r1 r1 1   ; inc r1
    79 81 8D FC   ; stw r1 rfp -4

    ; load the loop address to loop
    78 8F 8D F8   ; ldw rip rfp -8    ; jump to print_string_loop

    ; padding
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00
    00 00 00 00
@0x860



;==========================================
; char register_names[16][6];
;==========================================
; A list of register names with ": " suffix, additional spacing for
; alignment, and null-terminators.
;
; Every six bytes is a register name.
;==========================================

@0x860 =register_names
    72 30 3A 20 20 00   ; "r0:  " '00
    72 31 3A 20 20 00   ; "r1:  " '00
    72 32 3A 20 20 00   ; "r2:  " '00
    72 33 3A 20 20 00   ; "r3:  " '00
    72 34 3A 20 20 00   ; "r4:  " '00
    72 35 3A 20 20 00   ; "r5:  " '00
    72 36 3A 20 20 00   ; "r6:  " '00
    72 37 3A 20 20 00   ; "r7:  " '00
    72 38 3A 20 20 00   ; "r8:  " '00
    72 39 3A 20 20 00   ; "r9:  " '00
    72 61 3A 20 20 00   ; "ra:  " '00
    72 62 3A 20 20 00   ; "rb:  " '00
    72 73 70 3A 20 00   ; "rsp: " '00
    72 66 70 3A 20 00   ; "rfp: " '00
    72 70 70 3A 20 00   ; "rpp: " '00
    72 69 70 3A 20 00   ; "rip: " '00
@0x8C0



;==========================================
; uint32_t pit_header_names[16];
;==========================================
; The program-relative address of strings containing the names of entries in
; the process info table.
;
; These are the names in the latest version. On older VM versions we replace
; the names in this list at runtime before printing them.
;==========================================

@0x8C0 =pit_header_names
    70 0E 00 00    ; str_major_version (0xE70)
    90 0E 00 00    ; str_heap_start (0xE90)
    B0 0E 00 00    ; str_system_call_table (0xEB0)
    E0 0E 00 00    ; str_input_stream_handle (0xEE0)
    00 0F 00 00    ; str_output_stream_handle (0xF00)
    20 0F 00 00    ; str_error_stream_handle (0xF20)
    40 0F 00 00    ; str_command_line_arguments (0xF40)
    60 0F 00 00    ; str_environment_variables (0xF60)
    80 0F 00 00    ; str_working_directory (0xF80)
    A0 0F 00 00    ; str_capabilities (0xFA0)
    80 0E 00 00    ; str_minor_version (0xE80)
    F0 0F 00 00    ; str_free_memory_regions (0xFF0)
@0x8F0



