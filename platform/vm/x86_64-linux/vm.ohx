    FF D0             ; call rax
    ; check the address
    57                ; push rdi
    56                ; push rsi
    B8 80 15 40 00    ; mov eax, check_byte (0x400980)
    FF D0             ; call rax
    5E                ; pop rsi
    5F                ; pop rdi
