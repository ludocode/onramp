; ==========================================================
; void syscall_time(unsigned words[3])
; ==========================================================
; Writes the current UNIX timestamp as 64-bit seconds plus 32-bit nanoseconds
; into the given address.
;
; params:
;    - r0: the address to write the timestamp
; ==========================================================

@0x1200 syscall_time

    ; set up stack frame
    55           ; push rbp
    48 89 E5     ; mov rbp, rsp

    ; the kernel clock_gettime() function writes sixteen bytes on x86_64 but we
    ; only want twelve. we get the time onto the stack and then copy.

    ; call clock_gettime()
    48 83 EC 10        ; sub rsp, 16
    48 89 E6           ; mov rsi, rsp
    BF 00 00 00 00     ; mov edi, 0
    B8 E4 00 00 00     ; mov eax, 0xE4   ; syscall: clock_gettime (228)
    0F 05              ; syscall

    ; get the input and output addresses
    ; TODO call check_buffer() on the argument
    BF 00 00 60 00    ; mov rdi, r0 (0x600000)
    8B 3F             ; mov edi, [rdi]
    48 89 E6          ; mov rsi, rsp

    ; copy the time
    48 8B 06          ; mov rax, [rsi]
    48 89 07          ; mov [rdi], rax
    8B 46 08          ; mov eax, [rsi+8]
    89 47 08          ; mov [rdi+8], eax

    ; set return value 0 in r0
    BF 00 00 60 00       ; mov rdi, r0 (0x600000)
    C7 07 00 00 00 00    ; mov dword [rdi], 0

    ; return
    48 89 EC     ; mov rsp, rbp
    5D           ; pop rbp
    C3           ; ret

    ; padding (nop)
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90
@0x1270



; ==========================================================
; void skip_wrap_header(void)
; ==========================================================
; Checks for `#!` or `REM` at the start of the program and, if found, skips the
; first 128 bytes.
;
; registers:
; - edi: address of rpp/rip registers
; - esi: value of rpp/rip registers, i.e. address of first word of program
; - edx: first word of rpogram
; - eax: temporary register for comparisons
; ==========================================================

@0x1270 skip_wrap_header
    ; set up stack frame
    55           ; push rbp
    48 89 E5     ; mov rbp, rsp

    ; get the first word of the program into esi
    BF 38 00 60 00   ; mov edi, rpp (0x600038)
    8B 37            ; mov esi, [rdi]           ; load rpp
    8B 16            ; mov edx, [rsi]           ; get word at rpp

    ; compare it to #!
    B8 FF FF 00 00   ; mov eax, 0xFFFF   ; mask on the low two bytes
    21 D0            ; and eax, edx
    3D 23 21 00 00   ; cmp eax, 0x2123   ; compare to '#!' (in little-endian)
    74 10            ; je skip_wrap_header_found (+16)

    ; compare it to REM
    B8 FF FF FF 00   ; mov eax, 0xFFFFFF   ; mask on the low three bytes
    21 D0            ; and eax, edx
    3D 52 45 4D 00   ; cmp eax, 0x4D4552   ; compare to 'REM' (in little-endian)
    74 02            ; je skip_wrap_header_found (+2)

    ; none match
    EB 11             ; jmp skip_wrap_header_done (+17)

;skip_wrap_header_found:
    ; increment rpp and rip by 128
    81 C6 80 00 00 00   ; add esi, 128
    67 89 37            ; mov [edi], esi   ; store rpp
    BF 3C 00 60 00      ; mov edi, rip (0x60003C)
    67 89 37            ; mov [edi], esi   ; store rip

;skip_wrap_header_done:
    ; return
    48 89 EC     ; mov rsp, rbp
    5D           ; pop rbp
    C3           ; ret

    ; padding (nop)
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90
@0x12F0



; ==========================================================
; void io_setup(void)
; ==========================================================
; Initializes the input.
;
; This attempts to configure the terminal for raw input mode.
;
; Signal handlers are installed to restore the terminal state on exit and to
; manage the terminal state as the program moves between background and
; foreground.
; ==========================================================

@0x12F0 io_setup

    ; setup signal handlers first (to minimize race conditions)
    ; call install_all_signal_handlers()
    B8 50 16 40 00    ; mov eax, install_all_signal_handlers (0x401650)
    FF D0             ; call rax

    ; TODO call unblock_signals, not implemented yet

    ; set the interactive flag to true to start
    B8 C0 00 60 00    ; mov eax, 0x6000C0   ; interactive flag
    C6 00 01          ; mov [rax], 1

    ; call enable_raw_input()
    B8 30 13 40 00    ; mov eax, enable_raw_input (0x401330)
    FF D0             ; call rax

    ; check if enable_raw_input() failed
    B8 BC 00 60 00    ; mov eax, 0x6000BC   ; termios valid flag
    8B 00             ; mov eax, [rax]
    83 F8 00          ; cmp eax, 0
    75 08             ; jne io_setup_termios_ok (+8)

    ; failed. clear interactive flag
    B8 C0 00 60 00    ; mov eax, 0x6000C0   ; interactive flag
    C6 00 00          ; mov [rax], 0

;io_setup_termios_ok:
    C3                ; ret

    ; padding (nop)
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90
@0x1330



; ==========================================================
; void enable_raw_input(void)
; ==========================================================
; Attempts to set the terminal to non-echo, non-canonical (raw input) mode.
;
; This is really just to get Doom playable from command-line. All of this could
; be deleted to make this VM shorter. In fact an Onramp VM does not need to
; support input at all.
; ==========================================================

@0x1330 enable_raw_input

    ; set up stack frame
    55           ; push rbp
    48 89 E5     ; mov rbp, rsp

    ; if interactive is false, return
    B8 C0 00 60 00    ; mov eax, 0x6000C0   ; interactive flag
    8B 00             ; mov eax, [rax]
    83 F8 00          ; cmp eax, 0
    75 05             ; jnz enable_raw_input_interactive (+5)
    48 89 EC          ; mov rsp, rbp
    5D                ; pop rbp
    C3                ; ret
;enable_raw_input_interactive:

    ; if termios valid flag is already set, return
    B8 BC 00 60 00    ; mov eax, 0x6000BC   ; termios valid flag
    8B 00             ; mov eax, [rax]
    83 F8 00          ; cmp eax, 0
    74 05             ; jz enable_raw_input_valid (+5)
    48 89 EC          ; mov rsp, rbp
    5D                ; pop rbp
    C3                ; ret
;enable_raw_input_valid:

    ; call ioctl(TCGETS) to get terminal state (equivalent to tcgetattr())
    BF 00 00 00 00     ; mov edi, 0         ; file descriptor: stdin (0)
    BE 01 54 00 00     ; mov esi, 0x5401    ; command: TCGETS (0x5401)
    BA 80 00 60 00     ; mov edx, 0x600080  ; arg: struct termios to save (0x600080)
    B8 10 00 00 00     ; mov eax, 16        ; syscall: ioctl (16)
    0F 05              ; syscall

    ; if it failed, this is not a tty. return
    83 F8 00          ; cmp eax, 0
    74 05             ; jz enable_raw_input_tgets_ok (+5)
    48 89 EC          ; mov rsp, rbp
    5D                ; pop rbp
    C3                ; ret
;enable_raw_input_tgets_ok:

    ; make stack space for a temporary struct termios (60 bytes, rounded up to multiple of 8)
    48 83 EC 40        ; sub rsp, 64

    ; copy saved struct termios to the stack
    48 89 E7         ; mov rdi, rsp       ; destination: stack space
    BE 80 00 60 00   ; mov esi, 0x600080  ; source: saved struct termios
    B9 3C 00 00 00   ; mov ecx, 60        ; counter: size of struct termios
    F3 A4            ; rep movsb

    ; load c_lflag, the fourth dword in the struct
    8B 44 24 0C        ; mov eax, [rsp + 12]

    ; turn off ECHO (0b1000) and ICANON (0b0010)
    BA 0A 00 00 00     ; mov edx, 0b1010
    F7 D2              ; not edx
    21 D0              ; and eax, edx

    ; put it back in the struct
    89 44 24 0C        ; mov [rsp + 12], eax

    ; set termios valid flag
    B8 BC 00 60 00    ; mov eax, 0x6000BC   ; termios valid flag
    C6 00 01          ; mov [rax], 1

    ; call apply_termios() on our stack copy
    48 89 E7          ; mov rdi, rsp
    B8 30 18 40 00    ; mov eax, apply_termios (0x401830)
    FF D0             ; call rax

    ; check for failure
    83 F8 00          ; cmp eax, 0
    75 05             ; jnz enable_raw_input_tcsets_fail (+5)

    ; success. return
    48 89 EC     ; mov rsp, rbp
    5D           ; pop rbp
    C3           ; ret
;:enable_raw_input_tcsets_fail

    ; failed. clear termios valid flag
    B8 BC 00 60 00    ; mov eax, 0x6000BC   ; termios valid flag
    C6 00 00          ; mov [rax], 1

    ; return
    48 89 EC     ; mov rsp, rbp
    5D           ; pop rbp
    C3           ; ret

    ; padding (nop)
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90

@0x1420



; ==========================================================
; void disable_raw_input(void)
; ==========================================================
; Restores the terminal settings back to their original state (if they were
; changed.)
; ==========================================================

@0x1420 disable_raw_input

    ; if interactive is false, return
    B8 C0 00 60 00    ; mov eax, 0x6000C0   ; interactive flag
    8B 00             ; mov eax, [rax]
    83 F8 00          ; cmp eax, 0
    75 01             ; jnz clear_termios_interactive (+1)
    C3                ; ret
;clear_termios_interactive:

    ; if termios valid is false, return
    B8 BC 00 60 00    ; mov eax, 0x6000BC   ; termios valid flag
    8B 00             ; mov eax, [rax]
    83 F8 00          ; cmp eax, 0
    75 01             ; jnz clear_termios_valid (+1)
    C3                ; ret
;clear_termios_valid:

    ; call apply_termios() on our saved struct termios
    BF 80 00 60 00    ; mov edi, 0x600080  ; saved struct termios
    B8 30 18 40 00    ; mov eax, apply_termios (0x401830)
    FF D0             ; call rax

    ; apply_termios() has sent SIGCONT if necessary. We otherwise ignore any
    ; errors from resetting termios. There isn't really anything we can do
    ; about it.

    ; clear termios valid flag
    B8 BC 00 60 00    ; mov eax, 0x6000BC   ; termios valid flag
    C6 00 00          ; mov [rax], 0

    ; done
    C3           ; ret

    ; padding (nop)
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90

