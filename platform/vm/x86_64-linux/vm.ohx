    B8 F0 09 40 00   ; mov eax, parse_register (0x4009F0)
    FF D0            ; call rax
    ; shift the register contents up and mask in the low bits
    8B 08            ; mov ecx, [rax]
    C1 E1 10         ; shl ecx, 16
    5A               ; pop rdx
    09 D1            ; or ecx, edx
    89 08            ; mov [rax], ecx
    C3               ; ret
    90 90 90 90 90 90

