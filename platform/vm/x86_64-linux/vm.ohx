@0x1830



; ==========================================================
; int apply_termios(struct termios*)
; ==========================================================
; Attempts to set the terminal state to that given.
;
; Returns zero on success, non-zero on error.
;
; params:
; - edi: struct termios*
; ==========================================================

@0x1830 apply_termios

    ; set up stack frame
    55           ; push rbp
    48 89 E5     ; mov rbp, rsp

    ; store the given terminal state
    57      ; push rdi

    ; get stdin foreground process group. call syscall ioctl(0, TIOCGPGRP, rsp)
    6A 00              ; push 0             ; make stack space
    48 89 E2           ; mov rdx, rsp       ; arg: stack space
    BF 00 00 00 00     ; mov edi, 0         ; file descriptor: stdin (0)
    BE 0F 54 00 00     ; mov esi, 0x540F    ; command: TIOCGPGRP (0x540F)
    B8 10 00 00 00     ; mov eax, 16        ; syscall: ioctl (16)
    0F 05              ; syscall

    ; get our process group. call syscall getpgrp
    B8 6F 00 00 00    ; mov eax, 0x6F  ; syscall: getpgrp (111)
    0F 05             ; syscall

    ; compare the process groups. they must be the same.
    5F         ; pop rdi
    48 39 F8   ; cmp rax, rdi
    74 05      ; je apply_termios_group_match (+5)

    ; process groups don't match. we don't control the terminal; don't try to
    ; set terminal state.
    ; return
    48 89 EC     ; mov rsp, rbp
    5D           ; pop rbp
    C3           ; ret
;apply_termios_group_match:

    ; We ignore SIGTTOU with a non-restartable handler while setting terminal
    ; state.
    ;
    ; If we are launched in the background we'll still have access to the
    ; terminal but we'll get SIGTTOU if we try to change it. The default
    ; behaviour of SIGTTOU is to stop the process until the program is
    ; foregrounded. Instead we want to get an error when setting the terminal
    ; state.
    ;
    ; Note that we can't use SIG_IGN because in that case the termios call will
    ; actually succeed even if we're in the background. We want it to fail if
    ; we're in the background, which is why we need a dummy signal handler.
    ;
    ; See: http://curiousthing.org/sigttin-sigttou-deep-dive-linux
    ;
    ; TODO we probably need to unblock SIGTTOU in case our parent process
    ; blocked it.

    ; call install_signal_handler(SIGTTOU, signal_ignore)
    BF 16 00 00 00    ; mov edi, 22 (SIGTTOU)
    BE 70 15 40 00    ; mov esi, signal_ignore (0x401570)
    B8 90 14 40 00    ; mov eax, install_signal_handler (0x401490)
    FF D0             ; call rax

    ; call ioctl(TCSETS) to change the terminal state (equivalent to tcsetattr())
    BF 00 00 00 00     ; mov edi, 0         ; file descriptor: stdin (0)
    BE 02 54 00 00     ; mov esi, 0x5402    ; command: TCSETS (0x5402)
    5A                 ; pop rdx            ; arg: struct termios*
    B8 10 00 00 00     ; mov eax, 16        ; syscall: ioctl (16)
    0F 05              ; syscall

    ; store the result
    50   ; push rax

    ; call install_signal_handler(SIGTTOU, SIG_DFL)
    BF 16 00 00 00    ; mov edi, 22 (SIGTTOU)
    BE 00 00 00 00    ; mov esi, 0 (SIG_DFL)
    B8 90 14 40 00    ; mov eax, install_signal_handler (0x401490)
    FF D0             ; call rax

    ; pop the result and check for failure
    58                ; pop rax
    83 F8 00          ; cmp eax, 0
    75 05             ; jnz apply_termios_fail (+5)

    ; success. return
    48 89 EC     ; mov rsp, rbp
    5D           ; pop rbp
    C3           ; ret
;apply_termios_fail:

    ; failed. send SIGCONT to unblock process group, call send_sigcont()
    B8 C0 0D 40 00    ; mov eax, send_sigcont (0x400DC0)
    FF D0             ; call rax

    ; return
    48 89 EC     ; mov rsp, rbp
    5D           ; pop rbp
    C3           ; ret

    ; padding
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90
@0x18E0



; Note: When extending the text segment, the sizes in the header at 0x40 must
; be incremented to include it!

@0x18E0  ; end of program, corresponds to size in ELF text header
