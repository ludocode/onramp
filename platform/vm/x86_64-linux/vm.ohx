    BF 00 00 60 00   ; mov edi, r0 (0x600000)
    31 C0            ; xor eax, eax
    67 89 07         ; mov [edi], eax
    EB 0D            ; jmp syscall_ftell_done (+13)

;syscall_ftell_fail:
    ; error. store return value of -1 (generic error)
    BF 00 00 60 00   ; mov edi, r0 (0x600000)
    B8 FF FF FF FF   ; mov eax, -1
    67 89 07         ; mov [edi], eax

