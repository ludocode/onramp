; ==========================================================
; void syscall_ftell(void)
; ==========================================================
; Gets the position in the given file handle.
;
; params:
;    - r0: file handle
;    - r1: out_position
; ==========================================================

@0x10A0 syscall_ftell
    ; set up stack frame
    55           ; push rbp
    48 89 E5     ; mov rbp, rsp

    ; get the file descriptor (and check it)
    B8 30 0E 40 00    ; mov eax, parse_io_handle (0x400E30)
    FF D0             ; call rax
