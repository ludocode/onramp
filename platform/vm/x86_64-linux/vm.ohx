; ==========================================================
; void install_signal_handler(int signal_number, void (*signal_handler)(...))
; ==========================================================
; Installs the given signal handling function for the given signal.
;
; The signal function may be 0 (SIG_DFL), 1 (SIG_IGN), or the address of a
; function.
;
; params:
; - signal_number: rdi
; - signal_handler: rsi
; ==========================================================

@0x1490 install_signal_handler

    ; set up stack frame
    55           ; push rbp
    48 89 E5     ; mov rbp, rsp

    ; The kernel's struct sigaction doesn't necessarily match that of the libc
    ; (e.g. glibc's is different.) The kernel struct on x86_64 is 32 bytes and
    ; has the following fields, each 8 bytes in size:
    ;
    ; - 0:  sa_handler
    ; - 8:  sa_flags
    ; - 16: sa_restorer
    ; - 24: sa_mask

    ; make stack space for a temporary struct sigaction (40 bytes)
    48 83 EC 28        ; sub rsp, 40

    ; calculate flags. if signal is SIG_DFL, we add SA_RESTART.
    BA 04 00 00 04     ; mov edx, 0x4000004  (SA_RESTORER | SA_SIGINFO)  (0x04000000 | 4)
    83 FE 00           ; cmp esi, 0
    75 06              ; jnz install_signal_handler_flags_ok (+6)
    81 CA 00 00 00 10  ; or edx, 0x10000000  (SA_RESTART)
;install_signal_handler_flags_ok:

    ; configure struct sigaction
    48 89 E0                 ; mov rax, rsp                ; get struct sigaction
    48 89 30                 ; mov [rax], rdi              ; sigaction->sa_handler = signal_handler
    48 89 50 08              ; mov [rax + 8], rdx          ; sigaction->sa_flags = rdx
    48 C7 40 10 30 16 40 00  ; mov [rax + 16], 0x401630    ; sigaction->sa_restorer = signal_trampoline (0x401630)
    48 C7 40 18 02 40 00 00  ; mov [rax + 24], 0x4002      ; sigaction->sa_mask = SIGINT | SIGTERM ((1<<(2-1)) | (1<<(15-1)))

    ; syscall rt_sigaction()
    ; (signal number is already in rdi)
    B8 0D 00 00 00       ; mov eax, 13          ; syscall: rt_sigaction (13)
    48 89 E6             ; mov rsi, rsp         ; sigaction: struct sigaction on stack
    BA 00 00 00 00       ; mov edx, 0           ; old_sigaction: NULL
    41 BA 08 00 00 00    ; mov r10, 8           ; sigsetsize: 8 (sizeof sa_mask)
    0F 05                ; syscall

    ; done
    48 89 EC     ; mov rsp, rbp
    5D           ; pop rbp
    C3           ; ret

    ; padding (nop)
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90
@0x1570



; ==========================================================
; void signal_ignore(...)
; ==========================================================
; A function that does nothing.
;
; This is used as a signal handler to ignore a signal. It's used instead of
; SIG_IGN because SIG_IGN causes different behaviour on SIGTTOU (it allows
; terminal writes to succeed, whereas we want them to fail.)
; ==========================================================

@0x1570 signal_ignore

    ; return
    C3    ; ret

    ; padding
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90

@0x1580



; ==========================================================
; void check_byte(void* address)
; ==========================================================
; Checks that the given address points to a valid byte in VM memory.
;
; The address must be in bounds. If any checks fail, the VM aborts.
;
; params:
;     address: edi
; ==========================================================

@0x1580 check_byte
    ; set up stack frame
    55                             ; push rbp
    48 89 E5                       ; mov rbp, rsp

    ; check that the address is in bounds
    B8 00 00 00 01    ; mov eax, 0x1000000
    39 C7             ; cmp edi, eax
    7C 0E             ; jl check_byte_fail (+14)
    B8 00 00 00 02    ; mov eax, 0x2000000
    39 C7             ; cmp edi,eax
    7D 05             ; jge check_byte_fail (+5)

    ; everything's ok; return
    48 89 EC  ; mov rsp, rbp
    5D        ; pop rbp
    C3        ; ret

;check_byte_fail:
    BF 20 03 50 00   ; mov edi, "ERROR: A memory access..." (0x500320)
    B8 A0 05 40 00   ; mov eax, fatal (0x4005A0)
    FF D0            ; call rax

    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90
@0x15C0



; ==========================================================
; void syscall_mkdir(void)
; ==========================================================
; Creates a directory.
;
; params:
;    - r0: path
; ==========================================================

@0x15C0 syscall_mkdir

    ; set up stack frame
    ;55           ; push rbp
    ;48 89 E5     ; mov rbp, rsp

    ; get the filename in %rdi, check it
    BF 00 00 60 00    ; mov rdi, r0 (0x600000)
    8B 3F             ; mov edi, [rdi]
    57                ; push rdi
    B8 10 08 40 00    ; mov eax, check_string (0x400810)
    FF D0             ; call rax

    ; put mode in %rsi
    BE ED 01 00 00    ; mov esi, 493  (rwxr-xr-x == 0755 == 493 == 0x1ED)

    ; call mkdir syscall
    B8 53 00 00 00   ; mov eax, 0x53  ; syscall: mkdir (83)
    5F               ; pop rdi        ; file descriptor
    0F 05            ; syscall

    ; check if it failed
    48 83 F8 00      ; cmp rax, 0
    74 0C            ; je syscall_mkdir_ok (+12)

    ; fail. store ERROR_GENERIC in r0
    BF 00 00 60 00     ; mov edi, r0 (0x600000)
    C7 07 FF FF FF FF  ; mov [rdi], ERROR_GENERIC (0xFFFFFFFF)

    ; return
    C3           ; ret

;syscall_mkdir_ok:

    ; success. store 0 in r0
    BF 00 00 60 00     ; mov edi, r0 (0x600000)
    C7 07 00 00 00 00  ; mov [rdi], 0

    ; return
    C3           ; ret

    ; padding (nop)
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90
@0x1630



; ==========================================================
; void signal_trampoline(void)
; ==========================================================
; The trampoline to which a called signal handler returns.
;
; This is passed as the "restorer" field of an rt_sigaction syscall. It simply
; calls the rt_sigreturn syscall.
; ==========================================================

@0x1630 signal_trampoline

    ; syscall rt_sigreturn
    B8 0F 00 00 00       ; mov eax, 15          ; syscall: rt_sigreturn (15)
    0F 05                ; syscall

    ; the syscall does not return control here.

    ; padding (nop)
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90
@0x1650



; ==========================================================
; void install_all_signal_handlers(void)
; ==========================================================
; Installs signal handlers to restore terminal state on exit and to toggle
; terminal state when entering and leaving the background.
; ==========================================================

@0x1650 install_all_signal_handlers

    ; signals that call signal_exit()

    ; call install_signal_handler(SIGINT, signal_exit)
    BF 02 00 00 00    ; mov edi, SIGINT (2)
    BE 60 14 40 00    ; mov esi, signal_exit (0x401460)
    B8 90 14 40 00    ; mov eax, install_signal_handler (0x401490)
    FF D0             ; call rax

    ; call install_signal_handler(SIGTERM, signal_exit)
    BF 0F 00 00 00    ; mov edi, SIGTERM (15)
    BE 60 14 40 00    ; mov esi, signal_exit (0x401460)
    B8 90 14 40 00    ; mov eax, install_signal_handler (0x401490)
    FF D0             ; call rax

    ; call install_signal_handler(SIGFPE, signal_exit)
    BF 08 00 00 00    ; mov edi, SIGFPE (8)
    BE 60 14 40 00    ; mov esi, signal_exit (0x401460)
    B8 90 14 40 00    ; mov eax, install_signal_handler (0x401490)
    FF D0             ; call rax

    ; call install_signal_handler(SIGHUP, signal_exit)
    BF 01 00 00 00    ; mov edi, SIGHUP (1)
    BE 60 14 40 00    ; mov esi, signal_exit (0x401460)
    B8 90 14 40 00    ; mov eax, install_signal_handler (0x401490)
    FF D0             ; call rax

    ; call install_signal_handler(SIGPIPE, signal_exit)
    BF 0D 00 00 00    ; mov edi, SIGPIPE (13)
    BE 60 14 40 00    ; mov esi, signal_exit (0x401460)
    B8 90 14 40 00    ; mov eax, install_signal_handler (0x401490)
    FF D0             ; call rax


    ; signals that call enable_raw_input()

    ; call install_signal_handler(SIGCONT, enable_raw_input)
    BF 12 00 00 00    ; mov edi, SIGCONT (18)
    BE 30 13 40 00    ; mov esi, enable_raw_input (0x401330)
    B8 90 14 40 00    ; mov eax, install_signal_handler (0x401490)
    FF D0             ; call rax


    ; signals that call disable_raw_input()

    ; call install_signal_handler(SIGTSTP, disable_raw_input)
    BF 14 00 00 00    ; mov edi, SIGTSTP (20)
    BE 20 14 40 00    ; mov esi, disable_raw_input (0x401420)
    B8 90 14 40 00    ; mov eax, install_signal_handler (0x401490)
    FF D0             ; call rax


    ; done
    C3   ; ret

    ; padding (nop)
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
