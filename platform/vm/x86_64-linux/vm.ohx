    B8 24 00 60 00   ; mov eax, r9 (0x600024)
    8B 00            ; mov eax, [rax]

    ; call the syscall
    ; (We're jumping to a native address given by the program! See the security
    ; implications in the comments above the syscall table above.)
    FF D0             ; call rax

    ; load the top of the stack into rip
    B8 30 00 60 00   ; mov eax, rsp (0x600030)
    8B 00            ; mov eax, [rax]
    ; TODO should check_word on this value
    8B 00            ; mov eax, [rax]
    BF 3C 00 60 00   ; mov edi, rip (0x60003C)
    89 07            ; mov [rdi], eax

    90 90 90 90 90 90 90



; ==========================================================
; store_helper
; ==========================================================
; This pseudo-function performs the common operations of the two store opcodes.
;
; All three arguments are mix-type so we parse them, then we add the last two
; arguments together to form the destination address.
;
; The destination address (unchecked) is placed in rdi and the value to store
; is placed in rsi.
;
; This is probably super slow and could be improved.
;
; params:
; - (edi is reserved for the parsed opcode number)
; - arg1: esi  (mix-type value)
; - arg2: edx  (mix-type base)
; - arg3: ecx  (mix-type offset)
; ==========================================================

@0xD40 store_helper
    56    ; push rsi
    52    ; push rdx
    51    ; push rcx

    ; arg1 in rsi is mix
    48 8B 7C 24 10        ; mov rdi, [rsp + 16]
    B8 30 0A 40 00        ; mov eax, parse_mix (0x400A30)
    FF D0                 ; call rax
    48 89 44 24 10        ; mov [rsp + 16], rax

    ; arg2 in rdx is mix
    48 8B 7C 24 08        ; mov rdi, [rsp + 8]
    B8 30 0A 40 00        ; mov eax, parse_mix (0x400A30)
    FF D0                 ; call rax
    48 89 44 24 08        ; mov [rsp + 8], rax

    ; arg3 in rcx is mix
    48 8B 3C 24           ; mov rdi, [rsp]
    B8 30 0A 40 00        ; mov eax, parse_mix (0x400A30)
    FF D0                 ; call rax
    48 89 04 24           ; mov [rsp], rax

    ; done argument parsing
    59    ; pop rcx
    5A    ; pop rdx
    5E    ; pop rsi

    ; form the address into edi
    01 CA   ; add edx, ecx
    89 D7   ; mov edi, edx

    ; done
    C3 ; ret

    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90
@0xD90



; ==========================================================
; opcode_jz
; ==========================================================
; Our jz opcode just barely doesn't fit in the opcode table. It's implemented
; here as its own function.
;
; params:
; - (edi is reserved for the parsed opcode number)
; - arg1: esi  (predicate, mix-type)
; - arg2: edx  (offset low byte)
; - arg3: ecx  (offset high byte)
; ==========================================================

@0xD90 opcode_jz

    ; form the offset
    ; (it's in instructions, not in bytes, so we multiply by four)
    C1 E1 08         ; shl ecx, 8
    09 CA            ; or edx, ecx
    C1 E2 02         ; shl edx, 2     ; multiply by four
    0F BF C2         ; movsx eax, dx

    ; parse predicate (and swap our registers around a bit)
    50                ; push rax
    89 F7             ; mov edi, esi
    B8 30 0A 40 00    ; mov eax, parse_mix (0x400A30)
    FF D0             ; call rax
    5E                ; pop rsi

    ; if zero, add the offset to rip
    83 F8 00          ; cmp eax, 0
    75 0D             ; jnz jz_not_zero (+13)
    BF 3C 00 60 00    ; mov edi, rip (0x60003C)
    67 8B 07          ; mov eax, [edi]
    01 F0             ; add eax, esi
    67 89 07          ; mov [edi], eax

;jz_not_zero:
    C3 ; ret

    90 90 90 90 90 90 90
@0xDC0



; ==========================================================
; void send_sigcont(void)
; ==========================================================
; Sends a SIGCONT to our process group.
;
; If an attempt to set terminal settings in apply_termios() failed, our entire
; process group received a SIGTTOU signal. We've ignored the signal but others
; may not, which means they are now stopped.
;
; For example if we were run in a shell script with job control disabled, the
; SIGTTOU will stop the calling shell. This can interfere with tools like
; timeout when used with a shell script that ultimately calls us. c-testsuite
; is an example: without this function the test runner will freeze. Ninja is
; another example: it hangs on SIGTTOU if one of its jobs tries to set terminal
; state.
;
; (Our process group check in apply_termios() will handle both of these cases
; because when run in the background we'll never try setting the terminal state
; in the first place. This is just to prevent a race condition if the
; foreground process group changes right before we try to set termios.)
;
; We need to send a SIGCONT to our process group to unblock all processes that
; received the SIGTTOU. We will also receive the SIGCONT so we need to ignore
; it in the meantime.
; ==========================================================

@0xDC0 send_sigcont

    ; call install_signal_handler(SIGCONT, SIG_IGN)
    BF 12 00 00 00    ; mov edi, SIGCONT (18)
    BE 01 00 00 00    ; mov esi, SIG_IGN (1)
    B8 90 14 40 00    ; mov eax, install_signal_handler (0x401490)
    FF D0             ; call rax

    ; call syscall getpid
    B8 27 00 00 00    ; mov eax, 0x27  ; syscall: getpid (39)
    0F 05             ; syscall

    ; call syscall getpgid
    48 89 C7          ; mov rdi, rax   ; argument: pid
    B8 79 00 00 00    ; mov eax, 0x79  ; syscall: getpgid (121)
    0F 05             ; syscall

    ; call syscall kill
    48 89 C7          ; mov rdi, rax   ; argument: pgid
    48 F7 DF          ; neg rdi        ; process group argument must be negative
    BE 12 00 00 00    ; mov esi, 18    ; argument: SIGCONT
    B8 3E 00 00 00    ; mov eax, 0x3E  ; syscall: kill (62)
    0F 05             ; syscall

    ; call install_signal_handler(SIGCONT, enable_raw_input)
    BF 12 00 00 00    ; mov edi, SIGCONT (18)
    BE 30 13 40 00    ; mov esi, enable_raw_input (0x401330)
    B8 90 14 40 00    ; mov eax, install_signal_handler (0x401490)
    FF D0             ; call rax

    ; done
    C3 ; ret

    ; padding
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90
@0xE20



; ==========================================================
; void syscall_exit(void)
; ==========================================================
; Halts the VM.
;
; r0 contains the exit code. It must be in the range of 0 to 255.
; ==========================================================

@0xE20 syscall_exit
    ; don't bother with a stack frame

    ; get the exit code from r0
    B8 00 00 60 00    ; mov eax, r0 (0x600000)
    8B 38             ; mov edi, [rax]

    ; TODO check that the exit code is valid

    ; call exit
    B8 D0 05 40 00    ; mov rax, exit (0x4005D0)
    FF D0             ; call rax

    ; padding
    90 90
@0xE30



; ==========================================================
; int parse_io_handle(void)
; ==========================================================
; Returns the file descriptor for a file or directory handle in a syscall.
;
; All syscalls that accept a file or directory handle take it as the first
; argument so we pull the handle out of r0.
;
; If the handle is invalid, the VM aborts.
; ==========================================================

@0xE30 parse_io_handle
    ; no stack frame

    ; get the io handle and check it
    B8 00 00 60 00    ; mov eax, r0 (0x600000)
    ; TODO CHECK BOUNDS
    ;83 F8 40          ; cmp eax, 0
    ;77 09             ; ja parse_io_handle_bad (+9)
90 90 90 90 90
    8B 00             ; mov eax, [rax]
    83 F8 FF          ; cmp eax, -1
    74 02             ; je parse_io_handle_bad (+2)
    EB 0C             ; jmp parse_io_handle_ok (+12)

    ; if the io handle is bad, bail out
;parse_io_handle_bad:
    BF A0 03 50 00   ; mov edi, "ERROR: Invalid I/O handle." (0x5003A0)
    B8 A0 05 40 00   ; mov eax, fatal (0x4005A0)
    FF D0            ; call rax
;parse_io_handle_ok:

    C3           ; ret

    ; padding (nop)
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
@0xE60



; ==========================================================
; void syscall_fwrite(void)
; ==========================================================
; Writes the given buffer to the given file handle.
;
; params:
;    - r0: file handle
;    - r1: buffer
;    - r2: count
; ==========================================================

@0xE60 syscall_fwrite

    ; set up stack frame
    55           ; push rbp
    48 89 E5     ; mov rbp, rsp

    ; get the file descriptor (and check it)
    B8 30 0E 40 00    ; mov eax, parse_io_handle (0x400E30)
    FF D0             ; call rax
    50                ; push rax

    ; get the buffer (and check it)
    B8 04 00 60 00    ; mov eax, r1 (0x600004)
    8B 38             ; mov edi, [rax]
    B8 08 00 60 00    ; mov eax, r2 (0x600008)
    8B 30             ; mov esi, [rax]
    57                ; push rdi
    56                ; push rsi
    B8 00 08 40 00    ; mov eax, check_buffer (0x400800)
    FF D0             ; call rax

    ; call write() syscall
    B8 01 00 00 00   ; mov eax, 0x1  ; syscall: write (1)
    5A               ; pop rdx       ; length
    5E               ; pop rsi       ; buffer
    5F               ; pop rdi       ; file descriptor
    0F 05            ; syscall

    ; if the return value is EAGAIN/EWOULDBLOCK, change it to 0
    3D F5 FF FF FF   ; cmp eax, -11   ; EAGAIN (11), kernel returns negative
    75 05            ; jne syscall_fwrite_ok (+5)
    B8 00 00 00 00   ; mov eax, 0
;syscall_fwrite_ok:

    ; TODO convert return value to Onramp error codes. Linux syscalls return
    ; negative values on error so for now we just pass it through.

    ; store the return value in r0
    BF 00 00 60 00   ; mov edi, r0 (0x600000)
    67 89 07         ; mov [edi], eax

    ; return
    48 89 EC     ; mov rsp, rbp
    5D           ; pop rbp
    C3           ; ret

    ; padding (nop)
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90 90 90 90 90 90 90
    90 90
@0xED0



; ==========================================================
; void syscall_fread(void)
; ==========================================================
; Reads from the given file handle to the given buffer.
;
; We use poll() first to check whether there is data available in order to make
; our read non-blocking. We poll all file descriptors because we don't know
; which ones are streams and which ones are ordinary files.
;
; params:
;    - r0: file handle
;    - r1: buffer
;    - r2: count
; ==========================================================

@0xED0 syscall_fread
    ; set up stack frame
    55           ; push rbp
    48 89 E5     ; mov rbp, rsp

    ; get the file descriptor (and check it)
    B8 30 0E 40 00    ; mov eax, parse_io_handle (0x400E30)
    FF D0             ; call rax

    ; save the file descriptor
    50                ; push rax

    ; prepare args to poll
    ; each struct pollfd is 8 bytes. we want the low 4 bytes to be the fd
    ; (currently in rax) and the next two bytes to be POLLIN (1), so we shift
    ; POLLIN up, mask it into rax and push it.
    BE 01 00 00 00    ; mov esi, 1
    48 C1 E6 20       ; shl rsi, 32 (0x20)
    48 09 F0          ; or rax, rsi
    50                ; push rax        ; this is our single struct pollfd
    48 89 E7          ; mov rdi, rsp    ; struct pollfd* fds == rsp
    BE 01 00 00 00    ; mov esi, 1      ; nfds == 1
    BA 00 00 00 00    ; mov edx, 0      ; timeout == 0

    ; call poll() syscall
    B8 07 00 00 00   ; mov eax, 0x7  ; syscall: poll (7)
    0F 05            ; syscall

    ; If poll() returned 0, it means success and no file descriptors are ready.
    ; In this case only, we skip the read and return ERROR_TRY_LATER to the
    ; program. poll() may return 1 to say data is available or a negative
    ; number on error; either way we try the read.
    48 83 F8 00      ; cmp rax, 0
    75 0E            ; jne syscall_fread_poll_nonzero (+14)

    ; store ERROR_TRY_LATER in r0
    BF 00 00 60 00   ; mov edi, r0 (0x600000)
    ;67 C6 07 FB      ; mov byte [edi], 0xFB   ; move byte sign-extended
    ; TODO: ERROR_TRY_LATER is v4, we'll switch over to it later. In v3 we
    ; return 0 if data is unavailable.
    67 C6 07 00      ; mov byte [edi], 0

    ; return
    48 89 EC     ; mov rsp, rbp
    5D           ; pop rbp
    C3           ; ret

;syscall_fread_poll_nonzero:
    ; poll() returned non-zero. we're doing the read.

    ; get the buffer (and check it)
    B8 04 00 60 00    ; mov eax, r1 (0x600004)
    8B 38             ; mov edi, [rax]
    B8 08 00 60 00    ; mov eax, r2 (0x600008)
    8B 30             ; mov esi, [rax]
    57                ; push rdi
    56                ; push rsi
    B8 00 08 40 00    ; mov eax, check_buffer (0x400800)
    FF D0             ; call rax

    ; call read() syscall
    B8 00 00 00 00   ; mov eax, 0x0  ; syscall: read (0)
    5A               ; pop rdx       ; length
    5E               ; pop rsi       ; buffer
    5F               ; pop rdi       ; file descriptor
    0F 05            ; syscall

    ; TODO convert return value to Onramp error codes. Linux syscalls return
    ; negative values on error so for now we just pass it through.
    ; TODO for v4 if read returns zero we have to return ERROR_END_OF_FILE.
    ; TODO we can just convert any other negative value to ERROR_GENERIC for now.

    ; store the return value in r0
    BF 00 00 60 00   ; mov edi, r0 (0x600000)
    67 89 07         ; mov [edi], eax

    ; return
    48 89 EC     ; mov rsp, rbp
    5D           ; pop rbp
    C3           ; ret

    ; padding (nop)
    90
@0xF40



